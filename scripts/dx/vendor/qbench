def gh_line(i: dict) -> str:
    fields = " / ".join(x for x in (i.get("status"), i.get("evidence")) if x)
    return f"#{i.get('number')} [{fields or 'no fields'}] {i.get('title')}"


def cmd_evidence(ctx: Ctx, args) -> int:
    b = ctx.bench()
    res = b._get("/v1/evidence/gaps")

    def human(d):
        gaps = d.get("gaps") or []
        if not gaps:
            print("no evidence gaps (if that looks wrong: qbench doctor shows whether the board is configured)")
            return
        for g in gaps:
            print(f"{gh_line(g)}: {g.get('reason')}")
            print(f"    {g.get('url')}")
            for c in g.get("cited_by") or []:
                print(f"    cited by {c.get('title')} {c.get('url')}")
    out(args, res, human)
    return EXIT_OK


def cmd_board(ctx: Ctx, args) -> int:
    b = ctx.bench()
    cited = None
    if args.cited:
        cited = "1"
    elif args.uncited:
        cited = "0"
    res = b._get("/v1/github/items", {"repo": args.repo, "status": args.status,
                                      "evidence": args.evidence, "level": args.level,
                                      "state": args.state, "cited": cited})

    def human(d):
        items = d.get("items") or []
        if not items:
            print("no board items match")
        for i in items:
            n = len(i.get("cited_by") or [])
            print(f"{gh_line(i)} ({i.get('state')}, cited by {n})")
    out(args, res, human)
    return EXIT_OK


def cmd_version(ctx: Ctx, args) -> int:
    out(args, {"version": __version__}, lambda d: print(d["version"]))
    return EXIT_OK


# ------------------------------------------------------------------ parser

def build_parser() -> argparse.ArgumentParser:
    p = argparse.ArgumentParser(prog="qbench", description=__doc__,
                                formatter_class=argparse.RawDescriptionHelpFormatter)
    p.add_argument("--url", default=None, help="base URL (default $BENCH_URL, then ~/.config/qbench/url)")
    p.add_argument("--key", default=None, help="API key (prefer $BENCH_KEY or ~/.config/qbench/key)")
    p.add_argument("--version", action="version", version=f"qbench {__version__}")
    top = p.add_subparsers(dest="group", required=True, metavar="COMMAND")

    js = argparse.ArgumentParser(add_help=False)
    js.add_argument("--json", action="store_true", help="print JSON (see the C15 spec for shapes)")

    def add(sub, name, help_, **kw):
        return sub.add_parser(name, help=help_, parents=[js], **kw)

    # setup
    add(top, "doctor", "check URL, server health, key, permissions and CLI version")
    add(top, "version", "print the CLI version")

    # regressions
    ck = add(top, "check", "did head regress vs. the previous benched commit? exit 0/3/4")
    ck.add_argument("--head", default="", help="commit (default git HEAD)")
    ck.add_argument("--base", default="", help="commit (default nearest ancestor with runs)")
    ck.add_argument("--repo", default="", metavar="OWNER/NAME", help="default $BENCH_REPO, else the server's")
    ck.add_argument("--window", default="", help="phase to judge, e.g. impaired")
    ck.add_argument("--stat", default="", choices=["", "mean", "p50", "p95"])
    ck.add_argument("--keys", default="", metavar="K1,K2")

    runs = top.add_parser("runs", help="list and inspect runs")
    rsub = runs.add_subparsers(dest="cmd", required=True)
    rl = add(rsub, "list", "list runs, newest first")
    for f in ("suite", "scenario", "repo", "commit", "since"):
        rl.add_argument(f"--{f}", default="")
    rl.add_argument("--validity", default="", choices=["", "valid", "contaminated", "withdrawn"])
    rl.add_argument("--tag", action="append", default=[], metavar="K=V")
    rl.add_argument("--latest", action="store_true", help="newest valid run per suite/scenario")
    rl.add_argument("--limit", default="20")
    add(rsub, "show", "one run: tags, phases, mismatches, artifacts").add_argument("run")
    add(rsub, "summary", "one run judged against its pinned baseline").add_argument("run")

    cp = add(top, "compare", "judge 2-4 specific runs against each other")
    cp.add_argument("runs", nargs="+", metavar="RUN")
    cp.add_argument("--keys", default="", metavar="K1,K2")
    cp.add_argument("--window", default="")
    cp.add_argument("--align", default="")
    cp.add_argument("--stat", default="", choices=["", "mean", "p50", "p95"])

    commits = top.add_parser("commits", help="commit list and commit-to-commit compare")
    csub = commits.add_subparsers(dest="cmd", required=True)
    cl = add(csub, "list", "commits that have runs, newest first")
    cl.add_argument("--repo", default="", metavar="OWNER/NAME")
    cl.add_argument("--limit", default="50")
    cc = add(csub, "compare", "judge every scenario that ran at both commits")
    cc.add_argument("base")
    cc.add_argument("head")
    cc.add_argument("--repo", default="", metavar="OWNER/NAME", help="default BENCH_DEFAULT_REPO")
    cc.add_argument("--window", default="")
    cc.add_argument("--stat", default="")
    cc.add_argument("--keys", default="", metavar="K1,K2")

    rg = add(top, "regressions", "every run of a scenario vs. its pinned baseline, one metric")
    rg.add_argument("--suite", required=True)
    rg.add_argument("--scenario", required=True)
    rg.add_argument("--metric", required=True)
    rg.add_argument("--agg", default="p50")
    rg.add_argument("--window", default="")
    rg.add_argument("--baseline", default="")
    rg.add_argument("--pct", type=float, default=None)

    bl = top.add_parser("baseline", help="pin or read a scenario's last-known-good run")
    bsub = bl.add_subparsers(dest="cmd", required=True)
    bp = add(bsub, "pin", "pin RUN as the baseline for suite/scenario")
    bp.add_argument("run")
    bs = add(bsub, "show", "print the pinned baseline run id")
    for sp in (bp, bs):
        sp.add_argument("--suite", required=True)
        sp.add_argument("--scenario", required=True)
        sp.add_argument("--name", default="default")
    bp.add_argument("--threshold", action="append", default=[], metavar="METRIC=PCT")

    # harness
    run = top.add_parser("run", help="post a harness run: new, samples, event, mark, capture, finish, validity")
    hsub = run.add_subparsers(dest="cmd", required=True)
    rn = add(hsub, "new", "create a run; prints its id")
    rn.add_argument("--suite", required=True)
    rn.add_argument("--scenario", required=True)
    rn.add_argument("--repo", default="", metavar="OWNER/NAME")
    rn.add_argument("--commit", default="", help="sha the run measured (a git ref resolves locally)")
    rn.add_argument("--host", default="")
    rn.add_argument("--notes", default="")
    rn.add_argument("--tag", action="append", default=[], metavar="K=V", help="intended configuration")
    rn.add_argument("--conditions", default=None, metavar="FILE", help="JSON: what the host actually did")
    rn.add_argument("--external-id", default=None, help="idempotency key: re-posting updates the run")
    rs = add(hsub, "samples", "post samples from JSON/JSONL (- for stdin)")
    rs.add_argument("run")
    rs.add_argument("--file", required=True)
    rs.add_argument("--replace", action="store_true", help="clear each source in the file first (re-folds)")
    rs.add_argument("--expect", action="append", default=[], metavar="SOURCE=N",
                    help="reject the write unless SOURCE ends up with N samples")
    re_ = add(hsub, "event", "post one event (--type) or a file of them (--file)")
    re_.add_argument("run")
    re_.add_argument("--type", default="", help="e.g. netem.impair, netem.clear, abr.ladder.step")
    re_.add_argument("--payload", default="", help="JSON object")
    re_.add_argument("--ts-ms", type=int, default=None, help="wall-clock ms (default now)")
    re_.add_argument("--file", default="")
    rm = add(hsub, "mark", "explicit phase boundary (harness.mark)")
    rm.add_argument("run")
    rm.add_argument("phase")
    rm.add_argument("edge", choices=["start", "end"])
    rm.add_argument("--ts-ms", type=int, default=None)
    rc = add(hsub, "capture", "upload a screen capture, screenshot, log or bundle")
    rc.add_argument("run")
    rc.add_argument("file")
    rc.add_argument("--role", default="", choices=ROLES)
    rc.add_argument("--caption", default="")
    rc.add_argument("--name", default=None)
    rc.add_argument("--started-at-ms", type=int, default=None, help="wall-clock ms of the first frame")
    rf = add(hsub, "finish", "close the run out")
    rf.add_argument("run")
    rf.add_argument("--status", default="finished", choices=["finished", "failed", "aborted", "running"])
    rf.add_argument("--verdict", default=None, choices=["PASS", "FAIL", "INFO"])
    rf.add_argument("--summary", default=None, metavar="FILE")
    rf.add_argument("--conditions", default=None, metavar="FILE")
    rf.add_argument("--tag", action="append", default=[], metavar="K=V")
    rv = add(hsub, "validity", "mark a run valid, contaminated or withdrawn")
    rv.add_argument("run")
    rv.add_argument("validity", choices=["valid", "contaminated", "withdrawn"])
    rv.add_argument("--reason", default="")

    # reports & sprints
    for group in ("report", "sprint"):
        is_sprint = group == "sprint"
        g = top.add_parser(group, help=("sprint reports and their review" if is_sprint
                                        else "commit reports and their review"))
        sub = g.add_subparsers(dest="cmd", required=True)

        def ident(sp, publish=False):
            sp.add_argument("--repo", required=True, metavar="OWNER/NAME")
            if is_sprint:
                sp.add_argument("--sprint", required=True, metavar="SLUG", help="e.g. c12, 2026-w38")
            else:
                sp.add_argument("--commit", required=True,
                                help="full sha to publish" if publish else "sha or unique prefix")

        put = add(sub, "put", "create or replace; prints the page URL")
        ident(put, publish=True)
        put.add_argument("--title", required=True)
        put.add_argument("--branch", default="")
        put.add_argument("--summary", default="", help="one plain-text paragraph for lists")
        put.add_argument("--body", default=None, metavar="FILE", help="narrative; .html/.md/.txt sets the mime")
        put.add_argument("--body-mime", default=None, choices=["text/html", "text/markdown", "text/plain"])
        put.add_argument("--issue", action="append", type=int, default=[], metavar="N")
        put.add_argument("--pr", action="append", type=int, default=[], metavar="N")
        put.add_argument("--run", action="append", default=[], metavar="RUN_ID",
                         help="link a run; exactly two gives a before/after table")
        put.add_argument("--tag", action="append", default=[], metavar="K=V")
        put.add_argument("--pin", action="store_true", help="exempt attachments from pruning")
        if is_sprint:
            put.add_argument("--sprint-label", default="", help="display form, e.g. C12")
            put.add_argument("--sections", default=None, metavar="FILE",
                             help="JSON: the sections object, or a full PUT body (client/examples/sprint.json)")
            put.add_argument("--commit", default="", help="head/merge sha, optional")
            put.add_argument("--started-at", default=None)
            put.add_argument("--ended-at", default=None)
            put.add_argument("--author", default="", help="default the key's name")

        gt = add(sub, "get", "the report: sections, evidence, deltas, comments")
        ident(gt)
        gt.add_argument("--agg", default="", help="statistic for the delta table (default p50)")

        st = add(sub, "status", "review status and unresolved comments (poll this after submitting)")
        ident(st)

        ls = add(sub, "list", "list, newest first")
        ls.add_argument("--repo", default="")
        ls.add_argument("--review-status", default="", choices=[""] + REVIEW_STATUSES)
        ls.add_argument("--since", default="", metavar="30d")
        ls.add_argument("--limit", default="50")
        if not is_sprint:
            ls.add_argument("--branch", default="")
            ls.add_argument("--issue", default="")
            ls.add_argument("--tag", default="", metavar="K=V")

        at = add(sub, "attach", "attach evidence (screenshot, video, log, bundle)")
        ident(at)
        at.add_argument("--file", required=True)
        at.add_argument("--role", default="", choices=ROLES, help="inferred from the file when omitted")
        at.add_argument("--caption", default="")
        at.add_argument("--name", default=None)

        pn = add(sub, "pin", "exempt attachments from pruning for good")
        ident(pn)
        pn.add_argument("--off", action="store_true", help="unpin instead")

        ident(add(sub, "url", "print the stable page URL (no request)"))

        rv = add(sub, "review", "set the review verdict (reviewers only; never approve your own)")
        ident(rv)
        rv.add_argument("status", choices=REVIEW_STATUSES)
        rv.add_argument("--note", default="")

        cm = add(sub, "comments", "list comments, or add one")
        ident(cm)
        cm.add_argument("--unresolved", action="store_true", help="only open comments")
        cm.add_argument("--add", default=None, metavar="TEXT", help="add a comment instead of listing")
        cm.add_argument("--anchor", default="", help='e.g. "goals.2"; "" is the whole report')
        cm.add_argument("--resolve", type=int, default=None, metavar="ID")
        cm.add_argument("--reopen", type=int, default=None, metavar="ID")

        rs_ = add(sub, "resolve", "mark comments resolved after addressing them")
        ident(rs_)
        rs_.add_argument("ids", nargs="+", type=int, metavar="ID")
        rs_.add_argument("--reopen", action="store_true")

        sn = add(sub, "snippet", "markdown block for a GitHub issue/PR comment")
        ident(sn)
        sn.add_argument("--agg", default="")

    # roadmap
    ev = top.add_parser("evidence", help="roadmap items that still need bench evidence")
    esub = ev.add_subparsers(dest="cmd", required=True)
    add(esub, "gaps", "open board items not yet cited by an approved report")

    bd = top.add_parser("board", help="the synced GitHub project board")
    bdsub = bd.add_subparsers(dest="cmd", required=True)
    bi = add(bdsub, "items", "board items with the reports citing them")
    for f in ("repo", "status", "evidence", "level", "state"):
        bi.add_argument(f"--{f}", default="")
    grp = bi.add_mutually_exclusive_group()
    grp.add_argument("--cited", action="store_true")
    grp.add_argument("--uncited", action="store_true")

    mt = top.add_parser("metrics", help="the metric direction registry")
    msub = mt.add_subparsers(dest="cmd", required=True)
    add(msub, "list", "registered metrics and their direction")
    mr = add(msub, "register", "declare a metric's direction so deltas judge it")
    mr.add_argument("key_name", metavar="KEY")
    mr.add_argument("better", choices=["higher", "lower", "neutral"])
    mr.add_argument("--unit", default="")
    mr.add_argument("--regression-pct", type=float, default=0)

    return p


HANDLERS: dict[str, Callable[[Ctx, Any], int]] = {
    "doctor": cmd_doctor, "version": cmd_version, "check": cmd_check, "runs": cmd_runs,
    "compare": cmd_compare, "commits": cmd_commits, "regressions": cmd_regressions,
    "baseline": cmd_baseline, "run": cmd_run, "report": cmd_reports, "sprint": cmd_reports,
    "evidence": cmd_evidence, "board": cmd_board, "metrics": cmd_metrics,
}


def main(argv: list[str] | None = None) -> int:
    args = build_parser().parse_args(argv)
    ctx = Ctx(args)
    as_json = getattr(args, "json", False)
    try:
        return HANDLERS[args.group](ctx, args)
    except CredentialError as e:
        if as_json:
            print(json.dumps({"error": {"status": 0, "message": str(e), "method": "", "path": ""}}))
        else:
            print(f"error: {e}", file=sys.stderr)
        return EXIT_AUTH
    except BenchError as e:
        if as_json:
            print(json.dumps({"error": {"status": getattr(e, "status", 0),
                                        "message": getattr(e, "server_message", "") or str(e),
                                        "method": getattr(e, "method", ""),
                                        "path": getattr(e, "path", "")}}))
        else:
            print(f"error: {e}", file=sys.stderr)
            if getattr(e, "status", 0) == 403:
                print("hint: a read-only key cannot write; qbench doctor shows the key's permissions",
                      file=sys.stderr)
        return EXIT_AUTH if getattr(e, "status", 0) == 401 else EXIT_ERROR


def run() -> None:
    """Entry point for the script and the zipapp."""
    try:
        sys.exit(main())
    except KeyboardInterrupt:
        sys.exit(130)


if __name__ == "__main__":
    run()
