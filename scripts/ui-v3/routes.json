    { "id": "admin-library-images", "file": "admin-console-v3.html", "hash": "#/library/images" },
    { "id": "admin-library-image-detail", "file": "admin-console-v3.html", "hash": "#/library/images/steam" },
    { "id": "admin-library-sources", "file": "admin-console-v3.html", "hash": "#/library/sources" },

    { "id": "admin-app-editor-identity", "file": "admin-console-v3.html", "hash": "#/library/apps/app-cp2077" },
    { "id": "admin-app-editor-artwork", "file": "admin-console-v3.html", "hash": "#/library/apps/app-cp2077/artwork" },
    { "id": "admin-app-editor-access", "file": "admin-console-v3.html", "hash": "#/library/apps/app-cp2077/access" },
