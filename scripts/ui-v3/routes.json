    {"id": "hud-pane-games", "file": "session-overlay-v3.html", "actions": [{"wait": 600}, {"eval": "(() => { openShelf('games'); })()"}, {"wait": 700}]},
    {"id": "hud-pane-input", "file": "session-overlay-v3.html", "actions": [{"wait": 600}, {"eval": "(() => { openShelf('input'); })()"}, {"wait": 700}]},
    {"id": "hud-pane-stats", "file": "session-overlay-v3.html", "actions": [{"wait": 600}, {"eval": "(() => { openShelf('stats'); })()"}, {"wait": 700}]},
    {"id": "hud-pane-stats-detailed", "file": "session-overlay-v3.html", "actions": [{"wait": 600}, {"eval": "(() => { openShelf('stats'); })()"}, {"wait": 500}, {"clickText": "Detailed"}, {"wait": 700}]},
    {"id": "hud-dock-top-rest", "file": "session-overlay-v3.html", "actions": [{"wait": 600}, {"eval": "(() => { prefs.position = 'top'; applyPrefs(); })()"}, {"wait": 700}]},
