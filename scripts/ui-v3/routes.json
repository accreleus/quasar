    {"id": "loader-1-connection", "file": "loading-v3.html", "actions": [{"wait": 400}, {"eval": "(() => { for (let i = 1; i < 5000; i++) { clearInterval(i); clearTimeout(i); } stageIndex = 0; stage.textContent = stages[0]; stage.classList.remove('changing'); paintSteps(); })()"}, {"wait": 400}]},
    {"id": "loader-2-secure-path", "file": "loading-v3.html", "actions": [{"wait": 400}, {"eval": "(() => { for (let i = 1; i < 5000; i++) { clearInterval(i); clearTimeout(i); } stageIndex = 1; stage.textContent = stages[1]; stage.classList.remove('changing'); paintSteps(); })()"}, {"wait": 400}]},
    {"id": "loader-3-video-channel", "file": "loading-v3.html", "actions": [{"wait": 400}, {"eval": "(() => { for (let i = 1; i < 5000; i++) { clearInterval(i); clearTimeout(i); } stageIndex = 2; stage.textContent = stages[2]; stage.classList.remove('changing'); paintSteps(); })()"}, {"wait": 400}]},
    {"id": "loader-4-locking-aperture", "file": "loading-to-stream-v3.html", "actions": [{"wait": 400}, {"eval": "(() => { for (let i = 1; i < 5000; i++) { clearInterval(i); clearTimeout(i); } completeConnection(); })()"}, {"wait": 500}, {"eval": "(() => { for (let i = 1; i < 5000; i++) clearTimeout(i); })()"}, {"wait": 200}]},
    {"id": "loader-5-after-handoff", "file": "loading-to-stream-v3.html", "actions": [{"wait": 400}, {"eval": "completeConnection()"}, {"wait": 1800}]},
