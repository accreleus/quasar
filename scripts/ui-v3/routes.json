{
  "$comment": "Route table for scripts/ui-v3/capture.sh (UI v3 visual pass, plan task 32). `app` routes are captured against a running SPA; `mock` routes render design_handoff_v3/screens over file://. Placeholders {hostId} {appId} {sessionId} are resolved at runtime from the control-plane API; a route whose placeholder cannot be resolved is skipped and listed in the manifest. Actions run after load: {click|clickText|waitFor|wait|eval}. `storage` seeds localStorage before the navigation (theme/density/rail live there). The `loader-*` / `hud-*` mock routes pin the loading and session-overlay mocks into one deterministic state each (they animate on a timer), for comparison against the `--mode session` captures.",
  "app": [
    { "id": "login", "path": "/login", "auth": false },
    { "id": "register", "path": "/register", "auth": false },
    { "id": "styleguide", "path": "/styleguide", "auth": false },

    { "id": "app-home", "path": "/app" },
    { "id": "app-home-detail", "path": "/app", "actions": [{ "click": ".home-feat-surface, .lib-tile-surface" }, { "waitFor": ".d-inner" }, { "wait": 700 }] },
    { "id": "app-home-launch-options", "path": "/app", "actions": [{ "click": ".home-feat-surface, .lib-tile-surface" }, { "waitFor": ".d-inner" }, { "wait": 500 }, { "clickText": "Adjust" }, { "wait": 800 }] },
    { "id": "app-library", "path": "/app/library" },
    { "id": "app-library-detail", "path": "/app/library", "actions": [{ "click": ".lib-tile-surface" }, { "waitFor": ".d-inner" }, { "wait": 700 }] },

    { "id": "account-profile", "path": "/app/account/profile" },
    { "id": "account-devices", "path": "/app/account/devices" },
    { "id": "account-overlay", "path": "/app/account/overlay" },
    { "id": "account-streaming", "path": "/app/account/streaming" },
    { "id": "account-storage", "path": "/app/account/storage" },
    { "id": "account-sessions", "path": "/app/account/sessions" },

    { "id": "admin-overview", "path": "/admin" },
    { "id": "admin-overview-light", "path": "/admin", "storage": { "quasar-theme": "light" } },
    { "id": "admin-overview-dense", "path": "/admin", "storage": { "quasar-density": "dense" } },
    { "id": "admin-overview-rail-collapsed", "path": "/admin", "storage": { "quasar-rail": "collapsed" } },
    { "id": "admin-palette", "path": "/admin", "actions": [{ "wait": 400 }, { "clickText": "Search hosts" }, { "wait": 600 }] },

    { "id": "admin-sessions", "path": "/admin/sessions" },
    { "id": "admin-session-detail", "path": "/admin/sessions/{sessionId}", "wait": 1500 },

    { "id": "admin-fleet-hosts", "path": "/admin/fleet/hosts" },
    { "id": "admin-fleet-host-detail", "path": "/admin/fleet/hosts/{hostId}" },
    { "id": "admin-fleet-host-console", "path": "/admin/fleet/hosts/{hostId}/console", "wait": 1500 },
    { "id": "admin-fleet-host-settings", "path": "/admin/fleet/hosts/{hostId}/settings", "wait": 1500 },
    { "id": "admin-fleet-storage", "path": "/admin/fleet/storage" },
    { "id": "admin-fleet-jobs", "path": "/admin/fleet/jobs" },
    { "id": "admin-fleet-jobs-expanded", "path": "/admin/fleet/jobs", "actions": [{ "wait": 600 }, { "click": ".jobs-page .exp-btn[aria-label^=\"Show per-host breakdown\"]" }, { "wait": 600 }] },
    { "id": "admin-fleet-jobs-history", "path": "/admin/fleet/jobs", "actions": [{ "wait": 600 }, { "click": ".jobs-page .row-menu-btn[aria-label=\"Actions for Auth token janitor\"]" }, { "wait": 300 }, { "clickText": "View history" }, { "waitFor": ".drawer.open" }, { "wait": 900 }] },
    { "id": "admin-fleet-jobs-schedule", "path": "/admin/fleet/jobs", "actions": [{ "wait": 600 }, { "click": ".jobs-page .row-menu-btn[aria-label=\"Actions for Artwork grabber\"]" }, { "wait": 300 }, { "clickText": "Edit schedule" }, { "waitFor": ".modal" }, { "wait": 600 }] },
    { "id": "admin-fleet-jobs-failing", "path": "/admin/fleet/jobs", "actions": [{ "wait": 600 }, { "clickText": "Failing" }, { "wait": 500 }] },
    { "id": "admin-fleet-jobs-disabled", "path": "/admin/fleet/jobs", "note": "captured with one job disabled through the API, then re-enabled" },

    { "id": "admin-library-apps", "path": "/admin/library/apps" },
    { "id": "admin-library-presets", "path": "/admin/library/presets" },
    { "id": "admin-library-images", "path": "/admin/library/images" },
    { "id": "admin-library-image-detail", "path": "/admin/library/images/{imageId}" },
    { "id": "admin-library-sources", "path": "/admin/library/sources" },

    { "id": "admin-app-editor-identity", "path": "/admin/library/apps/{appId}" },
    { "id": "admin-app-editor-artwork", "path": "/admin/library/apps/{appId}/artwork" },
    { "id": "admin-app-editor-access", "path": "/admin/library/apps/{appId}/access" },
    { "id": "admin-app-editor-quality", "path": "/admin/library/apps/{appId}/quality" },
    { "id": "admin-app-editor-runtime", "path": "/admin/library/apps/{appId}/runtime" },
    { "id": "admin-app-editor-library", "path": "/admin/library/apps/{appId}/library" },

    { "id": "admin-streaming-launch", "path": "/admin/streaming/launch" },
    { "id": "admin-streaming-profiles", "path": "/admin/streaming/profiles" },

    { "id": "admin-people-users", "path": "/admin/people/users" },
    { "id": "admin-people-invites", "path": "/admin/people/invites" },

    { "id": "admin-audit", "path": "/admin/audit" },
    { "id": "admin-audit-expanded", "path": "/admin/audit", "actions": [{ "wait": 600 }, { "clickText": "Expand all" }, { "wait": 600 }] },

    { "id": "admin-settings", "path": "/admin/settings" },

    { "id": "notfound", "path": "/no-such-route" }
  ],
  "mock": [
    { "id": "login", "file": "login-v3.html" },
    { "id": "app-home", "file": "home.html" },
    { "id": "app-home-detail", "file": "home.html", "actions": [{ "eval": "openDetail('injustice2',true)" }, { "wait": 1200 }] },
    { "id": "app-home-launch-options", "file": "home.html", "actions": [{ "eval": "openDetail('injustice2',true)" }, { "wait": 700 }, { "clickText": "Adjust" }, { "wait": 900 }] },
    { "id": "app-library", "file": "home.html", "actions": [{ "clickText": "Library" }, { "wait": 900 }] },

    { "id": "admin-overview", "file": "admin-console-v3.html", "hash": "#/overview" },
