          }
        },
        {
          "agent_report": {
            "legacy_effective_settings": {
              "encoder": "va"
            }
          }
        }
      ],
      "expect": [
        {
          "setting_status": {
            "encoder": "upgrade_required"
          }
        },
        {
          "configuration_applied": false
        }
      ]
    },
    {
      "id": "offline_reconnect_duplicate_and_old_report",
      "seam": "operator",
