          }
        }
      ]
    },
    {
      "id": "config_applies_independently_of_image_failure",
      "seam": "operator",
      "given": [
        {
          "host": "h1",
          "agent": "rh05",
          "policy_revision": "3",
          "selected_app_image": "app-image"
        }
      ],
      "when": [
        {
          "save": {
            "expected_revision": "3",
            "changes": {
              "gop": {
                "source": "explicit",
                "value": 90
              }
            }
          }
        },
        {
          "report_verified_next_session": {
            "revision": "4",
            "gop": 90
          }
        },
        {
          "image_preparation_failed": {
            "image": "app-image",
            "reason": "pull_failed"
          }
        }
      ],
      "expect": [
        {
          "setting_status": {
            "gop": "applied"
          }
        },
        {
          "setting_applied_value": {
            "gop": 90
          }
        },
        {
          "preparation_status": {
            "app-image": "failed"
          }
        }
      ]
    },
