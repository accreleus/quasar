{
  "format": 1,
  "adapter_interface": "A test adapter provides reset(given), act(step), and observe(assertion) at the named seam. observe returns true only when the assertion holds.",
  "scenarios": [
    {
      "id": "legacy_clear_preserves_agent_detection",
      "seam": "operator",
      "given": [
        {
          "host": "h1",
          "agent": "rh05",
          "encoder_env": null,
          "detected_encoder": "$agent_detected_encoder",
          "choice": {
            "encoder": {
              "source": "explicit",
              "value": "va"
            }
          }
        }
      ],
      "when": [
        {
          "legacy_patch": {
            "overrides": {
              "encoder": null
            }
          }
        },
        {
          "approve_idle_apply": "encoder"
        },
        {
          "report_verified_post_restart": "$agent_detected_encoder"
        }
      ],
      "expect": [
        {
          "setting_source": {
            "encoder": "deployment"
          }
        },
        {
          "setting_applied_value": {
            "encoder": "$agent_detected_encoder"
          }
        }
      ]
    },
    {
      "id": "concurrent_edit_rejects_stale_snapshot",
      "seam": "operator",
      "given": [
        {
          "host": "h1",
          "policy_revision": "7"
        }
      ],
      "when": [
        {
          "save": {
            "expected_revision": "7",
            "changes": {
              "gop": {
                "source": "explicit",
                "value": 90
              }
            }
          }
        },
        {
          "save": {
            "expected_revision": "7",
            "changes": {
              "slices": {
                "source": "explicit",
                "value": 4
              }
            }
          }
        }
      ],
      "expect": [
        {
          "last_result": {
            "code": "stale_revision",
            "current_revision": "8",
            "changed_keys": [
              "gop"
            ]
          }
        },
        {
          "setting_source": {
            "slices": "deployment"
          }
        }
      ]
    },
    {
      "id": "old_agent_does_not_claim_application",
      "seam": "operator",
