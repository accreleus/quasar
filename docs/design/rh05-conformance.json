          "save": {
            "expected_revision": "10",
            "changes": {
              "gop": {
                "source": "explicit",
                "value": 90
              }
            }
          }
        },
        {
          "save": {
            "expected_revision": "11",
            "changes": {
              "gop": {
                "source": "explicit",
                "value": 120
              }
            }
          }
        },
        {
          "reconnect": "h1"
        },
        {
          "deliver_revision": "12"
        },
        {
          "deliver_revision": "12"
        },
