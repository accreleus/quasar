{
  "kind": "evidence",
  "about": "signature_source.go ReleaseAssetSource.Evidence: how HTTP outcomes map onto signed / absent / fetch_error. Only a 404 on the signature asset is an absence; anything that could not be completed is a fetch_error, never an absence.",
  "vectors": [
    {
      "name": "both assets present",
      "source": "go:control-plane/internal/updater/signature_source_test.go:TestEvidenceFetchesBothAssets",
      "version": "0.3.0",
      "fetch": {
        "base_url": "https://releases.example.invalid/quasar/v{version}/",
        "responses": {
          "https://releases.example.invalid/quasar/v0.3.0/platform-release-manifest.json": {
            "status": 200,
            "body": {
              "text": "{\"version\":\"0.3.0\"}"
            }
          },
          "https://releases.example.invalid/quasar/v0.3.0/platform-release-manifest.json.sig": {
            "status": 200,
            "body": {
              "text": "{\"format_version\":1,\"signatures\":[]}"
            }
          }
        }
      },
      "expect": {
        "evidence": {
          "state": "signed",
          "manifest": {
            "text": "{\"version\":\"0.3.0\"}"
          },
          "signature": {
            "text": "{\"format_version\":1,\"signatures\":[]}"
          }
        },
        "fetched": [
          "https://releases.example.invalid/quasar/v0.3.0/platform-release-manifest.json.sig",
          "https://releases.example.invalid/quasar/v0.3.0/platform-release-manifest.json"
        ]
      }
    },
    {
      "name": "no signature asset is a definitive absence",
      "source": "go:control-plane/internal/updater/signature_source_test.go:TestEvidenceNoSignatureAssetIsDefinitiveAbsence",
      "version": "0.3.0",
      "fetch": {
        "base_url": "https://releases.example.invalid/quasar/v{version}/",
        "responses": {
          "https://releases.example.invalid/quasar/v0.3.0/platform-release-manifest.json": {
            "status": 200,
            "body": {
              "text": "{\"version\":\"0.3.0\"}"
            }
          }
        }
      },
      "expect": {
        "evidence": {
          "state": "absent",
          "why": "release 0.3.0 publishes no platform-release-manifest.json.sig asset"
        },
        "fetched": [
          "https://releases.example.invalid/quasar/v0.3.0/platform-release-manifest.json.sig"
        ]
      }
    },
    {
      "name": "a 503 is not an absence",
