#!/usr/bin/env bash
# validate — quasar-host self-test.
#
#   validate                    # offline checks (no host is contacted)
#   validate --live ROLE|HOST   # additionally prove `qhost --host X info` reaches it
#
# Offline checks run entirely against _shared/fixtures/hosts.three-role.json —
# the ONE synthetic fleet every skill's validate uses — so they pass on any
# workstation and never touch real gear.
set -euo pipefail

SKILL_DIR="$(cd "$(dirname "$0")/.." && pwd)"
QHOST="$SKILL_DIR/scripts/qhost"
FIXTURE="$SKILL_DIR/../_shared/fixtures/hosts.three-role.json"

LIVE_TARGET=""
[ "${1:-}" = "--live" ] && LIVE_TARGET="${2:?--live needs a role or host name}"

PASSN=0; FAILN=0
pass() { echo "  PASS  $*"; PASSN=$((PASSN+1)); }
fail() { echo "  FAIL  $*" >&2; FAILN=$((FAILN+1)); }

echo "quasar-host self-test"

# 1. syntax + executability
[ -x "$QHOST" ] && pass "qhost is executable" || fail "qhost is not executable"
bash -n "$QHOST" && pass "qhost is bash-syntax clean" || fail "qhost has syntax errors"
bash -n "$0"     && pass "validate is bash-syntax clean" || fail "validate has syntax errors"

# 2. the fixture fleet parses under the shared schema rules
python3 - "$FIXTURE" <<'PY' && pass "fixture fleet is schema-valid" || fail "fixture fleet invalid"
import json, sys
c = json.load(open(sys.argv[1]))
assert c["_schema"].startswith("quasar-skills/hosts@2")
for role, host in c["roles"].items():
    assert host in c["hosts"], role
for name, h in c["hosts"].items():
    assert "dir" in h and h.get("gpu") in ("nvidia", "amd", "intel", "none"), name
PY

export QUASAR_HOSTS_JSON="$FIXTURE"

# 3. role resolution + default role
out="$("$QHOST" hosts)"
case "$out" in *"gpu-test     -> fixture-gpu"*) pass "roles map listed" ;; *) fail "roles not listed: $out" ;; esac
case "$out" in *"default role: gpu-test -> fixture-gpu"*) pass "default host = gpu-test role" ;; *) fail "wrong default host" ;; esac

# 4. --host accepts both a role name and a literal host name, and rejects junk
a="$("$QHOST" --host aux-infra info)";   a="${a%%$'\n'*}"
b="$("$QHOST" --host fixture-aux info)"; b="${b%%$'\n'*}"
[ "$a" = "$b" ] && [ "$a" = "host          fixture-aux" ] \
  && pass "--host accepts role and host name alike" || fail "--host resolution mismatch ($a / $b)"
if "$QHOST" --host not-a-host info >/dev/null 2>&1; then
  fail "unknown --host was accepted"
else
  pass "unknown --host rejected with exit 2"
fi

# 5. compose-file selection comes from hosts.json, not from the script
c="$("$QHOST" info | grep '^compose')"
case "$c" in *"deploy/docker-compose.fixture.yml"*) pass "compose files read from host config" ;;
             *) fail "compose files not host-driven: $c" ;; esac

# 6. deploy-only safety: mutating verbs need an explicit --host; destructive refused
if "$QHOST" --host deploy-only down >/dev/null 2>&1; then
  fail "destructive verb allowed on a deploy-only host"
else
  pass "destructive verb refused on a deploy-only host"
fi
msg="$(QUASAR_DEFAULT_ROLE=deploy-only "$QHOST" up 2>&1 || true)"
case "$msg" in *"pass --host"*) pass "mutating verb on a deploy-only host demands an explicit --host" ;;
                *) fail "deploy-only implicit guard missing: $msg" ;; esac

# 6b. every verb that force-resets the host checkout is refused there too.
# sync_branch runs `git checkout -B` on the host, discarding whatever was
# committed on it — the gap that let `gofmt`/`web-check`/`sync-branch` through
# while `up`/`down` were guarded. An explicit --host must NOT buy its way past
# this one, so the assertion is made with --host given.
for v in sync-branch gofmt web-check test; do
  out="$("$QHOST" --host deploy-only "$v" go-check 2>&1 || true)"
  case "$out" in
    *"no destructive operations"*) pass "'$v' refused on a deploy-only host (host-checkout reset)" ;;
    *) fail "'$v' not refused on a deploy-only host: $out" ;;
  esac
done

# 7. read-only verbs stay available on a deploy-only host
"$QHOST" --host deploy-only info >/dev/null 2>&1 \
  && pass "read-only verbs allowed on a deploy-only host" \
  || fail "read-only verb blocked on a deploy-only host"

# 8. notes surface operator knowledge rather than the skill embedding it
n="$("$QHOST" --host gpu-test notes)"
case "$n" in *"fixture host"*) pass "host notes surfaced from hosts.json" ;; *) fail "notes not surfaced" ;; esac

# 9. no real host name, address, or key path is hardcoded in the script.
# Patterns rather than one operator's gear: any RFC1918 address literal, and any
# ssh key path named after a specific box or account. A generic remote-side
# ~/.ssh/config or ~/.ssh/github reference is fine — it identifies nobody.
if grep -Eqi '(^|[^0-9.])(10|192\.168)\.[0-9]{1,3}\.[0-9]{1,3}|172\.(1[6-9]|2[0-9]|3[01])\.[0-9]{1,3}\.[0-9]{1,3}|[~$][A-Za-z{}/_]*/\.ssh/[A-Za-z0-9._-]*(unraid|tower|hermes|devbox|root)' "$QHOST"; then
  fail "qhost hardcodes operator-specific host facts"
else
  pass "qhost is host-agnostic (no operator gear in the script)"
fi

unset QUASAR_HOSTS_JSON

if [ -n "$LIVE_TARGET" ]; then
  "$QHOST" --host "$LIVE_TARGET" sh 'echo reachable' | grep -q reachable \
    && pass "live: $LIVE_TARGET reachable" || fail "live: $LIVE_TARGET unreachable"
fi

echo ""
echo "quasar-host: $PASSN passed, $FAILN failed"
[ "$FAILN" -eq 0 ]
