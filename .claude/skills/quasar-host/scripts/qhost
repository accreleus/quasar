#!/usr/bin/env bash
# qhost — one entry point for every remote-host operation in Quasar: build/test,
# stack lifecycle, deployment, shell access, and GPU checks. Host-agnostic: it
# resolves a ROLE (or an explicit host name) through _shared/hosts.json, which is
# the only place host addresses, keys, paths and hardware facts live.
#
# Usage:  qhost [--host ROLE|NAME] <verb> [args...]
#         default host = the `gpu-test` role (override: QUASAR_DEFAULT_ROLE)
#
# Inventory
#   qhost hosts                    list configured hosts + roles
#   qhost info [--host H]          resolved facts for a host (dir, api, gpu, image, ...)
#   qhost notes [--host H]         operator notes for a host (platform quirks etc.)
#
# Build & test  (all real builds run in a container on the host; the workstation
#                has no Rust/Go/GStreamer/Docker. Locally, prefer `make <target>`.)
#   qhost test <dev.sh target...>  push current branch, sync the host to it, run
#                                  `scripts/dev/dev.sh <target...>` in the container
#                                  (go-check, go-test-db, check|build|test node-agent,
#                                   run <name>, image, shell)
#   qhost gofmt                    gofmt -l the control-plane sources (clean = exit 0)
#   qhost web-check                web typecheck + build + unit tests (node:22 container)
#   qhost sync-branch [ref]        push + hard-sync the host checkout only. No ref:
#                                  the caller's branch. A bare branch name resolves
#                                  against ORIGIN and names the host's local branch;
#                                  a SHA/tag lands detached. Echoes the landed SHA.
#
# Stack lifecycle
#   qhost ps | up | down | logs [service] | health | registered
#   qhost control                  rebuild + restart the control-plane (Go changes)
#   qhost agent                    rebuild the node-agent + force-recreate its service
#   qhost web-deploy               rebuild the SPA + restart control-plane (dist inode swap)
#   qhost redeploy [ref] [scope]   canonical full redeploy via deploy/redeploy.sh
#   qhost drift <hostA> <hostB>    assert two hosts serve the same git SHA + web bundle
#   qhost multiup|multidown|multips|multiagent    multi-agent (N>1) stack
#
# Shell / GPU / images
#   qhost sh '<cmd>'               raw command in the host's Quasar dir
#   qhost docker <args>            docker on the host
#   qhost cp <local> <dst>         copy a file to the host
#   qhost runsh <local.sh>         stage a local script into the host dir + run it there
#   qhost pyrun <local.py>         stage a local python-gi script + run it in the runtime image
#   qhost gst '<pipeline>'         gst-launch-1.0 in the runtime image, GPU attached
#   qhost gpu                      GPU presence/health (vendor-appropriate probe)
#   qhost reauth                   re-provision the host's git SSH auth (see host notes)
#
# SAFETY (enforced below): every mutating verb requires an explicit --host when the
# resolved host holds the `deploy-only` role, and destructive verbs refuse it outright.
# `sync_branch` counts as destructive and guards itself, so test/gofmt/web-check/
# sync-branch — every verb that force-resets the host's checkout — are covered by
# the function rather than by four call sites that each have to remember.
set -euo pipefail

source "$(dirname "$0")/../../_shared/lib.sh"

# Print the comment header (everything between the shebang and the first line of
# code) — a fixed line range goes stale the moment the header grows.
usage() { awk 'NR>1 && !/^#/ {exit} NR>1 {sub(/^# ?/,""); print}' "$0" >&2; }

# ── Host selection ───────────────────────────────────────────────────────────
TARGET=""
ARGS=()
while [ $# -gt 0 ]; do
  case "$1" in
    --host) [ $# -ge 2 ] || { echo "--host needs a role or host name" >&2; exit 2; }
            TARGET="$2"; HOST_EXPLICIT=1; shift 2 ;;
    --host=*) TARGET="${1#*=}"; HOST_EXPLICIT=1; shift ;;
    *) ARGS+=("$1"); shift ;;
  esac
done
set -- "${ARGS[@]:-}"

HOST_EXPLICIT="${HOST_EXPLICIT:-0}"
[ -n "$TARGET" ] || TARGET="$QUASAR_DEFAULT_ROLE"
HOST="$(q_resolve "$TARGET")" || {
  echo "qhost: unknown host or role '$TARGET' (hosts: $(q_hosts | tr '\n' ' ')| roles: $(q_roles | tr '\n' ' '))" >&2
  exit 2
}

DIR="$(q_host_cfg "$HOST" dir)"
IMAGE="$(q_host_cfg "$HOST" runtime_image)"
GPU="$(q_host_cfg "$HOST" gpu)"
AGENT_API="$(q_host_cfg "$HOST" agent_api)"
REDEPLOY_LABEL="$(q_host_cfg "$HOST" redeploy_label)"; [ -n "$REDEPLOY_LABEL" ] || REDEPLOY_LABEL="$HOST"

compose_flags() {  # $1 = "" | multiagent
  local key=compose_files files f out=""
  [ "${1:-}" = multiagent ] && key=compose_files_multiagent
  files="$(q_host_cfg "$HOST" "$key")"
  [ -n "$files" ] || files="deploy/docker-compose.yml"
  while IFS= read -r f; do [ -n "$f" ] && out="$out -f $f"; done <<EOF
$files
EOF
  printf 'docker compose%s' "$out"
}

# Role safety is _shared/lib.sh's q_has_role / q_guard_mutating — one
# implementation for every skill, not a copy per script. These two wrappers keep
# qhost's own call sites (and its messages) unchanged.
has_role() {  # has_role <role> -> true if $HOST holds it
  q_has_role "$HOST" "$1"
}

# Mutating verbs must not fire at a deploy-only host by accident.
guard_mutating() {  # guard_mutating <verb> [mutating|destructive]
  q_guard_mutating qhost "$HOST" "$HOST_EXPLICIT" "$1" "${2:-mutating}"
}

run() { q_ssh "$HOST" "cd '$DIR' && $*"; }

gpu_docker() {
  case "$GPU" in
    nvidia) printf 'docker run --rm --runtime=nvidia --gpus all -e NVIDIA_DRIVER_CAPABILITIES=all' ;;
    none)   printf 'docker run --rm' ;;
    *)      printf 'docker run --rm --device /dev/dri' ;;
  esac
}

# Hard-sync the host checkout to a ref, and report the SHA that actually landed.
#
#   no arg  push the caller's current branch, sync the host to origin/<that branch>
#   ref     deploy that ref. A BARE branch name resolves against the REMOTE
#           (origin/<ref>) — never the host's own local branch, which is routinely
#           stale and is never authoritative. `origin/x` and a SHA pass through.
#
# The host's local branch is named after the REF being deployed, not after the
# caller's branch: `sync-branch develop` from a worktree on claude/foo must leave
# the host on `develop`, or `git rev-parse --abbrev-ref HEAD` there lies about
# what is deployed. Tags and SHAs have no meaningful branch name, so they check
# out detached (HEAD) rather than minting a bogus SHA-named branch.
#
# The guard lives HERE, not at the call sites. `git checkout -B` force-moves the
# host's branch pointer, so a sync silently discards anything committed on that
# host — that is a destructive write by any reading, and three of the four
# callers (sync-branch, gofmt, web-check) used to reach it with no guard at all.
# Guarding the function instead of the verbs means a caller added later cannot
# reintroduce the gap by forgetting a line.
sync_branch() {
  local ref="${1:-}" branch="" sha
  guard_mutating "${QHOST_VERB:-sync-branch}" destructive
  if [ -z "$ref" ]; then
    branch="$(git rev-parse --abbrev-ref HEAD)"
    if [ -n "$(git status --porcelain --untracked-files=no)" ]; then
      echo "!  uncommitted tracked changes: the host runs ${branch}@HEAD, not your worktree." >&2
      echo "   Commit them first if you want them exercised." >&2
    fi
    echo "-> push ${branch}"
    git push -q origin "$branch"
    ref="origin/$branch"
  else
    case "$ref" in
      origin/*) branch="${ref#origin/}" ;;
      *)
        if git show-ref -q --verify "refs/remotes/origin/$ref" \
           || git ls-remote --exit-code --heads origin "$ref" >/dev/null 2>&1; then
          branch="$ref"; ref="origin/$ref"          # remote wins over any local branch
        elif git show-ref -q --verify "refs/tags/$ref" \
             || git rev-parse -q --verify "${ref}^{commit}" >/dev/null; then
          branch=""                                 # tag or SHA -> detached checkout
        else
          echo "qhost: ref '$ref' is not a branch on origin, nor a tag/commit here." >&2
          echo "   Push it first — a host's own local branch is never authoritative." >&2
          exit 2
        fi ;;
    esac
  fi

  echo "-> sync ${HOST} to ${ref}${branch:+ (branch ${branch})}"
  if [ -n "$branch" ]; then
    sha="$(q_ssh "$HOST" "cd '$DIR' && git fetch -q origin && git checkout -q -B '$branch' '$ref' && git rev-parse --short HEAD")"
  else
    sha="$(q_ssh "$HOST" "cd '$DIR' && git fetch -q origin && git checkout -q --detach '$ref' && git rev-parse --short HEAD")"
  fi
  echo "   ${HOST} now at ${sha} on ${branch:-detached HEAD}"
}

cmd="${1:-help}"; shift || true
QHOST_VERB="$cmd"   # so sync_branch's own guard names the verb the caller typed
case "$cmd" in

# ── Inventory ────────────────────────────────────────────────────────────────
hosts)
  echo "hosts:"; q_hosts | sed 's/^/  /'
  echo "roles:"; for r in $(q_roles); do printf '  %-12s -> %s\n' "$r" "$(q_role "$r")"; done
  echo "default role: $QUASAR_DEFAULT_ROLE -> $(q_default_host)"
  ;;

info)
  printf 'host          %s\n' "$HOST"
  for r in $(q_roles); do [ "$(q_role "$r")" = "$HOST" ] && printf 'role          %s\n' "$r"; done
  for f in dir ip api api_external agent_api gpu platform runtime_image bench_app; do
    printf '%-13s %s\n' "$f" "$(q_host_cfg "$HOST" "$f")"
  done
  printf 'compose       %s\n' "$(compose_flags)"
  ;;

notes)
  n="$(q_host_notes "$HOST")"
  if [ -n "$n" ]; then printf '%s\n' "$n" | sed 's/^/- /'
  else echo "(no operator notes for $HOST in _shared/hosts.json)"; fi
  ;;

# ── Build & test ─────────────────────────────────────────────────────────────
test)
  [ $# -gt 0 ] || { echo "qhost test <scripts/dev/dev.sh target...>" >&2; exit 2; }
  sync_branch   # guards on its own (destructive: it force-resets the checkout)
  echo "-> scripts/dev/dev.sh $*"
  echo "────────────────────────────────────────────────────────────────"
  run "scripts/dev/dev.sh $*"
  ;;

gofmt)
  sync_branch
  { printf 'cd %q\n' "$DIR"
    printf '%s\n' 'o=$(docker run --rm -v "$PWD":/workspace -w /workspace/control-plane golang:1.24 gofmt -l cmd internal migrations); [ -z "$o" ] && echo "gofmt: clean" || { echo "gofmt DIRTY:"; echo "$o"; exit 1; }'
  } | q_ssh "$HOST" bash -s
  ;;

web-check)
  sync_branch
  { printf 'cd %q\n' "$DIR"
    printf '%s\n' 'cd web && docker run --rm -v "$PWD":/app -w /app node:22 sh -c "npm install --no-audit && npm run typecheck && npm run build && npx vitest run"'
  } | q_ssh "$HOST" bash -s
  ;;

sync-branch) sync_branch "${1:-}" ;;

# ── Stack lifecycle ──────────────────────────────────────────────────────────
ps)     run "$(compose_flags) ps" ;;
up)     guard_mutating up;   run "$(compose_flags) up -d $*" ;;
down)   guard_mutating down destructive; run "$(compose_flags) down $*" ;;
logs)   run "$(compose_flags) logs --tail ${LINES:-40} $*" ;;
health) run "curl -sk $AGENT_API/health"; echo ;;

# Control-plane carries Go code: rebuild its image so merged changes take effect,
# then restart. A plain `up` reuses the stale image.
control)
  guard_mutating control
  run "$(compose_flags) build quasar-control-plane && $(compose_flags) up -d quasar-control-plane && $(compose_flags) logs --tail 20 quasar-control-plane" ;;

# --force-recreate is mandatory: a plain `up -d` is a no-op when only a mounted
# binary changed, so the container keeps running the OLD binary in memory.
agent)
  guard_mutating agent
  run "scripts/dev/dev.sh build-release node-agent && $(compose_flags) up -d --force-recreate quasar-node-agent && $(compose_flags) logs --tail 20 quasar-node-agent" ;;

# web/dist is a bind mount; rebuilding it from scratch swaps the directory inode so
# the running container 404s `/` until restarted — hence the restart.
web-deploy)
  guard_mutating web-deploy
  run 'docker run --rm -v "$PWD/web":/w alpine rm -rf /w/dist
       docker run --rm -v "$PWD/web":/app -w /app node:22 sh -c "npm install --no-audit && npm run build"
       '"$(compose_flags)"' restart quasar-control-plane' ;;

redeploy)
  guard_mutating redeploy
  run "bash deploy/redeploy.sh $REDEPLOY_LABEL ${1:-origin/main} ${2:-all}" ;;

registered)
  # Admin read: list enrolled hosts. The bearer comes from THE one ladder,
  # scripts/dx/admin_token.sh — never a second inline BOOTSTRAP_ADMIN login here.
  # It is piped in on stdin rather than spliced into the remote argv, so it never
  # shows up in the host's process list.
  QHOST_ROOT="$(cd "$(dirname "$0")/../../../.." && pwd)"
  T="$(DX_HOSTS_JSON="$QUASAR_HOSTS_JSON" bash "$QHOST_ROOT/scripts/dx/admin_token.sh" --host "$HOST" --quiet)" || T=""
  [ -n "$T" ] || { echo "qhost registered: no admin bearer (run: scripts/dx/admin_token.sh --host $HOST --fresh)" >&2; exit 2; }
  # The bearer was minted on THIS workstation, so read the control plane from
  # here too (api_external, the same URL `make session-*` uses). agent_api's
  # plain-http port now 301s to https and a bare `curl -sk` returns the redirect
  # page, which is what "Expecting value: line 1 column 1" was.
  REG_API="$(q_host_cfg "$HOST" api_external)"; [ -n "$REG_API" ] || REG_API="$AGENT_API"
  HDR="$(mktemp)"; chmod 600 "$HDR"; printf 'Authorization: Bearer %s\n' "$T" > "$HDR"
  curl -sSLk -H @"$HDR" "${REG_API%/}/v1/hosts" | python3 -m json.tool; RC=$?
  rm -f "$HDR"; exit $RC ;;

drift)
  A="${1:?usage: qhost drift <hostA|roleA> <hostB|roleB>}"; B="${2:?usage: qhost drift <A> <B>}"
  for side in "$A" "$B"; do
    h="$(q_resolve "$side")" || { echo "unknown host/role: $side" >&2; exit 2; }
    d="$(q_host_cfg "$h" dir)"; api="$(q_host_cfg "$h" agent_api)"
    sha="$(q_ssh "$h" "cd '$d' && git rev-parse --short HEAD")"
    bundle="$(q_ssh "$h" "curl -sk $api/ | grep -o 'assets/index-[A-Za-z0-9_-]*\.js' | head -1")"
    echo "  $h: sha=$sha bundle=$bundle"
    if [ "$side" = "$A" ]; then A_SHA="$sha"; A_B="$bundle"; else B_SHA="$sha"; B_B="$bundle"; fi
  done
  if [ "$A_SHA" = "$B_SHA" ] && [ "$A_B" = "$B_B" ]; then
    echo "IN SYNC: sha=$A_SHA bundle=$A_B"
  else
    echo "DRIFT: redeploy both to the same ref before any cross-host test" >&2; exit 1
  fi ;;

multiup)   guard_mutating multiup;   run "$(compose_flags multiagent) up -d $*" ;;
multidown) guard_mutating multidown destructive; run "$(compose_flags multiagent) down $*" ;;
multips)   run "$(compose_flags multiagent) ps" ;;
multiagent)
  guard_mutating multiagent
  run "scripts/dev/dev.sh build-release node-agent && \
       $(compose_flags multiagent) up -d --force-recreate quasar-node-agent quasar-node-agent-1 quasar-node-agent-2 && \
       $(compose_flags multiagent) logs --tail 20 quasar-node-agent quasar-node-agent-1 quasar-node-agent-2" ;;

# ── Shell / GPU / images ─────────────────────────────────────────────────────
sh)     guard_mutating sh; run "$*" ;;
docker) guard_mutating docker; q_ssh "$HOST" "docker $*" ;;
cp)     guard_mutating cp; q_scp "$HOST" "${1:?qhost cp <local> <dst>}" "${2:?qhost cp <local> <dst>}" ;;

runsh)
  # Stage a LOCAL script into the host's Quasar dir and run it THERE (not in a
  # container). Some hosts forbid scratch files outside `dir` — see `qhost notes`.
  guard_mutating runsh
  [ -f "${1:-}" ] || { echo "qhost runsh <local.sh>: file not found: ${1:-}" >&2; exit 2; }
  base="$(basename "$1")"
  q_scp "$HOST" "$1" "$DIR/$base"
  q_ssh "$HOST" "cd '$DIR' && bash '$DIR/$base'" ;;

pyrun)
  guard_mutating pyrun
  [ -f "${1:-}" ] || { echo "qhost pyrun <local.py>: file not found: ${1:-}" >&2; exit 2; }
  [ -n "$IMAGE" ] || { echo "qhost pyrun: host '$HOST' has no runtime_image in hosts.json" >&2; exit 2; }
  base="$(basename "$1")"
  q_scp "$HOST" "$1" "$DIR/$base"
  q_ssh "$HOST" "$(gpu_docker) -v '$DIR':/work -w /work '$IMAGE' python3 '/work/$base'" ;;

gst)
  guard_mutating gst
  [ -n "$IMAGE" ] || { echo "qhost gst: host '$HOST' has no runtime_image in hosts.json" >&2; exit 2; }
  q_ssh "$HOST" "$(gpu_docker) -v '$DIR':/work -w /work '$IMAGE' gst-launch-1.0 $*" ;;

gpu)
  case "$GPU" in
    nvidia) q_ssh "$HOST" "nvidia-smi $*" ;;
    amd|intel) q_ssh "$HOST" "ls -l /dev/dri && (vainfo 2>/dev/null || docker run --rm --device /dev/dri '$IMAGE' vainfo)" ;;
    none) echo "host '$HOST' declares gpu=none" ;;
    *) echo "host '$HOST' has no gpu field in hosts.json" >&2; exit 2 ;;
  esac ;;

reauth)
  # Re-provision the host's git SSH auth. Needed on platforms whose ~/.ssh is
  # volatile across reboots — check `qhost notes` for whether that applies here.
  guard_mutating reauth
  q_ssh "$HOST" "grep -q 'Host github.com' ~/.ssh/config 2>/dev/null || printf '\nHost github.com\n  IdentityFile ~/.ssh/github\n  IdentitiesOnly yes\n' >> ~/.ssh/config; ssh-keyscan github.com >> ~/.ssh/known_hosts 2>/dev/null; git -C '$DIR' ls-remote >/dev/null 2>&1 && echo 'git auth OK' || echo 'git auth FAILING — is the key at ~/.ssh/github?'" ;;

help|*) usage; exit 2 ;;
esac
