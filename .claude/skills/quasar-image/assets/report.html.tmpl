<!doctype html>
<html><head><meta charset="utf-8"><title>Quasar image fleet report</title>
<style>
 body{font:14px/1.5 -apple-system,Segoe UI,sans-serif;margin:2rem;color:#1a1a1a}
 .verdict{padding:.75rem 1rem;border-radius:6px;font-weight:600;margin-bottom:1.5rem}
 .ok{background:#e6f4ea;color:#137333}.bad{background:#fce8e6;color:#c5221f}
 table{border-collapse:collapse;width:100%;margin:.5rem 0 1.5rem}
 th,td{text-align:left;padding:.4rem .6rem;border-bottom:1px solid #e0e0e0}
 th{font-weight:600;background:#fafafa}
 .bar{display:inline-block;height:8px;background:#137333;border-radius:4px;vertical-align:middle;margin-right:.4rem}
 .bar.over{background:#c5221f}
 .fail{color:#c5221f;font-family:ui-monospace,monospace;font-size:12px}
 .muted{color:#666}
 code{font-family:ui-monospace,monospace;font-size:12px}
 .tag-ok{color:#137333;font-weight:600}
 .tag-bad{color:#c5221f;font-weight:700}
 .tag-unknown{color:#8a6d00;font-style:italic}
 ul.running{list-style:none;padding:0;margin:.4rem 0 1.25rem;background:#fafafa;
   border:1px solid #e0e0e0;border-radius:6px}
 ul.running li{padding:.35rem .75rem;border-bottom:1px solid #eee}
 ul.running li:last-child{border-bottom:none}
</style></head><body>
<h1>Quasar image fleet report</h1>
<div class="verdict {{verdict_class}}">{{verdict_text}}</div>
<p class="muted">Generated {{generated_at}}</p>
{{host_sections}}
{{provenance_section}}
{{drift_section}}
</body></html>
