#!/usr/bin/env bash
# validate — quasar-image self-test.
#
#   validate              # offline checks
#   validate --live HOST  # additionally prove a real collect against HOST
#                         # shapes up (reachable, roles present, every role
#                         # sized) -- exercises _qimg_collect.py end to end
#                         # against a live host and its GStreamer registry.
set -euo pipefail
SKILL_DIR="$(cd "$(dirname "$0")/.." && pwd)"
REPO_ROOT="$(cd "$SKILL_DIR/../../.." && pwd)"
LIVE_HOST=""
[ "${1:-}" = "--live" ] && LIVE_HOST="${2:?--live needs a host name}"
fail() { printf 'FAIL  %s\n' "$*" >&2; exit 1; }
pass() { printf 'PASS  %s\n' "$*"; }

python3 -c "
import json
c = json.load(open('$SKILL_DIR/config.json'))
for k in ('roles','report','deploy'):
    assert k in c, 'config.json missing key: ' + k
assert c['roles'], 'roles is empty'
for r, v in c['roles'].items():
    assert 'tag' in v, r + ' has no tag'
" || fail "config.json invalid"
pass "config.json"

# FIX 7a (spec §11 R5): config.json's role -> tag map must cover every role
# deploy/image-contract.json declares -- this guards exactly the drift class
# this branch exists to prevent (a role the contract knows about that the
# skill silently never collects/reports on).
python3 -c "
import json
cfg = json.load(open('$SKILL_DIR/config.json'))
contract = json.load(open('$REPO_ROOT/deploy/image-contract.json'))
# '_'-prefixed keys are documentation, not roles — the same convention
# config.json uses for '_comment'/'_role'. image-contract.json gained one
# ('_retired_nv_role', #545) and this check started failing on a note.
contract_roles = {r for r in contract['roles'] if not r.startswith('_')}
missing = sorted(contract_roles - set(cfg['roles']))
assert not missing, 'image-contract.json roles missing from config.json: %s' % missing
" || fail "config.json role map does not cover deploy/image-contract.json roles"
pass "config.json covers image-contract.json roles (FIX 7a)"

# FIX 7b (spec §9 item 1): every host named anywhere in the skill's own
# config (currently the deploy-command map) must resolve via _shared/lib.sh
# -- a host referenced here with no entry in hosts.json would fail silently
# at `qimg deploy` time instead of at self-test time.
source "$SKILL_DIR/../_shared/lib.sh"
# Process-substitution (not a `| while`) so the loop runs in THIS shell --
# a `| while` runs the loop in a subshell, where `fail`'s `exit 1` would only
# kill the subshell and this self-test would wrongly keep going.
while IFS= read -r h; do
  [ -n "$h" ] || continue
  [ -n "$(q_host_cfg "$h" dir)" ] || fail "config.json names host '$h' which does not resolve via _shared/lib.sh"
done < <(python3 -c "
import json
c = json.load(open('$SKILL_DIR/config.json'))
# '_comment'-style keys are documentation, not host names -- config.json's
# own convention throughout (see roles/report) for an inline note field.
print(' '.join(sorted(k for k in c.get('deploy', {}) if not k.startswith('_'))))
" | tr ' ' '\n')
pass "config.json hosts resolve via _shared/lib.sh (FIX 7b)"

python3 -c "import ast,sys; [ast.parse(open(f).read()) for f in sys.argv[1:]]" \
  "$SKILL_DIR"/scripts/_qimg_*.py || fail "python syntax"
pass "python syntax"

# Report renders from fixtures — no host, no GPU. Both a passing and a
# contract-VIOLATING image are covered, so the failure rendering path is exercised.
TMP="$(mktemp -d)"
trap 'rm -rf "$TMP"' EXIT
python3 "$SKILL_DIR/scripts/_qimg_fixture_doc.py" > "$TMP/doc.json" \
  || fail "fixture doc build"
python3 "$SKILL_DIR/scripts/_qimg_report.py" --in "$TMP/doc.json" --out "$TMP/r.html" \
  && fail "report should exit 1 when a role violates its contract" || true
[ -s "$TMP/r.html" ] || fail "report produced no output"
grep -q "33" "$TMP/r.html" || fail "violating image's failure count missing from report"
grep -q "6994" "$TMP/r.html" || fail "violating image's size missing from report"
grep -qi "<script\|</style>" "$TMP/r.html" || fail "report is not self-contained"
grep -q "http://\|https://" "$TMP/r.html" && fail "report references an external asset"
grep -q '{{' "$TMP/r.html" && fail "unresolved template placeholder survived into output"
pass "report renders from fixtures (pass + violating)"

# FIX 2 regression: the size-ceiling bar's `over` class must appear for the
# host over its ceiling (fixture-bad, 6994/2300 MB) and NOT for the host
# under its ceiling (fixture-good, 1786/2300 MB) -- both fixtures now carry
# contract.size_max_mb, so this path is no longer permanently dead.
python3 - "$TMP/r.html" <<'PY' || fail "size-ceiling over/under class mismatch"
import re, sys
text = open(sys.argv[1]).read()
bars = re.findall(r"<span class='bar( over)?' style='width:\d+px'></span>(\d+)/(\d+) MB", text)
under = [b for b in bars if b[1] == "1786" and b[2] == "2300"]
over = [b for b in bars if b[1] == "6994" and b[2] == "2300"]
if not under or under[0][0] != "":
    print("expected fixture-good (1786/2300 MB) to render WITHOUT the 'over' class")
    sys.exit(1)
if not over or over[0][0] != " over":
    print("expected fixture-bad (6994/2300 MB) to render WITH the 'over' class")
    sys.exit(1)
PY
pass "size-ceiling bar renders over/under class correctly (FIX 2 regression)"

# FIX 1 regression: a fleet where every contract passes and every host is
# reachable, but the same tag resolves to different image ids across hosts,
# must still exit 1 -- drift alone must flip the exit code.
python3 "$SKILL_DIR/scripts/_qimg_fixture_doc.py" --drift-only > "$TMP/drift.json" \
  || fail "drift-only fixture doc build"
python3 "$SKILL_DIR/scripts/_qimg_report.py" --in "$TMP/drift.json" --out "$TMP/drift.html" \
  && fail "report should exit 1 when drift is the only problem" || true
grep -q "resolves to 2 different images" "$TMP/drift.html" \
  || fail "drift-only report missing drift text"
grep -q '{{' "$TMP/drift.html" && fail "unresolved template placeholder survived into drift-only output"
pass "fleet drift alone flips exit code to 1 (FIX 1 regression)"

# Every template placeholder is emitted, and every emitted key has a placeholder.
# FIX 7c: the orphan direction (emits - holes) is just as real a drift class
# as the missing direction (holes - emits) -- a SLOT key nobody's template
# hole references is dead code the generator computes for nothing, and
# either direction going stale (a template hole added with no SLOT entry,
# or a SLOT entry added/renamed with no matching hole) should fail loudly
# rather than passing silently because only one direction was ever checked.
python3 - "$SKILL_DIR" <<'PY' || exit 1
import re, sys, pathlib
d = pathlib.Path(sys.argv[1])
tmpl = (d / "assets/report.html.tmpl").read_text()
gen  = (d / "scripts/_qimg_report.py").read_text()
holes = set(re.findall(r"\{\{(\w+)\}\}", tmpl))
# Scope the "emitted key" scan to the SLOT dict literal itself (plus any
# SLOT['key'] assignment form) -- the naive whole-file '"(\w+)":' regex also
# matches unrelated dict-shaped text (e.g. \"if __name__ == '__main__':\"),
# which would manufacture a false orphan the moment the orphan direction
# (FIX 7c) is checked.
slot_block = re.search(r"SLOT\s*=\s*\{(.*?)\n\s*\}", gen, re.S)
slot_text = slot_block.group(1) if slot_block else ""
emits = set(re.findall(r'"(\w+)":\s*', slot_text)) | set(re.findall(r"SLOT\['(\w+)'\]", gen))
missing = holes - emits
orphans = emits - holes
if missing:
    print("FAIL  template placeholders never emitted: %s" % sorted(missing)); sys.exit(1)
if orphans:
    print("FAIL  emitted keys with no matching template placeholder: %s" % sorted(orphans)); sys.exit(1)
print("PASS  template placeholders")
PY

# qimg dispatcher: syntax, --help, bad-verb rejection, and the deploy-refuses-
# an-unconfigured-host guard -- all safe to run with no host/network (the
# unknown-host and bad-verb paths die before ever calling q_ssh).
bash -n "$SKILL_DIR/scripts/qimg" || fail "qimg syntax"
"$SKILL_DIR/scripts/qimg" --help >/dev/null 2>&1 || fail "qimg --help"
"$SKILL_DIR/scripts/qimg" nosuchverb >/dev/null 2>&1 && fail "qimg accepted a bad verb"
"$SKILL_DIR/scripts/qimg" deploy --host __nope__ >/dev/null 2>&1 \
  && fail "qimg deploy should refuse a host with no deploy command"
pass "qimg dispatcher"

# Collector gap-close (Task 5): roles[].source_dirty must be sourced from the
# host's deploy/.build-report.json (source_commit already comes from a baked
# docker image label -- this is the ONLY path for the dirty flag, since a
# build doesn't/can't bake its own dirtiness into a label). Matched by role
# name always, and additionally cross-checked by image_id whenever BOTH the
# receipt and the collected role carry one -- so a stale receipt (a different
# generation than the tag currently resolves to) is never misattributed.
# Pure unit test against the committed fixture -- no host, no network, never
# raises.
python3 - "$SKILL_DIR" <<'PY' || fail "collector build-report gap-close"
import importlib.util, os, sys
d = sys.argv[1]
spec = importlib.util.spec_from_file_location(
    "_qimg_collect", os.path.join(d, "scripts", "_qimg_collect.py"))
m = importlib.util.module_from_spec(spec)
spec.loader.exec_module(m)

report_text = open(os.path.join(d, "assets", "fixtures", "build-report.json")).read()
NV_ID = "sha256:47d971decfe9562c468525e13b826f07aeaff6bd0305bc4e37991b4b562f60b1"

def role(name, image_id):
    return {"role": name, "tag": "x:latest", "image_id": image_id, "size_mb": 1,
            "created": None, "labels": {}, "contract": None, "source_dirty": None}

# Matching role + image_id -> the receipt's source_dirty flows through.
r = [role("nv", NV_ID)]
m.apply_build_report(r, report_text)
assert r[0]["source_dirty"] is True, "fixture source_dirty=true did not flow through on an image_id match"

# Stale receipt (image_id no longer matches the tag's current image) must NOT apply.
r = [role("nv", "sha256:deadbeef")]
m.apply_build_report(r, report_text)
assert r[0]["source_dirty"] is None, "stale build-report (image_id mismatch) must not be applied"

# A role absent from the receipt's own roles[] must not inherit another role's flag.
r = [role("runtime", "sha256:whatever")]
m.apply_build_report(r, report_text)
assert r[0]["source_dirty"] is None, "a role absent from the receipt must not inherit another role's dirty flag"

# Absent/null/malformed receipt (image built before this tooling, or bad JSON)
# degrades to null -- normal, not an error -- and never raises.
for bad in ("null", "", "not json at all", "{}"):
    r = [role("nv", NV_ID)]
    m.apply_build_report(r, bad)
    assert r[0]["source_dirty"] is None, "malformed/absent receipt must degrade to null, not raise"

print("PASS  build-report source_dirty gap-close")
PY

# FIX 1/2 regression: every OTHER fixture in this skill is a hand-written,
# already-normalized document, so _qimg_collect.py's own parsing layer (the
# BASE-section split/decode inside collect_host) has never actually been
# exercised by a test -- which is exactly how six prior reviews missed the
# real bug: `docker image inspect --format ...` appends a trailing newline
# PER IMAGE, so a host with >1 present tag emits a multi-line BASE body
# whose last line is just the array's closing `]}`. The old parser did
# `sections["BASE"].strip().splitlines()[-1]` -- grabbing only that closing
# fragment -- so `json.loads` always raised, `base_error` got set, and every
# real collection silently degraded to zero populated roles (image_id/
# size_mb/created/labels all null), while still reporting `reachable: true`
# and exiting 0. This fixture is the raw, uncooked stdout of a real run of
# _REMOTE_TMPL (captured by piping it through a stub `docker` on PATH with
# SKIP_LIVE=1 -- no real host, no real docker daemon, no ssh) so it carries
# the exact multi-line shape that broke the old parser, not a hand-massaged
# one-liner that would never have caught this.
python3 - "$SKILL_DIR" <<'PY' || fail "raw-stdout collector regression (FIX 1/2)"
import importlib.util, os, sys
d = sys.argv[1]
spec = importlib.util.spec_from_file_location(
    "_qimg_collect_rawtest", os.path.join(d, "scripts", "_qimg_collect.py"))
m = importlib.util.module_from_spec(spec)
spec.loader.exec_module(m)

raw = open(os.path.join(d, "assets", "fixtures", "raw-collect-stdout.txt")).read()

# Stub the two host-touching primitives collect_host calls -- sh() (the one
# SSH round trip) and q() (the local _shared/lib.sh host_cfg lookups) -- so
# this drives the REAL split_sections() -> collect_host() parsing chain
# against the REAL captured bytes, with zero host/network/GPU involved.
m.sh = lambda host, command: (0, raw)
m.q = lambda cmd: "nvidia" if "gpu" in cmd else "/workspace/quasar"

c = m.cfg()
roles = c["roles"]
result = m.collect_host("faux-host", roles, roles, c["agent_container_filter"], fast=True)

assert result["reachable"] is True, "expected reachable=True, got: %r" % result
assert result.get("error") is None, (
    "BASE section failed to parse (this is the FIX 1 bug if it reappears): %r"
    % result.get("error"))

by_role = {r["role"]: r for r in result["roles"]}
assert "runtime" in by_role, "runtime role missing from collected roles: %r" % sorted(by_role)
assert "nv" in by_role, "nv role missing from collected roles: %r" % sorted(by_role)

runtime = by_role["runtime"]
assert runtime["image_id"] == (
    "sha256:aaaa1111aaaa1111aaaa1111aaaa1111aaaa1111aaaa1111aaaa1111aaaa1111"
), "runtime image_id not populated from the fixture: %r" % runtime["image_id"]
assert runtime["size_mb"] == 1857231872 // 1024 // 1024, runtime["size_mb"]
assert runtime["labels"].get("org.quasar.source.commit") == "abc1234", runtime["labels"]

nv = by_role["nv"]
assert nv["image_id"] == (
    "sha256:bbbb2222bbbb2222bbbb2222bbbb2222bbbb2222bbbb2222bbbb2222bbbb2222"
), "nv image_id not populated from the fixture: %r" % nv["image_id"]
assert nv["size_mb"] == 2306867200 // 1024 // 1024, nv["size_mb"]
assert nv["labels"].get("org.quasar.source.commit") == "def5678", nv["labels"]

print("PASS  raw-stdout collector regression: roles populated from real multi-line BASE (FIX 1/2)")
PY

# repin diff (Task 6): _qimg_diff.py is pure (no host, no network) -- it
# takes two role-entry-shaped snapshots (the same shape _qimg_collect.py
# produces per role: size_mb/labels/contract.assertions) and exits 1 on any
# newly_failing assertion OR any lost element, 0 otherwise. The element delta
# is the point of the tool, so it's covered from two angles: an assertion
# flipping PASS->FAIL (visible in newly_failing too) and an assertion for an
# element vanishing entirely from the after snapshot (NOT visible in
# newly_failing -- only elements_lost catches it).
python3 - "$SKILL_DIR" <<'PY' || fail "repin diff"
import json, subprocess, sys, tempfile, os, pathlib
d = pathlib.Path(sys.argv[1])
DIFF = str(d / "scripts/_qimg_diff.py")
T = tempfile.mkdtemp()

def snap(size, assertions, labels=None):
    return {"size_mb": size, "labels": labels or {},
            "contract": {"assertions": assertions}}

def run(before, after):
    bp, ap = os.path.join(T, "b.json"), os.path.join(T, "a.json")
    json.dump(before, open(bp, "w"))
    json.dump(after, open(ap, "w"))
    return subprocess.run([sys.executable, DIFF, "--before", bp, "--after", ap],
                           capture_output=True, text=True)

# 1. Brief's own case: an element flips PASS->FAIL, size grows, a pin changes.
before = snap(1786, [{"status": "PASS", "id": "gst-gpu.nvav1enc", "detail": "registered"},
                      {"status": "PASS", "id": "size", "detail": "1786MB <= 2300MB"}],
              {"org.quasar.pins.gwd": "aaaa"})
after = snap(1900, [{"status": "FAIL", "id": "gst-gpu.nvav1enc", "detail": "element not registered"},
                     {"status": "PASS", "id": "size", "detail": "1900MB <= 2300MB"}],
             {"org.quasar.pins.gwd": "bbbb"})
p = run(before, after)
assert p.returncode == 1, "diff must exit 1 when an assertion newly fails: " + p.stderr
out = json.loads(p.stdout)
assert out["size_delta_mb"] == 114, out
assert "gst-gpu.nvav1enc" in out["newly_failing"], out
assert out["elements_lost"] == ["nvav1enc"], out
assert out["pin_deltas"]["org.quasar.pins.gwd"] == ["aaaa", "bbbb"], out

# 2. No-op re-pin: identical before/after -> exit 0, every field empty/zero.
same = snap(1786, [{"status": "PASS", "id": "gst.vah264enc", "detail": "registered"},
                    {"status": "PASS", "id": "size", "detail": "ok"}],
            {"org.quasar.pins.gwd": "43d4c25"})
p = run(same, same)
assert p.returncode == 0, "identical snapshots must be a no-op: " + p.stdout + p.stderr
out = json.loads(p.stdout)
assert out == {"size_delta_mb": 0, "newly_failing": [], "newly_passing": [],
               "elements_lost": [], "elements_gained": [], "pin_deltas": {}}, out

# 3. The silent-regression case this tool exists for: the element's assertion
# is entirely ABSENT from `after` (not merely FAILing) -- e.g. the new
# contract stopped even probing for it. newly_failing can't see this (there
# is no "after" status to compare); elements_lost must catch it anyway, and
# it must still exit 1.
before = snap(1786, [{"status": "PASS", "id": "gst.vah264enc", "detail": "registered"},
                      {"status": "PASS", "id": "size", "detail": "ok"}])
after = snap(1786, [{"status": "PASS", "id": "size", "detail": "ok"}])  # vah264enc gone, not FAILed
p = run(before, after)
assert p.returncode == 1, "a silently-dropped element assertion must still exit 1: " + p.stdout
out = json.loads(p.stdout)
assert out["elements_lost"] == ["vah264enc"], out
assert out["newly_failing"] == [], "a vanished assertion has no after-status, so it is NOT newly_failing: " + str(out)

# 4. Gaining an element alone (no loss, no new failure) must NOT fail the diff.
before = snap(1786, [{"status": "PASS", "id": "size", "detail": "ok"}])
after = snap(1786, [{"status": "PASS", "id": "size", "detail": "ok"},
                     {"status": "PASS", "id": "gst.av1enc", "detail": "registered"}])
p = run(before, after)
assert p.returncode == 0, "an element gained alone must not fail the diff: " + p.stdout + p.stderr
out = json.loads(p.stdout)
assert out["elements_gained"] == ["av1enc"], out
assert out["elements_lost"] == [], out

# 5. A pin change alone (nothing broke) is reported but does not fail the diff.
before = snap(1786, [{"status": "PASS", "id": "size", "detail": "ok"}],
              {"org.quasar.pins.gstreamer": "1.28.4"})
after = snap(1786, [{"status": "PASS", "id": "size", "detail": "ok"}],
             {"org.quasar.pins.gstreamer": "1.28.5"})
p = run(before, after)
assert p.returncode == 0, p.stdout + p.stderr
out = json.loads(p.stdout)
assert out["pin_deltas"] == {"org.quasar.pins.gstreamer": ["1.28.4", "1.28.5"]}, out

# 6. A snapshot missing `contract`/`labels` entirely (or carrying them as
# null) must degrade cleanly, never crash -- e.g. a fully-failed ssh round
# trip that only ever captured a bare size_mb.
p = run({"size_mb": 1786}, {"size_mb": 1900})
assert p.returncode == 0, "missing contract/labels must not crash: " + p.stderr
out = json.loads(p.stdout)
assert out == {"size_delta_mb": 114, "newly_failing": [], "newly_passing": [],
               "elements_lost": [], "elements_gained": [], "pin_deltas": {}}, out
p = run({"size_mb": 1786, "labels": None, "contract": None},
        {"size_mb": 1786, "labels": None, "contract": None})
assert p.returncode == 0, "explicit null contract/labels must not crash: " + p.stderr

# 7. FIX 4 (--deep): a wider full-inventory element list carried under
# "deep_elements" widens elements_lost/elements_gained even for an element
# the CONTRACT never named at all (no assertion for it in either snapshot) --
# proving --deep catches what the contract-only path (case 3 above) cannot.
# Present on only ONE side must NOT manufacture a false delta (no baseline).
before = snap(1786, [{"status": "PASS", "id": "size", "detail": "ok"}])
before["deep_elements"] = ["vah264enc", "openh264enc"]
after = snap(1786, [{"status": "PASS", "id": "size", "detail": "ok"}])
after["deep_elements"] = ["openh264enc"]
p = run(before, after)
assert p.returncode == 1, "a --deep-only element loss must still exit 1: " + p.stdout + p.stderr
out = json.loads(p.stdout)
assert out["elements_lost"] == ["vah264enc"], out
assert out["newly_failing"] == [], "the contract never named this element, so it can't be newly_failing: " + str(out)

one_sided_before = snap(1786, [{"status": "PASS", "id": "size", "detail": "ok"}])
one_sided_before["deep_elements"] = ["vah264enc"]
one_sided_after = snap(1786, [{"status": "PASS", "id": "size", "detail": "ok"}])  # no --deep this side
p = run(one_sided_before, one_sided_after)
assert p.returncode == 0, "a one-sided deep_elements (asymmetric --deep) must not fabricate a delta: " + p.stdout
out = json.loads(p.stdout)
assert out["elements_lost"] == [], out

print("PASS  repin diff")
PY

# deploy-only contract (hosts.example.json): `build` promotes :latest on the
# target, so a production host refuses it outright. Asserted against the shared
# synthetic fleet, never real gear. `ssh` is never reached: the guard exits
# before any remote hop, which is the whole point.
(
  export QUASAR_HOSTS_JSON="$SKILL_DIR/../_shared/fixtures/hosts.three-role.json"
  msg="$(bash "$SKILL_DIR/scripts/qimg" build --host deploy-only 2>&1 || true)"
  case "$msg" in
    *"no destructive operations"*) exit 0 ;;
    *) printf 'FAIL  qimg build not refused on a deploy-only host: %s\n' "$msg" >&2; exit 1 ;;
  esac
) || fail "deploy-only guard missing on qimg build"
pass "qimg build refused on a deploy-only host"

if [ -n "$LIVE_HOST" ]; then
  out="$(mktemp)"
  python3 "$SKILL_DIR/scripts/_qimg_collect.py" --host "$LIVE_HOST" > "$out" \
    || fail "live collect failed"
  python3 -c "
import json,sys
d=json.load(open('$out'))
h=d['hosts'][0]
assert h['reachable'], h.get('error')
assert h['roles'], 'no roles collected'
assert all(r['size_mb'] > 0 for r in h['roles']), 'a role has no size'
" || fail "live document shape"
  rm -f "$out"
  pass "live collect against $LIVE_HOST"
fi

printf '\nquasar-image: all checks passed\n'
