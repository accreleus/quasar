#!/usr/bin/env bash
# qimg — Quasar image fleet: audit, validate, build, re-pin, deploy, report.
#
#   qimg status  [--host H|--all] [--json] [--fast]
#   qimg validate --host H [--role R] [--gpu|--no-gpu]
#   qimg build   --host H [roles...] [--pin k=v]... [--dry-run]
#   qimg repin   --host H --gwd-ref X [--deep]        (Task 6)
#   qimg deploy  --host H
#   qimg report  [--host H|--all] [-o FILE] [--fast]
#
# The skill NEVER re-implements build or assertion logic — every action shells out
# to deploy/build-images.sh or deploy/validate-image.sh ON THE HOST. Hosts come from
# _shared/hosts.json; adding one is a JSON entry, no code change.
#
# --fast skips validate-image.sh's contract checks (roles[].contract stays null)
# and the live `running` checks -- it does NOT skip the disk/image round trip.
# It is the operator-decided fast path for `status` (contract validation is the
# default); accepted on `report` too since both verbs share the same collect step.
#
# Exit: 0 clean · 1 contract violation or drift · 2 usage/infra error.
set -euo pipefail

SKILL_DIR="$(cd "$(dirname "$0")/.." && pwd)"
source "$(dirname "$0")/../../_shared/lib.sh"

die()  { printf 'qimg: %s\n' "$*" >&2; exit 2; }
usage() { sed -n '2,20p' "$0" | sed 's/^# \{0,1\}//'; }

# Single-quote a token for safe interpolation into a remote shell command
# line (bash 3.2 compatible -- no ${var@Q}). Standard trick: close the
# quote, emit an escaped literal quote, reopen the quote. The quote chars
# are held in variables (not typed as literal backslash-escapes inside the
# ${//} pattern/string) to sidestep the ambiguity of nested quote-escaping
# inside a double-quoted parameter expansion.
shquote() {
  local q="'" bq="'\\''"
  printf '%s' "$q${1//$q/$bq}$q"
}

cfgval() { python3 -c "
import json,sys
c=json.load(open('$SKILL_DIR/config.json'))
cur=c
for k in sys.argv[1:]:
    cur=cur.get(k, '') if isinstance(cur, dict) else ''
print(cur if isinstance(cur,str) else json.dumps(cur))
" "$@"; }

VERB="${1:-}"; shift || true
[ -n "$VERB" ] || { usage; exit 2; }
case "$VERB" in -h|--help) usage; exit 0 ;; esac

HOSTS=(); ROLE=""; GPU=""; OUT=""; JSON=0; FAST=0; PASSTHRU=()
while [ $# -gt 0 ]; do
  case "$1" in
    --host)  [ $# -ge 2 ] || die "--host needs a value"; HOSTS+=("$2"); shift 2 ;;
    --all)   while IFS= read -r h; do HOSTS+=("$h"); done < <(q_hosts); shift ;;
    --role)  [ $# -ge 2 ] || die "--role needs a value"; ROLE="$2"; shift 2 ;;
    --gpu)   GPU="--gpu"; shift ;;
    --no-gpu) GPU="--no-gpu"; shift ;;
    -o|--out) [ $# -ge 2 ] || die "-o/--out needs a value"; OUT="$2"; shift 2 ;;
    --json)  JSON=1; shift ;;
    --fast)  FAST=1; shift ;;
    *)       PASSTHRU+=("$1"); shift ;;
  esac
done

remote_repo() { q_host_cfg "$1" dir; }

case "$VERB" in
  status|report)
    [ "${#HOSTS[@]}" -gt 0 ] || while IFS= read -r h; do HOSTS+=("$h"); done < <(q_hosts)
    args=(); for h in "${HOSTS[@]}"; do args+=(--host "$h"); done
    [ "$FAST" = 1 ] && args+=(--fast)
    DOC="$(mktemp)"; trap 'rm -f "$DOC"' EXIT
    python3 "$SKILL_DIR/scripts/_qimg_collect.py" "${args[@]}" > "$DOC"

    # The report generator is the sole source of the contract/drift verdict
    # (req: dispatcher propagates rather than swallows exit 1) -- so even the
    # raw --json path renders a throwaway report purely to capture its exit
    # code, then discards the HTML and emits the JSON doc instead.
    if [ "$VERB" = status ] && [ "$JSON" = 1 ]; then
      # FIX 8: `>/dev/null 2>&1` used to swallow the generator's stderr
      # entirely, so a real failure (missing template, malformed doc) came
      # back as a bare exit code with the JSON doc still printed and no clue
      # why. Capture stderr and surface it on our own stderr -- stdout stays
      # JSON-only either way, so a caller parsing `qimg status --json` is
      # unaffected; a human (or a log) now sees the diagnostic instead of it
      # vanishing.
      TMPHTML="$(mktemp)"; TMPERR="$(mktemp)"; RC=0
      python3 "$SKILL_DIR/scripts/_qimg_report.py" --in "$DOC" --out "$TMPHTML" >/dev/null 2>"$TMPERR" || RC=$?
      [ -s "$TMPERR" ] && cat "$TMPERR" >&2
      rm -f "$TMPHTML" "$TMPERR"
      cat "$DOC"
      exit "$RC"
    fi

    if [ -z "$OUT" ]; then
      dir="$(cfgval report default_dir)"; mkdir -p "$dir"
      OUT="$dir/$(cfgval report filename | sed "s/{ts}/$(date -u +%Y%m%dT%H%M%SZ)/")"
    fi
    python3 "$SKILL_DIR/scripts/_qimg_report.py" --in "$DOC" --out "$OUT"
    ;;

  validate)
    [ "${#HOSTS[@]}" -eq 1 ] || die "validate needs exactly one --host"
    h="${HOSTS[0]}"; d="$(remote_repo "$h")"; [ -n "$d" ] || die "unknown host '$h'"
    [ -n "$ROLE" ] || die "validate needs --role"
    tag="$(cfgval roles "$ROLE" tag)"; [ -n "$tag" ] || die "unknown role '$ROLE'"
    if [ -z "$GPU" ]; then
      [ "$(q_host_cfg "$h" gpu)" = "none" ] && GPU="--no-gpu" || GPU="--gpu"
    fi
    q_ssh "$h" "cd '$d' && bash deploy/validate-image.sh --image '$tag:latest' --role '$ROLE' $GPU"
    ;;

  build)
    [ "${#HOSTS[@]}" -eq 1 ] || die "build needs exactly one --host"
    h="${HOSTS[0]}"; d="$(remote_repo "$h")"; [ -n "$d" ] || die "unknown host '$h'"
    # Destructive on a deploy-only host: build-images.sh promotes `:latest`, which
    # is the tag that host's stack recreates from. A production target takes
    # images that were built elsewhere — that is what `deploy` is for.
    q_guard_mutating qimg "$h" 1 build destructive
    quoted=""
    if [ "${#PASSTHRU[@]}" -gt 0 ]; then
      for tok in "${PASSTHRU[@]}"; do
        quoted="$quoted $(shquote "$tok")"
      done
    fi
    q_ssh "$h" "cd '$d' && bash deploy/build-images.sh$quoted"
    ;;

  deploy)
    [ "${#HOSTS[@]}" -eq 1 ] || die "deploy needs exactly one --host"
    h="${HOSTS[0]}"; d="$(remote_repo "$h")"; [ -n "$d" ] || die "unknown host '$h'"
    # Mutating, not destructive: deploying IS what a deploy-only host is for.
    # The guard's job here is only to stop it happening to a host nobody named —
    # and `deploy` already requires --host, so this is a floor, not a gate.
    q_guard_mutating qimg "$h" 1 deploy
    cmd="$(cfgval deploy "$h")"
    [ -n "$cmd" ] || die "no deploy command configured for host '$h' — add one to config.json rather than guessing"
    q_ssh "$h" "cd '$d' && $cmd"
    ;;

  repin)
    # scripts/_qimg_repin.sh (Task 6): snapshot -> build candidate (dated tag,
    # :latest never touched) -> snapshot -> diff. --role must be forwarded
    # explicitly -- PASSTHRU only ever holds the tokens this dispatcher's own
    # arg loop didn't recognize, and --role is consumed into $ROLE above like
    # every other verb, so it would otherwise be silently dropped here.
    #
    # FIX 9: on bash 3.2, "${PASSTHRU[@]:-}" expands to exactly ONE empty-
    # string argument when PASSTHRU is empty (unlike bash 4.4+, where an
    # empty array with `:-` still expands to zero words) -- that literal ""
    # then reaches build-images.sh as an unrecognized positional argument
    # and it exits 2, but only AFTER this verb has already spent a full
    # snapshot + build. Guard exactly like the `build` verb already does
    # above: only splat PASSTHRU when it actually has elements.
    if [ "${#PASSTHRU[@]}" -gt 0 ]; then
      bash "$SKILL_DIR/scripts/_qimg_repin.sh" --host "${HOSTS[0]:-}" ${ROLE:+--role "$ROLE"} "${PASSTHRU[@]}"
    else
      bash "$SKILL_DIR/scripts/_qimg_repin.sh" --host "${HOSTS[0]:-}" ${ROLE:+--role "$ROLE"}
    fi
    ;;

  *) die "unknown verb '$VERB' (try --help)" ;;
esac
