#!/usr/bin/env bash
# qdiag — a shim. The verb is `make session-diagnose`; the implementation is
# scripts/dx/session.sh + scripts/dx/session_diagnose/. Kept because muscle
# memory and older notes still say `qdiag latest`.
#
#   qdiag [<session-id>|latest] [--host ROLE|NAME] [--window <from_ms>,<to_ms>] [--json]
set -euo pipefail
ROOT="$(cd "$(dirname "$0")/../../../.." && pwd)"
SID="${1:-latest}"; shift || true
HOST=gpu-test; WINDOW=""; JSON=""
while [ $# -gt 0 ]; do case "$1" in
  --host)   HOST="$2"; shift 2 ;;
  --window) WINDOW="$2"; shift 2 ;;
  --json)   JSON=1; shift ;;
  --raw)    JSON=1; shift ;;
  *) echo "qdiag: unknown arg '$1' — see: make help | grep session-" >&2; exit 3 ;;
esac; done
exec make -C "$ROOT" session-diagnose SID="$SID" HOST="$HOST" WINDOW="$WINDOW" JSON="$JSON"
