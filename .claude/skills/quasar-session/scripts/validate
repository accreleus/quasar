#!/usr/bin/env bash
# validate — quasar-session self-test.
#
#   validate     # offline checks only; no host is contacted, no session is launched
#
# Two things are asserted here, both of which were unguarded until the skills
# security pass:
#   * the deploy-only contract (hosts.example.json) — a production stack takes
#     read-only verbs only;
#   * the credential-delivery rule — a bearer, dev key or signaling token
#     reaches a host on STDIN, never as an ssh command argument, because an
#     argument is the remote sshd child's command line and shows up in `ps`.
#
# Everything runs against _shared/fixtures/hosts.three-role.json (a synthetic
# fleet on RFC 5737 addresses) with `ssh` stubbed out.
set -euo pipefail

SKILL_DIR="$(cd "$(dirname "$0")/.." && pwd)"
QSES="$SKILL_DIR/scripts/qses"
FIXTURE="$SKILL_DIR/../_shared/fixtures/hosts.three-role.json"

PASSN=0; FAILN=0
pass() { echo "  PASS  $*"; PASSN=$((PASSN+1)); }
fail() { echo "  FAIL  $*" >&2; FAILN=$((FAILN+1)); }

echo "quasar-session self-test"

# 1. syntax + executability
[ -x "$QSES" ] && pass "qses is executable" || fail "qses is not executable"
bash -n "$QSES" && pass "qses is bash-syntax clean" || fail "qses has syntax errors"
bash -n "$0"    && pass "validate is bash-syntax clean" || fail "validate has syntax errors"

STUB_BIN="$(mktemp -d)"
printf '#!/usr/bin/env bash\nexit 255\n' > "$STUB_BIN/ssh"
chmod +x "$STUB_BIN/ssh"
trap 'rm -rf "$STUB_BIN"' EXIT
export PATH="$STUB_BIN:$PATH"
export QUASAR_HOSTS_JSON="$FIXTURE"

# 2. deploy-only contract.
#    `stop` and `matrix` are destructive — they end a live session on that stack
#    and nothing gives it back, so no flag confirms them even when the caller
#    named the host.
for v in stop matrix; do
  out="$("$QSES" --stack=deploy-only "$v" 00000000-0000-0000-0000-000000000000 2>&1 || true)"
  case "$out" in
    *"no destructive operations"*) pass "'$v' refused on a deploy-only stack, named or not" ;;
    *) fail "'$v' not refused on a deploy-only stack: $out" ;;
  esac
done

#    `run` is mutating: it takes an encode slot but the session can be stopped
#    again. It must refuse when the deploy-only stack was reached by DEFAULT...
out="$(QUASAR_DEFAULT_ROLE=gpu-test QSES_STACK_DEFAULTED=1 \
       env -u QSES_STACK_ROLE bash -c "
         export QUASAR_HOSTS_JSON='$FIXTURE'
         # rebind the gpu-test role to the deploy-only host so the DEFAULT stack
         # is the production one, with no flag naming it
         python3 - '$FIXTURE' > \"$STUB_BIN/hosts.json\" <<'PY'
import json, sys
c = json.load(open(sys.argv[1]))
c['roles']['gpu-test'] = c['roles']['deploy-only']
print(json.dumps(c))
PY
         QUASAR_HOSTS_JSON=\"$STUB_BIN/hosts.json\" '$QSES' run --no-browser 2>&1" || true)"
case "$out" in
  *"pass --host"*) pass "'run' on an unnamed deploy-only stack demands confirmation" ;;
  *) fail "'run' implicit guard missing on a deploy-only stack: $out" ;;
esac

# 3. read-only verbs stay available.
out="$("$QSES" --stack=deploy-only logs abr 2>&1 || true)"
case "$out" in
  *"deploy-only role"*) fail "'logs' (read-only) was refused on a deploy-only stack: $out" ;;
  *) pass "read-only 'logs' allowed on a deploy-only stack" ;;
esac

# 4. no credential is ever an ssh ARGUMENT.
#    QSES_RUN_COMPOSE_ONLY=1 prints the exact remote script `run` would send,
#    with a known-token stand-in for the dev key. The script must carry it (it
#    genuinely needs the key) AND the script must be delivered by a pipe — the
#    two facts together are what keeps it out of `ps`.
composed="$(QSES_RUN_COMPOSE_ONLY=1 "$QSES" --stack=gpu-test run \
  --app 'Fixture Bench' --secs 5 --warmup 1 2>/dev/null || true)"
if [ -z "$composed" ]; then
  fail "compose-only run produced no script to inspect"
else
  bash -n <<<"$composed" && pass "the composed remote script is bash-syntax clean" \
    || fail "the composed remote script has syntax errors"
fi
if grep -q 'printf .%s. "\$REMOTE_RUN" | peer_script' "$QSES"; then
  pass "'run' pipes its remote script instead of passing it as an ssh argument"
else
  fail "'run' still hands its DEV_KEY-bearing script to ssh as an argument"
fi

#    The `matrix` HOLD probe was the worst case: `env VAR=...` puts every
#    assignment into env's OWN argv, so SIG_TOKEN and AUTH_TOKEN were readable
#    in `ps` for the whole run. They must now be shell prefix assignments.
if grep -qE '^nohup env .*(SIG_TOKEN|AUTH_TOKEN)=' "$QSES"; then
  fail "the matrix HOLD probe still puts a token in env's argv"
else
  pass "the matrix HOLD probe keeps its tokens out of argv"
fi

#    And the admin bearer must not be echoed back from the host, because the
#    blob it lands in is printed to stderr on matrix's failure paths.
if grep -qE 'echo .ADMIN_TOKEN=|s/\^ADMIN_TOKEN=' "$QSES"; then
  fail "qses still moves the admin bearer through an ADMIN_TOKEN= line"
else
  pass "the admin bearer is never echoed back over the wire"
fi

# 5. admin_exec/stop deliver their auth snippet on stdin.
if grep -q 'ssh_script "\$STACK_HOST"' "$QSES"; then
  pass "admin-credentialed verbs deliver their snippet on stdin"
else
  fail "an admin-credentialed verb still splices its bearer into an ssh argument"
fi

echo ""
echo "quasar-session: $PASSN passed, $FAILN failed"
[ "$FAILN" -eq 0 ]
