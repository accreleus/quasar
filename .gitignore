# Rust / Cargo build artifacts
target/
# Local cargo registry cache used by the containerized dev build
.cargo-cache/

# macOS
.DS_Store

# Local env files with real secrets (deploy/.env etc.) — never commit them.
#
# The bare `.env` rule was too narrow: tooling writes VARIANTS of it. A subagent
# once left `deploy/.env.bak-f021b89d` on a host holding the DB password, the
# bootstrap admin password, the enrollment token and the credential-encryption
# key — none of which `.env` matches. So ignore the whole shape, then carve the
# tracked non-secrets back out.
.env
.env.*
*.env
# Carve-outs. These are tracked and must stay stageable — a negation only works
# because no rule above excludes a PARENT DIRECTORY of them.
#   *.env.example — the schema templates (deploy/.env.example)
#   pins.env      — deploy/pins.env, the third-party pin manifest, not a secret
!.env.example
!*.env.example
!pins.env

# oh-my-claudecode agent state
.omc/
control-plane/bin/

# Claude Code local state + superpowers skill install (node-based).
# Ignore everything under .claude/ EXCEPT checked-in, repo-shared skills, which
# are durable agent context like CLAUDE.md and travel with the repo.
.claude/*
!.claude/skills/
!.claude/rules/
# OPERATOR CONFIG — real host addresses, ssh aliases and key paths. NEVER committed.
# Every skill reads it locally; hosts.example.json is the tracked schema template.
.claude/skills/_shared/hosts.json

# Repo-scoped MCP wiring is operator-local tooling (endpoints on the operator's
# own network), not a property of the project. Keep it working, don't publish it.
/.mcp.json
node_modules/
# Anchored to repo root so they don't also ignore web/package.json etc.
/package.json
/package-lock.json

# Agent/tool artifacts (Playwright MCP logs, understand-anything cache)
.playwright-mcp/
.understand-anything/

# P4-07 troubleshooting harness results (generated on hermes, not committed)
deploy/results/

# make validate — Playwright's downloaded chromium cache (scripts/validate/package.json
# deps are node_modules/, already covered above)
scripts/validate/.cache/

# Generated knowledge-graph output (graphify): track the durable graph artifacts
# (graph.json/.html, GRAPH_REPORT.md, community labels) so agents have the map
# without a local rebuild, but ignore machine-specific + transient state:
#   .graphify_python/.graphify_root — absolute paths to this machine's interpreter/repo
#   manifest.json                   — absolute-path keyed; only valid for --update on this machine
#   cache/                          — regenerable semantic/AST extraction cache (bulky, churny)
#   cost.json                       — per-machine cumulative token tally
graphify-out/.graphify_python
graphify-out/.graphify_root
graphify-out/manifest.json
graphify-out/cost.json
graphify-out/cache/
# .graphify_chunk_files_*.txt — per-machine absolute-path chunk lists; regenerated by graphify
graphify-out/.graphify_chunk_files_*.txt
.serena/

# /ship-milestone: local completion report (review artifact; screenshots under ui-evidence/<KEY>/ stay committable)
ui-evidence/*-report.html

# local AI-tool skill mirrors (caveman skill-sync artifacts)
.agents/
.forge/
.roo/
skills-lock.json
__pycache__/
qdiag-runs/

# apitest builds via `go run` (scripts/harness/run-apitest.sh); never commit the binary
scripts/harness/apitest/quasar-apitest
scripts/harness/apitest/results.json

# build-images.sh writes a per-run build report (image ids, resolved pins, verdicts)
deploy/.build-report.json
.build-tmp/

# Local diagnostic bundles (make diagnose-bundle) — redacted but still local-only
.diagnostics/

# scripts/dx/uiaudit.sh evidence dirs (screenshots + metrics + reports) —
# local-only, never committed (reports are shared by attaching the generated
# self-contained HTML, not by committing the evidence tree)
.uiaudit/

# Agent worktrees. Untracked by convention until now; an unscoped `git add -A`
# in the superproject would otherwise stage a whole nested checkout.
.claude/worktrees/
