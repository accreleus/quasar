+// A deep link into the console starts its layout and its section's landing page with
+// the entry, so the route renders without a fallback once they are in. Drill-down
+// pages (a host, an app) load as before.
+const ADMIN_SECTION_PAGES: Record<string, (keyof typeof adminPages)[]> = {
+  "": ["Overview"],
+  settings: ["Settings"],
+  sessions: ["Sessions"],
+  audit: ["Audit"],
+  fleet: ["Fleet", "Hosts"],
+  library: ["Library", "Apps"],
+  streaming: ["Streaming", "LaunchProfiles"],
+  people: ["People", "Users"],
 };
+if (typeof location !== "undefined" && /^\/admin(\/|$)/.test(location.pathname)) {
+  adminPages.Layout.preload();
+  for (const page of ADMIN_SECTION_PAGES[location.pathname.split("/")[2] ?? ""] ?? []) adminPages[page].preload();
+}
