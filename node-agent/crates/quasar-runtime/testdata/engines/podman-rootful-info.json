  },
  "crun-wasm": {
   "path": "/usr/bin/crun-wasm"
  },
  "kata": {
   "path": "/usr/bin/kata-runtime"
  },
  "krun": {
   "path": "/usr/bin/krun"
  },
  "ocijail": {
   "path": "/usr/local/bin/ocijail"
  },
  "runc": {
   "path": "/usr/bin/runc"
  },
  "runj": {
   "path": "/usr/local/bin/runj"
  },
  "runsc": {
   "path": "/usr/bin/runsc"
  },
  "youki": {
   "path": "/usr/local/bin/youki"
  }
 },
 "SecurityOptions": [
  "name=seccomp,profile=default",
  "name=selinux"
