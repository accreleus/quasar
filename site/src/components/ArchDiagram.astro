---
interface Props { caption?: string; }
const { caption } = Astro.props;
const icons = {
 browser: 'M3 4h18v13H3z M8 21h8 M12 17v4 M3 8h18',
 server: 'M4 3h16v7H4z M4 14h16v7H4z M7 6h.01 M7 17h.01 M11 6h6 M11 17h6',
 game: 'M7 7h10c3 0 5 10 3 12-2 2-5-3-6-3h-4c-1 0-4 5-6 3C2 17 4 7 7 7z M6 11h4 M8 9v4 M16 11h.01 M18 13h.01',
};
---
<figure class="q-arch" data-architecture>
 <div class="q-arch-frame">
  <div class="q-map-heading"><small>QUASAR / CONNECTIONS</small><strong>One host. Two paths.</strong></div>
  <svg class="q-map" viewBox="0 0 740 475" role="img" aria-labelledby="q-map-title q-map-desc">
   <title id="q-map-title">Quasar all-in-one architecture</title><desc id="q-map-desc">The browser uses HTTPS to communicate with the control plane, which manages sessions on the GPU host. WebRTC video, audio and input connect the browser directly to the GPU host over LAN or VPN.</desc>
   <defs><marker id="q-arrow" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="5" markerHeight="5" orient="auto-start-reverse"><path d="M1 1 9 5 1 9" fill="context-stroke"/></marker></defs>
   <rect class="q-boundary" x="412" y="38" width="306" height="408" rx="20"/>
   <text class="q-group" x="438" y="66">YOUR SERVER</text><text class="q-note" x="438" y="85">All-in-one install</text>
   <g class="q-route"><path d="M280 158 H440" marker-start="url(#q-arrow)" marker-end="url(#q-arrow)"/><text x="360" y="125">HTTPS</text><text class="q-note" x="360" y="144">Web app &amp; API</text></g>
   <g class="q-route"><path d="M560 216 V300" marker-end="url(#q-arrow)"/><text x="633" y="256">Session</text><text x="633" y="274">management</text></g>
   <g class="q-route q-media" data-part="stream"><path d="M160 216 V358 H440" marker-start="url(#q-arrow)" marker-end="url(#q-arrow)"/><text x="288" y="320">Direct WebRTC</text><text class="q-note" x="288" y="341">Video · audio · input</text><text class="q-note" x="288" y="385">Over your LAN or VPN</text></g>
   {[
    {id:'browser',x:40,y:100,icon:icons.browser,title:'Your browser',note:'Browse your library · press Play'},
    {id:'control',x:440,y:100,icon:icons.server,title:'Control plane',note:'Accounts, library & host selection'},
    {id:'host',x:440,y:300,icon:icons.game,title:'GPU host',note:'Node agent · game & stream'},
   ].map(n => <g class="q-node" data-part={n.id} transform={`translate(${n.x} ${n.y})`}>
    <rect width="240" height="116" rx="14"/><rect class="q-icon-tile" x="18" y="18" width="38" height="38" rx="10"/>
    <svg x="25" y="25" width="24" height="24" viewBox="0 0 24 24" aria-hidden="true"><path d={n.icon}/></svg>
    <text class="q-node-title" x="18" y="79">{n.title}</text><text class="q-note" x="18" y="99">{n.note}</text>
   </g>)}
  </svg>
  <div class="q-mobile-map"><strong data-part="browser">Your browser</strong><span>↕ HTTPS · web app &amp; API</span><div><small>YOUR SERVER / ALL-IN-ONE</small><strong data-part="control">Control plane</strong><span>↓ Session management</span><strong data-part="host">GPU host</strong></div><p data-part="stream">Browser ↔ GPU host<br/><b>Direct WebRTC</b> · video, audio &amp; input<br/>Over your LAN or VPN</p></div>
  <div class="q-arch-demo">
   <button type="button" data-play-sequence>Explore pressing Play →</button>
   <p aria-live="polite" data-sequence-text>Follow the request, then the direct stream.</p>
  </div>
 </div>
 {caption && <figcaption>{caption}</figcaption>}
</figure>
<script>
 for (const figure of document.querySelectorAll('[data-architecture]')) {
  const sequence = [
   ['browser', '1. You press Play in your browser.'],
   ['control', '2. The control plane selects an available GPU host.'],
   ['host', '3. The node agent starts your game on that host.'],
   ['stream', '4. Video, audio and input connect directly between browser and GPU host.'],
  ];
  let index = 0;
  const button = figure.querySelector('[data-play-sequence]');
  button?.addEventListener('click', () => {
   figure.querySelectorAll('[data-part]').forEach(part => part.classList.remove('selected'));
   const [part, text] = sequence[index];
   figure.querySelectorAll(`[data-part="${part}"]`).forEach(el => el.classList.add('selected'));
   figure.querySelector('[data-sequence-text]').textContent = text;
   index = (index + 1) % sequence.length;
   button.textContent = index === 0 ? 'Play again' : 'Next step';
  });
 }
</script>
<style>
.q-arch {margin:1.5rem 0}.q-arch-frame {border:1px solid var(--q-line-2);border-radius:20px;overflow:hidden;background:var(--q-ink-2)}.q-map-heading {padding:1.4rem 1.6rem 0;display:flex;flex-direction:column;gap:.3rem}.q-map-heading strong {font-size:1.35rem;color:var(--q-text);font-weight:600}.q-map-heading small {font-size:.65rem;letter-spacing:.14em;color:var(--q-text-3)}
.q-map {display:block;width:100%;height:auto;font-family:inherit}.q-boundary {fill:var(--q-accent-soft);stroke:var(--q-line-2);stroke-dasharray:5 5}.q-group {fill:var(--q-text-2);font-size:11px;font-weight:600;letter-spacing:1.5px}.q-note {fill:var(--q-text-2);font-size:12px;font-weight:400}
.q-node>rect:first-child {fill:var(--q-ink-3);stroke:var(--q-line-3)}.q-icon-tile {fill:var(--q-accent-soft)}.q-node svg {fill:none;stroke:var(--q-accent-text);stroke-width:1.5;stroke-linecap:round;stroke-linejoin:round}.q-node-title {fill:var(--q-text);font-size:18px;font-weight:600}
.q-route {color:var(--q-text-3);fill:var(--q-text-2)}.q-route path {fill:none;stroke:currentColor;stroke-width:1.6;stroke-linejoin:round}.q-route text {text-anchor:middle;font-size:13px;font-weight:600}.q-route .q-note {font-size:11px;font-weight:400}.q-media {color:var(--q-accent-text);fill:var(--q-accent-text)}.q-media path {stroke-width:2.5}.q-node.selected>rect:first-child {stroke:var(--q-accent-text);stroke-width:3}.q-media.selected path {stroke-width:5}
.q-arch-demo {display:flex;align-items:center;gap:1rem;border-top:1px solid var(--q-line-2);padding:1rem 1.5rem;background:var(--q-ink-3)}.q-arch-demo button {flex-shrink:0;min-height:44px;padding:.5rem .8rem;font:inherit;font-size:.85rem;color:var(--q-text);background:var(--q-accent-soft);border:1px solid var(--q-line-2);border-radius:8px;cursor:pointer}.q-arch-demo button:focus-visible {outline:2px solid var(--q-accent-text);outline-offset:3px}.q-arch-demo p,figcaption {font-size:.85rem;color:var(--q-text-2)}.q-arch-demo p {margin:0;line-height:1.5}.q-mobile-map {display:none}
@media(max-width:600px){.q-map{display:none}.q-mobile-map{display:flex;flex-direction:column;text-align:center;padding:1.5rem;gap:1rem;color:var(--q-text-2);font-size:.85rem}.q-mobile-map strong{display:block;padding:1rem;border:1px solid var(--q-line-3);border-radius:10px;background:var(--q-ink-3);color:var(--q-text)}.q-mobile-map div{display:flex;flex-direction:column;gap:1rem;padding:1rem;background:var(--q-accent-soft);border:1px dashed var(--q-line-3);border-radius:14px}.q-mobile-map .selected{outline:2px solid var(--q-accent-text);outline-offset:2px}.q-mobile-map small{font-size:.65rem;letter-spacing:.1em}.q-mobile-map p{padding:1rem;border-left:3px solid var(--q-accent-text);background:var(--q-accent-soft);line-height:1.8;margin:0}.q-arch-demo{flex-direction:column;align-items:flex-start}}
@media(prefers-reduced-motion:reduce){.q-arch *{animation:none!important;transition:none!important}}
</style>
