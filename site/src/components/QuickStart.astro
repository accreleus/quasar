---
/**
 * The quick start wizard.
 *
 * Six steps, one output: the seed for one machine (src/data/stack-template.js).
 * Everything happens in the browser. No fetch, no analytics, no secret: the
 * recovery actor generates every secret on the machine, and the operator's own
 * database password never passes through this page.
 *
 * Step 2, Engine (RH07-14, #406), asks which container engine runs Quasar,
 * rootful: a rootless install starts by preparing a `quasar` account, which the
 * docs write out step by step (install/rootless), so the wizard points there
 * rather than offering it. The badges are server-rendered here (Starlight's own <Badge>,
 * so its CSS ships) for the wizard's default platform; the client script
 * (below) recomputes them from `engine-profiles.js` — the same table the
 * node agent's `runtime_engine` check and the enrollment script read — every
 * time the platform or engine choice changes.
 *
 * Design: existing --q-* tokens and qs-* classes from this component only,
 * plus Starlight's <Badge> unmodified (theme.css maps its success/caution/
 * danger variants onto the product's --success/--warning/--danger tokens).
 */
import { Badge } from '@astrojs/starlight/components';
import { DEFAULTS } from '../data/stack-template.js';
import { profileFor } from '../data/engine-profiles.js';

// Nothing is preselected (D3). Rootless is not offered here: see the header.
const ENGINE_OPTIONS = [
	{ engine: 'docker', mode: 'rootful', label: 'Docker, rootful', hint: 'Docker Engine, running as root.' },
	{ engine: 'podman', mode: 'rootful', label: 'Podman, rootful', hint: 'Podman, running as root, with a Quadlet unit.' },
];
const BADGE_VARIANT = { supported: 'success', experimental: 'caution', unsupported: 'danger' };
const BADGE_TEXT = { supported: 'Supported', experimental: 'Experimental', unsupported: 'Unsupported' };
// Links follow the build's base: the edge docs live under /quasar/edge/.
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<div class="qs" data-quickstart>
	<ol class="qs-progress" aria-label="Progress">
		<li data-dot="1" class="on">Host</li>
		<li data-dot="2">Engine</li>
		<li data-dot="3">GPU</li>
		<li data-dot="4">Storage</li>
		<li data-dot="5">Access</li>
		<li data-dot="6">Result</li>
	</ol>

	<!-- 1. Platform -->
	<section data-step="1" class="qs-step on">
		<h2>Where are you deploying Quasar?</h2>
		<p class="qs-hint">
			This sets sensible defaults later, and decides which container
			engines are supported here.
		</p>
		<div class="qs-choices">
			<label><input type="radio" name="platform" value="fedora" checked /><span><strong>Fedora</strong><em>What the install is verified on. Includes Silverblue, Bazzite and uCore</em></span></label>
			<label><input type="radio" name="platform" value="ubuntu" /><span><strong>Ubuntu 24.04</strong></span></label>
			<label><input type="radio" name="platform" value="debian" /><span><strong>Debian</strong></span></label>
			<label><input type="radio" name="platform" value="arch" /><span><strong>Arch</strong></span></label>
			<label><input type="radio" name="platform" value="unraid" /><span><strong>Unraid</strong><em>Different paths, different persistence</em></span></label>
			<label><input type="radio" name="platform" value="other" /><span><strong>Another systemd Linux</strong></span></label>
		</div>
		<p class="qs-note" data-platform-note></p>
	</section>

	<!-- 2. Engine (RH07-14, #406) -->
	<section data-step="2" class="qs-step">
		<h2>Which container engine will run Quasar?</h2>
		<p class="qs-hint">
			This wizard installs Quasar on Docker or Podman running as root
			(rootful). Not sure what this machine has? Run this on it:
		</p>
		<pre><code>for e in docker podman; do command -v $e &gt;/dev/null &amp;&amp; $e --version; done</code></pre>
		<div class="qs-choices" data-engine-choices>
			{ENGINE_OPTIONS.map(({ engine, mode, label, hint }) => {
				const p = profileFor(DEFAULTS.platform, engine, mode);
				return (
					<label>
						<input type="radio" name="engine" value={`${engine}:${mode}`} />
						<span><strong>{label}</strong><em>{hint}</em></span>
						<span class="qs-badge" data-badge>
							<Badge size="small" variant={BADGE_VARIANT[p.status]} text={BADGE_TEXT[p.status]} />
						</span>
					</label>
				);
			})}
		</div>
		<p class="qs-note" data-engine-note></p>
		<p class="qs-note">
			Want Quasar to run as an ordinary account instead of root? That is
			a rootless install: follow <a href={`${base}/install/rootless/`}>Rootless</a>.
		</p>
	</section>

	<section data-step="3" class="qs-step">
  <h2>Which GPU will run your games?</h2>
  <div class="qs-choices">
   <label><input type="radio" name="gpu" value="other" checked /><span><strong>AMD or Intel</strong><em>Use the Linux graphics driver. Intel remains untested.</em></span></label>
   <label><input type="radio" name="gpu" value="nvidia" /><span><strong>NVIDIA</strong><em>Full graphics driver and NVIDIA Container Toolkit required.</em></span></label>
  </div>
  <div data-nvidia-prep hidden>
   <p class="qs-note">Complete <a href={`${base}/install/nvidia/`}>NVIDIA setup</a> for your engine and platform before deploying. It covers the full graphics driver, Container Toolkit and compatibility checks. The engine-specific commands below follow that setup.</p>
   <pre><code data-out="gpu-prep"></code></pre>
  </div>
  <p class="qs-note">This quick start installs everything on one server. Add more machines later with the instance's <a href={`${base}/install/second-host/`}>Add GPU host command</a>.</p>
 </section>

	<!-- 4. Storage -->
	<section data-step="4" class="qs-step">
		<h2>Where should Quasar keep things?</h2>
		<div data-when-agent>
			<p class="qs-hint">
				Homes hold installed games, saves, settings and user files. Leave room for
				the games you plan to install, in addition to about 20 GB for container images.
			</p>
			<label class="qs-field">
				<span>Base path</span>
				<input type="text" name="basePath" value="/var/lib/quasar" spellcheck="false" />
			</label>
			<label class="qs-check">
				<input type="checkbox" name="separateSaves" />
				<span>Keep user homes on a different disk</span>
			</label>
			<label class="qs-field" data-when-saves>
				<span>Path for user homes</span>
				<input type="text" name="savesPath" placeholder="/mnt/tank/quasar" spellcheck="false" />
			</label>
		</div>
		<p class="qs-note" data-when-role="control-only">
			A control-only machine keeps no user homes: they live on the GPU hosts.
			Its database, certificate and machine state are Docker-managed volumes.
		</p>

		<details class="qs-adv"><summary>Directory and volume reference</summary><figure class="qs-tree">
			<figcaption>What you end up with</figcaption>
			<pre data-tree></pre>
		</figure></details>
		<details class="qs-adv"><summary>Advanced permissions</summary>
		<h3>Game-file ownership</h3>
		<div data-when-agent>
			<p class="qs-hint">
				Game containers drop to this user, so it decides who can read the saves
				from outside Quasar. It does not change what Quasar's own services run as.
			</p>
			<div class="qs-choices">
				<label><input type="radio" name="owner" value="dedicated" checked /><span><strong>Quasar defaults (not detected from your host)</strong><em data-owner-default>uid 1000</em></span></label>
				<label><input type="radio" name="owner" value="custom" /><span><strong>A specific uid and gid</strong><em>If your files need to belong to an existing account</em></span></label>
			</div>
			<div class="qs-row" data-when-owner="custom">
				<label class="qs-field"><span>uid</span><input type="number" name="uid" value="1000" min="0" /></label>
				<label class="qs-field"><span>gid</span><input type="number" name="gid" value="1000" min="0" /></label>
			</div>
		</div>
		<p class="qs-note" data-when-role="control-only">Nothing to choose: a control-only machine runs no games.</p>
		</details>
	</section>

	<!-- 5. Access -->
	<section data-step="5" class="qs-step">
		<h2>How will you reach Quasar?</h2>
		<div data-when-control>
			<p class="qs-hint">
				Quasar needs HTTPS. Gamepads, Escape capture and the microphone all need
				a secure context. The control plane makes its own certificate.
			</p>
			<label class="qs-field qs-required">
				<span>The name or LAN address you will type into the browser</span>
				<input type="text" name="publicHost" placeholder="192.168.1.50" spellcheck="false" />
			</label>
   <p class="qs-note">For example, open <code>https://192.168.1.50:8443</code>. Quasar makes a certificate for this address; follow <a href={`${base}/network/https/`}>HTTPS setup</a> to trust it. Your client also needs a direct LAN or VPN route to the GPU host.</p>
   <p class="qs-note">The default is direct access with Quasar's managed database. For a reverse proxy, extra certificate names or external Postgres, follow <a href={`${base}/install/docker/`}>advanced installation</a>.</p>
		</div>
		<p class="qs-note" data-when-role="gpu">
			Nothing to choose: a GPU host reaches its control plane through the
			enrollment string.
		</p>
	</section>

	<!-- 7. Result -->
	<section data-step="6" class="qs-step">
		<h2>Your install</h2>
		<dl class="qs-summary">
			<div class="qs-sum-row"><dt>Host</dt><dd data-sum="platform"></dd></div>
			<div class="qs-sum-row" data-sum-row="engine"><dt>Engine</dt><dd data-sum="engine"></dd></div>
			<div class="qs-sum-row"><dt>Role</dt><dd data-sum="role"></dd></div>
			<div class="qs-sum-row" data-sum-row="homes"><dt>User homes</dt><dd data-sum="homes"></dd></div>
			<div class="qs-sum-row" data-sum-row="owner"><dt>Owned by</dt><dd data-sum="owner"></dd></div>
			<div class="qs-sum-row" data-sum-row="public"><dt>Console</dt><dd data-sum="public"></dd></div>
			<div class="qs-sum-row" data-sum-row="database"><dt>Database</dt><dd data-sum="database"></dd></div>
		</dl>

		<details class="qs-adv" data-when-control>
			<summary>Change the ports</summary>
			<div class="qs-row">
				<label class="qs-field"><span>HTTP</span><input type="number" name="controlPort" value="8080" min="1" max="65535" /></label>
				<label class="qs-field"><span>HTTPS</span><input type="number" name="tlsPort" value="8443" min="1" max="65535" /></label>
			</div>
		</details>

		<p class="qs-note qs-warn" data-out-block="unavailable" hidden>
			Choose a supported or experimental engine in step 2 to see install commands.
		</p>

		<!-- 1. Host steps: visible commands, never a downloaded script -->
		<div class="qs-out" data-out-block="host">
			<div class="qs-out-head">
				<h3>1. Prepare the machine, once</h3>
				<button type="button" data-copy="host">Copy</button>
			</div>
			<p class="qs-hint" data-host-hint></p>

			<pre><code data-out="host"></code></pre>
			<p class="qs-note">
				Console mode (games on this machine's own screen) needs more device
				access: see <a href={`${base}/install/device-rules/`}>Device rules</a>.
				For smoother streams, also set the{' '}
				<a href={`${base}/tuning/latency/#the-udp-send-buffer`}>UDP send buffer</a>.
			</p>
		</div>

		<!-- Podman: the Quadlet unit the script above writes, for reference (owner decision 3) -->
		<div class="qs-out" data-out-block="quadlet">
			<div class="qs-out-head">
				<h4>Podman Quadlet configuration</h4>
				<button type="button" data-copy="quadlet">Copy</button><button type="button" data-download="quadlet">Download</button>
			</div>
			<p class="qs-note qs-warn">Local preview for #440 at <code>5c5f2d94</code>: these <code>:latest</code> inputs require images containing that fix. Publication of compatible images is not verified here. The seed resolves tags internally; no manual substitution is needed. Podman uses Quadlet.</p><pre class="qs-pre-full"><code data-out="quadlet"></code></pre>

			<p class="qs-note">
				The seed creates Quasar's recovery actor, which generates every secret
				and creates the rest. Nothing here writes a Compose file or an .env.
			</p>
		</div>

		<!-- Docker (and Unraid): the Dockge/Arcane stack. Not Podman (D15): the Quadlet unit is its equivalent. -->
		<div class="qs-out" data-out-block="stack">
			<div class="qs-out-head">
				<h3 data-stack-title>Docker Compose configuration</h3>
				<button type="button" data-copy="stack">Copy</button><button type="button" data-download="stack">Download</button>
			</div>
   <p class="qs-note qs-warn" role="status">Local preview for <a href="https://github.com/accreleus/quasar/commit/5c5f2d94e9fa3c858bf33db25ffbc7516c451589">#440's bootstrap fix</a>. These <code>:latest</code> inputs require images containing that fix. Publication of compatible images is not verified here; do not deploy against older images.</p>
   <p class="qs-hint">Save this as <code>compose.yaml</code>, or paste it into Docker Compose, Dockge or Arcane. A compatible seed resolves the tags to immutable digests internally on first install. No manual substitution is needed.</p>
			<pre><code data-out="stack"></code></pre>
			<div data-out-block="env" hidden>
				<div class="qs-out-head"><h4>The stack's .env</h4><button type="button" data-copy="env">Copy</button></div>
				<pre><code data-out="env"></code></pre>
			</div>
		</div>

		<div class="qs-out" data-out-block="proxy" hidden>
			<div class="qs-out-head">
				<h3>Add to your <span data-out="proxyName"></span> config</h3>
				<button type="button" data-copy="proxy">Copy</button>
			</div>
			<p class="qs-hint">
				Goes in <code data-out="proxyFile"></code>. This adds Quasar to a proxy
				you already run; it does not stand one up.
			</p>
			<pre><code data-out="proxy"></code></pre>
		</div>

  <div class="qs-out">
   <h3>Before starting</h3>
   <p>Create the homes and templates directories with the chosen ownership. Do not change ownership of existing user data recursively.</p>
   <pre><code data-out="directories"></code></pre>
   <p>With images containing the bootstrap fix, Docker users can save <code>compose.yaml</code> and run <code>docker compose up -d</code>, or use their stack manager. Podman users should save <code>quasar-seed.container</code> in <code>/etc/containers/systemd/</code>, then follow the <a href={`${base}/install/podman/`}>Quadlet start steps</a>.</p>
   <p>Existing installation? Keep its homes, database and machine state. Follow <a href={`${base}/operations/upgrading/`}>Upgrading</a> before redeploying.</p>
  </div>
		<p class="qs-hint">
			Then open Quasar and continue with{' '}
			<a href={`${base}/install/first-run/`}>Create your account</a>. Prefer to read
			the whole thing instead? <a href={`${base}/install/docker/`}>Docker</a>,{' '}
			<a href={`${base}/install/podman/`}>Podman</a> and{' '}
			<a href={`${base}/install/unraid/`}>Unraid</a> cover the same ground as prose.
		</p>
	</section>

	<p class="qs-note qs-warn" data-validation hidden role="status"></p>
	<nav class="qs-nav">
		<button type="button" data-back disabled>Back</button>
		<span class="qs-count"><span data-current>1</span> of 6</span>
		<button type="button" data-next>Next</button>
	</nav>
</div>

<script>
	import { DEFAULTS, generate, homePath, templatePath, role, appUser } from '../data/stack-template.js';
	import { platform } from '../data/platforms.js';
	import { profileFor } from '../data/engine-profiles.js';

	// The build's base (the edge docs live under /quasar/edge/).
	const profilesHref = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/start/requirements/#container-engines`;

	// Kept in step with the frontmatter's own copy above (no default engine, D3).
	const ENGINE_OPTIONS = [
		{ engine: 'docker', mode: 'rootful', label: 'Docker, rootful' },
		{ engine: 'podman', mode: 'rootful', label: 'Podman, rootful' },
	];
	const BADGE_VARIANT = { supported: 'success', experimental: 'caution', unsupported: 'danger' };
	const BADGE_TEXT = { supported: 'Supported', experimental: 'Experimental', unsupported: 'Unsupported' };
	const badgeHtml = (status) => `<span class="sl-badge small ${BADGE_VARIANT[status]}">${BADGE_TEXT[status]}</span>`;
	const engineLabel = (engine, mode) => ENGINE_OPTIONS.find((o) => o.engine === engine && o.mode === mode)?.label ?? `${engine}, ${mode}`;

	for (const root of document.querySelectorAll('[data-quickstart]')) {
		const answers = { ...DEFAULTS, engine: 'docker', mode: 'rootful' }; // no default engine yet (D3)
		let step = 1;
		const LAST = 6;
		const ACCESS_STEP = 5;
		// Only overwrite a path or uid the reader has not typed into themselves.
		const touched = new Set();

		const $ = (sel) => root.querySelector(sel);
		const $$ = (sel) => Array.from(root.querySelectorAll(sel));
		const field = (name) => root.querySelector(`[name="${name}"]`);
		const checked = (name, fallback) => root.querySelector(`[name="${name}"]:checked`)?.value ?? fallback;

		/** Read every control into the answers object. */
		function collect() {
			const val = (n) => field(n)?.value?.trim() ?? '';
			answers.platform = checked('platform', 'fedora');
            if (!touched.has('engine')) {
                const preferred = answers.platform === 'fedora' ? 'podman:rootful' : 'docker:rootful';
                root.querySelector(`[name="engine"][value="${preferred}"]`).checked = true;
            }
			const engineMode = checked('engine', '');
			[answers.engine, answers.mode] = engineMode ? engineMode.split(':') : ['', ''];
			answers.role = checked('role', 'combined');
			answers.owner = checked('owner', 'dedicated');
			answers.access = checked('access', 'self-signed');
			answers.database = checked('database', 'owned');
			answers.basePath = val('basePath') || platform(answers.platform).defaultBasePath;
			answers.separateSaves = field('separateSaves')?.checked ?? false;
			answers.savesPath = val('savesPath');
			answers.uid = Number(val('uid') || platform(answers.platform).defaultUid);
			answers.gid = Number(val('gid') || platform(answers.platform).defaultGid);
			answers.nvidia = checked('gpu', 'other') === 'nvidia';
			answers.publicHost = val('publicHost');
			answers.tlsHosts = val('tlsHosts');
			answers.proxy = val('proxy') || 'caddy';
			answers.publicUrl = val('publicUrl');
			answers.trustedProxies = val('trustedProxies');
			answers.dbHost = val('dbHost');
			answers.dbPort = Number(val('dbPort') || 5432);
			answers.dbUser = val('dbUser') || 'quasar';
			answers.dbName = val('dbName') || 'quasar';
			answers.dbSslmode = val('dbSslmode') || 'require';
			answers.controlPort = Number(val('controlPort') || 8080);
			answers.tlsPort = Number(val('tlsPort') || 8443);
		}

		/**
		 * Move the defaults to match the platform, unless the reader has typed
		 * their own value into that field. Unraid wants /mnt/user/appdata and
		 * uid 99, and guessing wrong there is worse than not guessing at all.
		 */
		function applyPlatformDefaults() {
			const p = platform(answers.platform);
			if (!touched.has('basePath')) field('basePath').value = p.defaultBasePath;
			if (!touched.has('uid')) field('uid').value = String(p.defaultUid);
			if (!touched.has('gid')) field('gid').value = String(p.defaultGid);
			const note = $('[data-platform-note]');
			note.textContent = p.note;
			note.hidden = !p.note;
			$('[data-owner-default]').textContent = p.ownerLabel;
		}

		/** The engine badges, and the note below them, for the current platform/choice. */
		function updateEngineStep() {
			$$('[data-engine-choices] label').forEach((label, i) => {
				const { engine, mode } = ENGINE_OPTIONS[i];
				const status = profileFor(answers.platform, engine, mode).status;
				const badge = label.querySelector('.sl-badge');
				if (badge) {
					badge.className = `sl-badge small ${BADGE_VARIANT[status]}`;
					badge.textContent = BADGE_TEXT[status];
				}
			});

			const note = $('[data-engine-note]');
			note.classList.remove('qs-warn');
			if (!answers.engine || !answers.mode) {
				note.innerHTML =
					'On a rootful engine, whoever controls the engine’s socket controls the machine, and Quasar holds that socket. <a href="' + profilesHref + '">Container engines</a> lists what each choice is tested on.';
				return;
			}
            const p = profileFor(answers.platform, answers.engine, answers.mode);
            note.classList.toggle('qs-warn', p.status !== 'supported');
            note.innerHTML = `${badgeHtml(p.status)} ${p.status === 'experimental' ? 'Tested on Fedora uCore and Workstation; full release validation is incomplete.' : p.status === 'unsupported' ? 'Choose a supported engine for this platform.' : 'Validated engine mode.'} <a href="${profilesHref}">Container engines and test evidence</a>`;
		}

		/** A picture of what lands where. */
		function tree() {
			const r = role(answers.role);
			const row = (path, comment) => (comment ? `${path.padEnd(26)}${comment}` : path);
			const lines = [];
			if (r.agent) {
				lines.push(
					`${homePath(answers)}/`,
					row('  alice/', 'one directory per user'),
					row('    steam/', 'library, saves and settings'),
					row('  bob/', ''),
					'',
					`${templatePath(answers)}/`,
					row('  …', 'prepared application homes'),
					'',
				);
			}
			lines.push('Docker-managed volumes:', row('  quasar-machine', 'machine state: never delete it'));
			if (r.control) {
				lines.push(
					row('  quasar-control-data', 'certificate and artwork cache'),
					...(answers.database === 'owned' ? [row('  quasar-postgres-data', 'accounts and configuration')] : []),
				);
			}
			if (r.agent) lines.push(row('  quasar-agent-data', "the agent's identity"));
			$('[data-tree]').textContent = lines.join('\n');
		}

		/** Show and hide the conditional blocks. */
		function reveal() {
			const r = role(answers.role);
			$$('[data-when-role]').forEach((el) => (el.hidden = el.dataset.whenRole !== answers.role));
			$$('[data-when-agent]').forEach((el) => (el.hidden = !r.agent));
			$$('[data-when-control]').forEach((el) => (el.hidden = !r.control));
			$$('[data-when-owner]').forEach((el) => (el.hidden = el.dataset.whenOwner !== answers.owner));
			$$('[data-when-access]').forEach((el) => (el.hidden = el.dataset.whenAccess !== answers.access));
			$$('[data-when-database]').forEach((el) => (el.hidden = el.dataset.whenDatabase !== answers.database));
			const saves = $('[data-when-saves]');
			if (saves) saves.hidden = !answers.separateSaves;
		}

		/** Step 2 is complete once a supported or experimental engine profile is chosen (D-d). */
		function engineChosenAndAllowed() {
			return Boolean(answers.engine && answers.mode) && profileFor(answers.platform, answers.engine, answers.mode).status !== 'unsupported';
		}

		/** The access step needs the console's name before Next; the engine step needs a non-blocked choice. */
		function stepComplete(n) {
			if (n === 2) return engineChosenAndAllowed();
            if (n === 4) return answers.basePath.startsWith('/') && (!answers.separateSaves || answers.savesPath.startsWith('/')) && [answers.uid, answers.gid].every(x => Number.isInteger(x) && x >= 0);
            if (n === ACCESS_STEP && /[\s/]/.test(answers.publicHost)) return false;
			if (n !== ACCESS_STEP || !role(answers.role).control) return true;
			if (!answers.publicHost) return false;
			if (answers.access === 'proxy' && !answers.publicUrl) return false;
			if (answers.database === 'external' && !answers.dbHost) return false;
			return true;
		}

		function summary() {
			const r = role(answers.role);
			const set = (k, v) => ($(`[data-sum="${k}"]`).textContent = v);
			set('platform', platform(answers.platform).label);
			set('role', r.label);
			set('homes', homePath(answers));
			const owner = appUser(answers);
            set('owner', `uid ${owner.uid}, gid ${owner.gid}`);
			const port = Number(answers.tlsPort);
			set(
				'public',
				answers.access === 'proxy' && answers.publicUrl ? answers.publicUrl : `https://${answers.publicHost}${port === 443 ? '' : `:${port}`}`,
			);
			set('database', answers.database === 'external' ? `Your own, at ${answers.dbHost}` : "Quasar's own");
			$('[data-sum-row="homes"]').hidden = !r.agent;
			$('[data-sum-row="owner"]').hidden = !r.agent;
			$('[data-sum-row="public"]').hidden = !r.control;
			$('[data-sum-row="database"]').hidden = !r.control;

			const chosen = Boolean(answers.engine && answers.mode);
			$('[data-sum-row="engine"]').hidden = !chosen;
			if (chosen) $(`[data-sum="engine"]`).innerHTML = `${engineLabel(answers.engine, answers.mode)} &nbsp;${badgeHtml(profileFor(answers.platform, answers.engine, answers.mode).status)}`;
		}

		function hostHint() {
			return answers.engine === 'podman'
				? 'Run these yourself, from an account with sudo. They start Podman’s API socket and make sure Quasar comes back after a reboot. Each is safe to run again.'
				: 'Run these yourself, from an account with sudo. They start Docker now and at every boot. Each is safe to run again.';
		}

		function output() {
			const r = role(answers.role);
			const out = generate(answers);
			const showInstall = Boolean(out.script);
			const podman = answers.engine === 'podman';
			const unraid = answers.platform === 'unraid';

			$('[data-out-block="unavailable"]').hidden = !r.control || showInstall || unraid;

			const hostBlock = $('[data-out-block="host"]');
			hostBlock.hidden = !out.hostSteps || answers.engine === 'docker';
            const prep = (out.hostSteps ?? '').replace(/^# Docker[^\n]*\n.*systemctl enable --now docker\n?/, '').trim();
            $('[data-nvidia-prep]').hidden = !answers.nvidia;
            $('[data-out="gpu-prep"]').textContent = prep || (unraid ? 'Use the Unraid NVIDIA driver plugin; check nvidia-smi lists your GPU.' : 'Follow the engine-specific NVIDIA preparation guide.');
			if (out.hostSteps) {
				$('[data-out="host"]').textContent = out.hostSteps;
				$('[data-host-hint]').textContent = hostHint();
			}

			const quadletBlock = $('[data-out-block="quadlet"]');
			quadletBlock.hidden = !out.quadlet;
			if (out.quadlet) {
				$('[data-out="quadlet"]').textContent = out.quadlet;
			}

			// The Dockge/Arcane stack is a Docker (and Unraid) thing; Podman's
			// equivalent is the Quadlet unit above (D15).
			const stackBlock = $('[data-out-block="stack"]');
			stackBlock.hidden = podman || !showInstall;
			$('[data-stack-title]').textContent = out.script && !unraid ? 'Docker Compose configuration' : 'Docker Compose configuration';
            const owner = appUser(answers);
            const quotePath = value => "'" + value.replaceAll("'", "'\"'\"'") + "'";
            $('[data-out="directories"]').textContent = `${unraid ? '' : 'sudo '}install -d -m 0755 -o ${owner.uid} -g ${owner.gid} ${quotePath(homePath(answers))} ${quotePath(templatePath(answers))}`;
			$('[data-out="stack"]').textContent = out.stack;

			const envBlock = $('[data-out-block="env"]');
			envBlock.hidden = !out.env;
			if (out.env) $('[data-out="env"]').textContent = out.env;

			const pxBlock = $('[data-out-block="proxy"]');
			pxBlock.hidden = !out.proxyConfig;
			if (out.proxyConfig) {
				$('[data-out="proxy"]').textContent = out.proxyConfig.body;
				$('[data-out="proxyName"]').textContent = out.proxyConfig.name;
				$('[data-out="proxyFile"]').textContent = out.proxyConfig.filename;
			}

		}

		function render() {
			collect();
			applyPlatformDefaults();
			collect();
			reveal();
			updateEngineStep();
			tree();
			output();
			summary();
			const complete = stepComplete(step);
            $('[data-next]').disabled = step === LAST || !complete;
            const validation = $('[data-validation]');
            validation.hidden = complete;
            validation.textContent = step === 4 ? 'Use absolute storage paths and non-negative whole UID/GID values.' : step === ACCESS_STEP ? 'Enter a hostname or LAN IP address, without https:// or a path.' : 'Choose a supported or experimental container engine.';
			$('[data-back]').disabled = step === 1;
			$('[data-current]').textContent = String(step);
		}

		function show(n) {
			step = Math.min(LAST, Math.max(1, n));
			$$('[data-step]').forEach((el) => el.classList.toggle('on', Number(el.dataset.step) === step));
			$$('[data-dot]').forEach((el) => el.classList.toggle('on', Number(el.dataset.dot) <= step));
			render();
			root.scrollIntoView({ behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'instant' : 'smooth', block: 'start' });
            $(`[data-step="${step}"] h2`)?.setAttribute('tabindex', '-1');
            $(`[data-step="${step}"] h2`)?.focus({ preventScroll: true });
		}

		root.addEventListener('input', (e) => {
			if (e.target?.name) touched.add(e.target.name);
			render();
		});
		root.addEventListener('change', render);
		$('[data-next]').addEventListener('click', () => show(step + 1));
		$('[data-back]').addEventListener('click', () => show(step - 1));

		$$('[data-copy]').forEach((btn) => {
			btn.addEventListener('click', async () => {
				const text = $(`[data-out="${btn.dataset.copy}"]`).textContent;
				try {
					await navigator.clipboard.writeText(text);
					const was = btn.textContent;
					btn.textContent = 'Copied';
					setTimeout(() => (btn.textContent = was), 1600);
				} catch {
					btn.textContent = 'Select it and copy';
				}
			});
		});

        $$('[data-download]').forEach(btn => btn.addEventListener('click', () => {
            const kind = btn.dataset.download;
            const blob = new Blob([$(`[data-out="${kind}"]`).textContent], { type: 'text/plain' });
            const url = URL.createObjectURL(blob);
            const a = document.createElement('a'); a.href = url;
            a.download = kind === 'stack' ? 'compose.yaml' : 'quasar-seed.container';
            a.click(); URL.revokeObjectURL(url);
        }));

        field('engine').checked = true;
		show(1);
	}
</script>

