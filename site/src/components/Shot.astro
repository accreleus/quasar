---
/**
 * A framed screenshot slot for use inside docs pages.
 *
 * Import the image from src/assets/shots/ and pass it as `src`, with `alt`.
 * `sublabel`, when given, renders as the caption.
 *
 * Every <Shot> in the docs must have a matching row in site/SCREENSHOTS.md
 * recording where the image came from.
 */
import { Image } from 'astro:assets';

interface Props {
	/** Short label naming the surface in the page source, e.g. "Admin hosts". Not rendered. */
	label: string;
	/** One plain sentence of context, shown as the caption. */
	sublabel?: string;
	/** The imported screenshot. */
	src: ImageMetadata;
	/** Alt text for the screenshot. */
	alt: string;
}

const { sublabel, src, alt } = Astro.props;
---

<figure class="q-shot">
	<Image src={src} alt={alt} class="q-shot-img" />
	{sublabel && <figcaption>{sublabel}</figcaption>}
</figure>

<style>
	.q-shot {
		margin: 1.75rem 0;
	}

	.q-shot-img {
		width: 100%;
		height: auto;
		border-radius: var(--q-r-lg, 12px);
		border: 1px solid var(--q-line-2, rgba(255, 255, 255, 0.12));
		box-shadow: var(--q-shadow-md, 0 6px 20px -6px rgba(0, 0, 0, 0.55));
	}

	figcaption {
		margin-top: 0.6rem;
		font-size: 0.8125rem;
		color: var(--q-text-3, oklch(0.6605 0.0265 259.81));
	}
</style>
