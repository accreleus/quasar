{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,

    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",

    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true,

    // The metric manifest ships as JSON (docs/session-trace/metrics.json, copied
    // to src/lib/metrics.generated.json by `make docs-metrics-sync`) and
    // src/lib/metricsManifest.ts imports it directly.
    "resolveJsonModule": true
  },
  "include": ["src"]
}
