{
  "id": "/app",
  "name": "Quasar",
  "short_name": "Quasar",
  "description": "Self-hosted cloud gaming — stream your library to any screen.",
  "start_url": "/app",
  "scope": "/",
  "display": "standalone",
  "background_color": "#040509",
  "theme_color": "#040509",
  "icons": [
    {
      "src": "/icon.svg",
      "type": "image/svg+xml",
      "sizes": "any"
    },
    {
      "src": "/icons/icon-192.png",
      "type": "image/png",
      "sizes": "192x192",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-512.png",
      "type": "image/png",
      "sizes": "512x512",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-maskable-512.png",
      "type": "image/png",
      "sizes": "512x512",
      "purpose": "maskable"
    }
  ]
}
