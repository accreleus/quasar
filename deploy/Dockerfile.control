# Dockerfile.control — multi-stage build for the Quasar control-plane.
#
# Stage 1: compile the Go binary with the official golang image.
# Stage 2: minimal Debian runtime (no Go toolchain, no build deps).
#
# Build from the repo root (the COPY paths are relative to the build context):
#   docker build -f deploy/Dockerfile.control -t quasar-control-plane:latest .
#
# The control-plane self-migrates on startup (embedded golang-migrate FS).
# No separate migration runner is needed in the image.

# ── Build stage ───────────────────────────────────────────────────────────────
# Must stay >= control-plane/go.mod's `go` directive (currently 1.25.0). The
# official golang images set GOTOOLCHAIN=local, so a lower pin does NOT silently
# auto-download the newer toolchain — `go mod download` fails outright with
# "go.mod requires go >= 1.25.0 (running go 1.24.x; GOTOOLCHAIN=local)".
FROM golang:1.25-alpine AS builder

WORKDIR /src

# Cache module download separately from the compile step.
COPY control-plane/go.mod control-plane/go.sum ./
RUN go mod download

COPY control-plane/ .

# Build identity (#107), served by GET /v1/admin/platform/identity and logged at
# startup. Unset stamps read as "dev" + null, never a stale package version. The
# build context carries no .git, so these must be passed in.
ARG QUASAR_VERSION=
ARG SOURCE_COMMIT=unknown
ARG BUILT_AT=unknown

# CGO_ENABLED=0 → fully static binary (no libc deps in the runtime image).
# -s -w stay: -X writes string data, which stripping symbols does not touch.
RUN CGO_ENABLED=0 GOOS=linux go build \
    -trimpath -ldflags="-s -w \
      -X github.com/accreleus/quasar/control-plane/internal/buildinfo.version=${QUASAR_VERSION} \
      -X github.com/accreleus/quasar/control-plane/internal/buildinfo.sourceCommit=${SOURCE_COMMIT} \
      -X github.com/accreleus/quasar/control-plane/internal/buildinfo.builtAt=${BUILT_AT}" \
    -o /quasar-control ./cmd/quasar-control

# ── Runtime stage ─────────────────────────────────────────────────────────────
FROM debian:bookworm-slim

# ca-certificates: needed for TLS outbound (DB connections, future HTTPS).
RUN apt-get update && \
    apt-get install -y --no-install-recommends ca-certificates wget && \
    rm -rf /var/lib/apt/lists/*

COPY --from=builder /quasar-control /usr/local/bin/quasar-control

# THE SAME uid:gid AS Dockerfile.control.prod (`quasar`, 1000:1000, which the
# quasar-base family defines). Not cosmetic: a named volume takes its ownership
# from the mount point of whichever image created it, so a stack that ran the
# source image as root left quasar-control-tls root-owned, and a later apply to
# the published image crash-looped on "write TLS key
# /var/lib/quasar-control/tls/key.pem: permission denied". Either image must be
# able to use a volume the other created, and running both as 1000 is what makes
# that true. deploy/redeploy.sh chowns the volume once for stacks that predate
# this. Changing the uid here without changing it there re-opens the same hole.
RUN groupadd -g 1000 quasar && useradd -u 1000 -g 1000 -m -s /bin/bash quasar

# Both directories must exist and be owned before USER: /run and /var/lib are
# root-owned 0755, so a non-root process cannot create a subdirectory in either.
# /run/quasar holds the dev-agent-auth key (#399, mode 0600);
# /var/lib/quasar-control is the TLS-pair + artwork-cache mount point, and
# declaring it here is what makes a fresh named volume land owned by `quasar`.
RUN mkdir -p /run/quasar && chown quasar:quasar /run/quasar && chmod 0700 /run/quasar
RUN mkdir -p /var/lib/quasar-control && chown quasar:quasar /var/lib/quasar-control

# The SPA is mounted at runtime via QUASAR_WEB_ROOT (see docker-compose.yml).
# Nothing to COPY here — the SPA is built separately with `pnpm build`. The dev
# overlay bind-mounts ../web/dist read-only; the web build writes it 0755/0644,
# so uid 1000 reads it.

USER quasar

EXPOSE 8080

ENTRYPOINT ["/usr/local/bin/quasar-control"]
