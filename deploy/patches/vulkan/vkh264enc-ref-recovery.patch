diff --git a/subprojects/gst-plugins-bad/tests/check/libs/vkvideoencodeh264anchors.c b/subprojects/gst-plugins-bad/tests/check/libs/vkvideoencodeh264anchors.c
new file mode 100644
index 0000000..97aee21
--- /dev/null
+++ b/subprojects/gst-plugins-bad/tests/check/libs/vkvideoencodeh264anchors.c
@@ -0,0 +1,260 @@
+/* GStreamer
+ * Copyright (C) 2026 Quasar contributors
+ *
+ * This library is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Library General Public
+ * License as published by the Free Software Foundation; either
+ * version 2 of the License, or (at your option) any later version.
+ */
+
+/* Reference recovery decisions of GstH264Encoder (num-anchors > 0), through
+ * the test seam in gsth264encoder.h. No Vulkan: like vkvideoencodeav1refs.c
+ * it includes the plugin-internal implementation file. */
+
+#ifdef HAVE_CONFIG_H
+#include "config.h"
+#endif
+
+#include <gst/check/gstcheck.h>
+
+#undef GST_CAT_DEFAULT
+
+#include "../../../ext/vulkan/base/gsth264encoder.c"
+
+static GPtrArray *frames;
+
+static void
+setup (void)
+{
+  (void) gst_h264_encoder_get_type ();
+  frames = g_ptr_array_new_with_free_func (gst_h264_encoder_frame_unref);
+}
+
+static void
+teardown (void)
+{
+  g_clear_pointer (&frames, g_ptr_array_unref);
+}
+
+static GstH264EncoderFrame *
+frame (GstH264SliceType type, guint16 frame_num, gint lt_idx)
+{
+  GstH264EncoderFrame *f = gst_h264_encoder_frame_new ();
+
+  f->type.slice_type = type;
+  f->type.is_ref = TRUE;
+  f->gop_frame_num = frame_num;
+  f->pts = frame_num * GST_MSECOND;
+  f->long_term_frame_idx = lt_idx;
+  g_ptr_array_add (frames, f);
+
+  return f;
+}
+
+GST_START_TEST (test_h264_anchor_mark)
+{
+  GstH264EncoderFrame *refs[4], *evict, *src, *p;
+
+  refs[0] = frame (GST_H264_I_SLICE, 0, -1);
+  p = frame (GST_H264_P_SLICE, 1, -1);
+  p->want_anchor = TRUE;
+  src = gst_h264_encoder_plan_anchor_refs (refs, 1, 3, p, &evict);
+  fail_unless (src == refs[0]);
+  assert_equals_int (p->long_term_frame_idx, 0);
+  fail_unless (evict == NULL);
+
+  /* the chain is an anchor: MMCO 1 would name a long-term picture, so wait */
+  refs[0] = p;
+  p = frame (GST_H264_P_SLICE, 2, -1);
+  p->want_anchor = TRUE;
+  src = gst_h264_encoder_plan_anchor_refs (refs, 1, 3, p, &evict);
+  fail_unless (src == refs[0]);
+  assert_equals_int (p->long_term_frame_idx, -1);
+
+  /* next free index */
+  refs[1] = p;
+  p = frame (GST_H264_P_SLICE, 3, -1);
+  p->want_anchor = TRUE;
+  src = gst_h264_encoder_plan_anchor_refs (refs, 2, 3, p, &evict);
+  fail_unless (src == refs[1]);
+  assert_equals_int (p->long_term_frame_idx, 1);
+
+  /* I frames code from nothing and are never anchors */
+  p = frame (GST_H264_I_SLICE, 0, -1);
+  p->want_anchor = TRUE;
+  fail_unless (gst_h264_encoder_plan_anchor_refs (refs, 2, 3, p, &evict)
+      == NULL);
+  assert_equals_int (p->long_term_frame_idx, -1);
+}
+
+GST_END_TEST;
+
+GST_START_TEST (test_h264_anchor_evict)
+{
+  GstH264EncoderFrame *refs[3], *evict, *p;
+
+  refs[0] = frame (GST_H264_P_SLICE, 4, 1);
+  refs[1] = frame (GST_H264_P_SLICE, 8, 0);
+  refs[2] = frame (GST_H264_P_SLICE, 9, -1);
+  p = frame (GST_H264_P_SLICE, 10, -1);
+  p->want_anchor = TRUE;
+  gst_h264_encoder_plan_anchor_refs (refs, 3, 2, p, &evict);
+  /* the oldest anchor's index, whatever its value */
+  fail_unless (evict == refs[0]);
+  assert_equals_int (p->long_term_frame_idx, 1);
+}
+
+GST_END_TEST;
+
+GST_START_TEST (test_h264_anchor_recover)
+{
+  GstH264EncoderFrame *refs[3], *evict, *src, *p;
+
+  refs[0] = frame (GST_H264_P_SLICE, 10, 0);
+  refs[1] = frame (GST_H264_P_SLICE, 20, 1);
+  refs[2] = frame (GST_H264_P_SLICE, 25, -1);
+
+  p = frame (GST_H264_P_SLICE, 26, -1);
+  p->recover_from = 10 * GST_MSECOND;
+  p->want_anchor = TRUE;
+  src = gst_h264_encoder_plan_anchor_refs (refs, 3, 3, p, &evict);
+  fail_unless (src == refs[0]);
+  /* not an anchor too: frame_num - 1 is a gap picture in the decoder */
+  assert_equals_int (p->long_term_frame_idx, -1);
+
+  /* a chain picture is no anchor, nor is an unknown PTS */
+  p->recover_from = 25 * GST_MSECOND;
+  fail_unless (gst_h264_encoder_plan_anchor_refs (refs, 3, 3, p, &evict)
+      == NULL);
+  p->recover_from = 99 * GST_MSECOND;
+  fail_unless (gst_h264_encoder_plan_anchor_refs (refs, 3, 3, p, &evict)
+      == NULL);
+}
+
+GST_END_TEST;
+
+GST_START_TEST (test_h264_anchor_syntax)
+{
+  GstH264EncoderFrame *anchor = frame (GST_H264_P_SLICE, 5, 2);
+  GstH264EncoderFrame *chain = frame (GST_H264_P_SLICE, 6, -1);
+  GstH264EncoderFrame *p = frame (GST_H264_P_SLICE, 7, -1);
+  GstH264SliceHdr hdr = { 0, };
+  GstH264RefPicMarking *m = hdr.dec_ref_pic_marking.ref_pic_marking;
+
+  /* a short-term chain: default list order, sliding window */
+  gst_h264_encoder_anchor_slice_hdr (3, chain, p, &hdr);
+  assert_equals_int (hdr.ref_pic_list_modification_flag_l0, 0);
+  assert_equals_int (hdr.dec_ref_pic_marking.adaptive_ref_pic_marking_mode_flag,
+      0);
+
+  /* from a long-term anchor: named by LongTermPicNum */
+  gst_h264_encoder_anchor_slice_hdr (3, anchor, p, &hdr);
+  assert_equals_int (hdr.ref_pic_list_modification_flag_l0, 1);
+  assert_equals_int (hdr.n_ref_pic_list_modification_l0, 2);
+  assert_equals_int (hdr.ref_pic_list_modification_l0[0].
+      modification_of_pic_nums_idc, 2);
+  assert_equals_int (hdr.ref_pic_list_modification_l0[0].value.
+      long_term_pic_num, 2);
+  assert_equals_int (hdr.ref_pic_list_modification_l0[1].
+      modification_of_pic_nums_idc, 3);
+
+  /* an anchor marks itself: MMCO 4, 1, 6, end */
+  memset (&hdr, 0, sizeof (hdr));
+  p->long_term_frame_idx = 1;
+  gst_h264_encoder_anchor_slice_hdr (3, chain, p, &hdr);
+  assert_equals_int (hdr.dec_ref_pic_marking.adaptive_ref_pic_marking_mode_flag,
+      1);
+  assert_equals_int (hdr.dec_ref_pic_marking.n_ref_pic_marking, 4);
+  assert_equals_int (m[0].memory_management_control_operation, 4);
+  assert_equals_int (m[0].max_long_term_frame_idx_plus1, 3);
+  assert_equals_int (m[1].memory_management_control_operation, 1);
+  assert_equals_int (m[1].difference_of_pic_nums_minus1, 0);
+  assert_equals_int (m[2].memory_management_control_operation, 6);
+  assert_equals_int (m[2].long_term_frame_idx, 1);
+  assert_equals_int (m[3].memory_management_control_operation, 0);
+}
+
+GST_END_TEST;
+
+/* Which pictures stay held once a frame is coded: only anchors, and after a
+ * recovery none newer than the one it coded from. */
+GST_START_TEST (test_h264_anchor_prune)
+{
+  GstH264EncoderFrame *a10 = frame (GST_H264_P_SLICE, 10, 0);
+  GstH264EncoderFrame *a20 = frame (GST_H264_P_SLICE, 20, 1);
+  GstH264EncoderFrame *a30 = frame (GST_H264_P_SLICE, 30, 2);
+  GstH264EncoderFrame *chain = frame (GST_H264_P_SLICE, 34, -1);
+  GstH264EncoderFrame *p = frame (GST_H264_P_SLICE, 35, -1);
+  GstH264EncoderFrame *i = frame (GST_H264_I_SLICE, 35, -1);
+
+  /* from the chain: the anchors stay, the chain is replaced */
+  fail_unless (gst_h264_encoder_anchor_ref_kept (a10, p, chain, NULL));
+  fail_unless (gst_h264_encoder_anchor_ref_kept (a30, p, chain, NULL));
+  fail_if (gst_h264_encoder_anchor_ref_kept (chain, p, chain, NULL));
+  /* an evicted anchor goes */
+  fail_if (gst_h264_encoder_anchor_ref_kept (a10, p, chain, a10));
+
+  /* recovering from 20: 30 may be missing in the decoder, forget it */
+  p->recover_from = 20 * GST_MSECOND;
+  fail_unless (gst_h264_encoder_anchor_ref_kept (a10, p, a20, NULL));
+  fail_unless (gst_h264_encoder_anchor_ref_kept (a20, p, a20, NULL));
+  fail_if (gst_h264_encoder_anchor_ref_kept (a30, p, a20, NULL));
+  fail_if (gst_h264_encoder_anchor_ref_kept (chain, p, a20, NULL));
+
+  /* a non-IDR I frame replaces the chain too, and keeps the anchors */
+  fail_unless (gst_h264_encoder_anchor_ref_kept (a30, i, NULL, NULL));
+  fail_if (gst_h264_encoder_anchor_ref_kept (chain, i, NULL, NULL));
+}
+
+GST_END_TEST;
+
+static guint
+anchors_for (gint w, gint h, gint fps, GstH264Level level,
+    GstH264Level max_level)
+{
+  GstVideoInfo info;
+
+  gst_video_info_set_format (&info, GST_VIDEO_FORMAT_NV12, w, h);
+  GST_VIDEO_INFO_FPS_N (&info) = fps;
+  GST_VIDEO_INFO_FPS_D (&info) = 1;
+  return gst_h264_encoder_max_anchors_for_level (GST_H264_PROFILE_BASELINE,
+      &info, level, max_level);
+}
+
+/* K anchors need max_dec_frame_buffering K + 2 within MaxDpbFrames of the
+ * level the stream gets without them (Table A-1). */
+GST_START_TEST (test_h264_anchor_level)
+{
+  assert_equals_int (anchors_for (640, 360, 60, 0, 0), 14);     /* 3.1 */
+  assert_equals_int (anchors_for (1280, 720, 60, 0, 0), 3);     /* 3.2 */
+  assert_equals_int (anchors_for (1920, 1080, 30, 0, 0), 2);    /* 4 */
+  assert_equals_int (anchors_for (1920, 1080, 60, 0, 0), 2);    /* 4.2 */
+  assert_equals_int (anchors_for (2560, 1440, 60, 0, 0), 10);   /* 5.1 */
+  assert_equals_int (anchors_for (3840, 2160, 60, 0, 0), 3);    /* 5.2 */
+  /* a negotiated level is the stream's level */
+  assert_equals_int (anchors_for (1920, 1080, 60, GST_H264_LEVEL_L5_1, 0), 14);
+  /* the accelerator's highest level caps it */
+  assert_equals_int (anchors_for (2560, 1440, 60, 0, GST_H264_LEVEL_L4_1), 0);
+}
+
+GST_END_TEST;
+
+static Suite *
+h264anchors_suite (void)
+{
+  Suite *s = suite_create ("h264anchors");
+  TCase *tc = tcase_create ("general");
+
+  suite_add_tcase (s, tc);
+  tcase_add_checked_fixture (tc, setup, teardown);
+  tcase_add_test (tc, test_h264_anchor_mark);
+  tcase_add_test (tc, test_h264_anchor_evict);
+  tcase_add_test (tc, test_h264_anchor_recover);
+  tcase_add_test (tc, test_h264_anchor_syntax);
+  tcase_add_test (tc, test_h264_anchor_prune);
+  tcase_add_test (tc, test_h264_anchor_level);
+
+  return s;
+}
+
+GST_CHECK_MAIN (h264anchors);
