+static GstFlowReturn
+gst_h264_encoder_encode_frame_anchors (GstH264Encoder * self,
+    GstVideoCodecFrame * frame)
+{
+  GstH264EncoderClass *klass = GST_H264_ENCODER_GET_CLASS (self);
+  GstH264EncoderPrivate *priv = _GET_PRIV (self);
+  GstH264EncoderFrame *h264_frame = _GET_FRAME (frame);
+  GstH264EncoderFrame *refs[16], *src, *evict;
+  GstH264SliceHdr slice_hdr;
+  GstFlowReturn ret;
+  guint i, num_refs = g_queue_get_length (&priv->ref_list);
+  GList *l;
+
+  g_assert (num_refs <= G_N_ELEMENTS (refs));
+  for (i = 0, l = priv->ref_list.head; l; l = l->next, i++)
+    refs[i] = _GET_FRAME (l->data);
+
+  g_array_set_size (priv->ref_list0, 0);
+  g_array_set_size (priv->ref_list1, 0);
+
+  src = gst_h264_encoder_plan_anchor_refs (refs, num_refs,
+      priv->gop.num_anchors, h264_frame, &evict);
+  if (h264_frame->type.slice_type != GST_H264_I_SLICE) {
+    if (!src) {
+      GST_ERROR_OBJECT (self, "No reference for fn=%u",
+          h264_frame->gop_frame_num);
+      return GST_FLOW_ERROR;
+    }
+    g_array_append_val (priv->ref_list0, src);
+  } else {
+    h264_frame->recover_from = GST_CLOCK_TIME_NONE;
+  }
+
+  gst_h264_encoder_slicehdr_init (self, h264_frame, &slice_hdr);
+  gst_h264_encoder_anchor_slice_hdr (priv->gop.num_anchors, src, h264_frame,
+      &slice_hdr);
+
+  g_assert (klass->encode_frame);
+  ret = klass->encode_frame (self, frame, h264_frame, &slice_hdr,
+      priv->ref_list0, priv->ref_list1);
+  if (ret != GST_FLOW_OK || !h264_frame->type.is_ref)
+    goto done;
+
+  /* also after a non-IDR I frame, which replaces the chain picture */
+  for (l = priv->ref_list.head; l;) {
+    GstVideoCodecFrame *f = l->data;
+    GstH264EncoderFrame *h = _GET_FRAME (f);
+    GList *next = l->next;
+
+    if (!gst_h264_encoder_anchor_ref_kept (h, h264_frame, src, evict)) {
+      g_queue_delete_link (&priv->ref_list, l);
+      gst_video_codec_frame_unref (f);
+    }
+    l = next;
+  }
+
+done:
+  if (ret == GST_FLOW_OK && h264_frame->type.is_ref)
+    g_queue_push_tail (&priv->ref_list, gst_video_codec_frame_ref (frame));
+
+  return ret;
+}
