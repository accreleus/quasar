+/* Reference recovery: the most anchors the level allows at @info's size. The
+ * SPS then says max_dec_frame_buffering = K + 2 (the anchors, the chain
+ * picture and the picture being coded), which must stay within MaxDpbFrames
+ * (Table A-1) of the level the stream gets without anchors (@level when it was
+ * negotiated), so anchors never raise the level; @max_level (0 = none) is the
+ * accelerator's, which the subclass clamps the SPS to. */
+guint
+gst_h264_encoder_max_anchors_for_level (GstH264Profile profile,
+    GstVideoInfo * info, GstH264Level level, GstH264Level max_level)
+{
+  const GstH264LevelDescriptor *desc = NULL;
+  guint i, pic_size_mbs, dpb_frames;
+
+  if (level == 0) {
+    desc = gst_h264_get_level_descriptor (profile, 0, info, 2);
+    if (!desc)
+      return 0;
+    level = desc->level_idc;
+  }
+  if (max_level > 0 && level > max_level)
+    level = max_level;
+
+  desc = NULL;
+  for (i = 0; i < G_N_ELEMENTS (_h264_levels); i++) {
+    if (_h264_levels[i].level_idc == level)
+      desc = &_h264_levels[i];
+  }
+  pic_size_mbs = (GST_ROUND_UP_16 (GST_VIDEO_INFO_WIDTH (info)) / 16) *
+      (GST_ROUND_UP_16 (GST_VIDEO_INFO_HEIGHT (info)) / 16);
+  if (!desc || pic_size_mbs == 0)
+    return 0;
+
+  dpb_frames = MIN (desc->max_dpb_mbs / pic_size_mbs, 16);
+  return dpb_frames > 2 ? dpb_frames - 2 : 0;
+}
+
+/* Reference recovery: whether held picture @h stays held once @frame, coded
+ * from @src (NULL for an I frame), is. Only anchors stay: @frame replaces the
+ * chain picture, @evict gives its LongTermFrameIdx to @frame, and after a
+ * recovery the anchors newer than @src may be missing in the decoder. */
+gboolean
+gst_h264_encoder_anchor_ref_kept (GstH264EncoderFrame * h,
+    GstH264EncoderFrame * frame, GstH264EncoderFrame * src,
+    GstH264EncoderFrame * evict)
+{
+  if (h == evict || h->long_term_frame_idx < 0)
+    return FALSE;
+  return !(src && GST_CLOCK_TIME_IS_VALID (frame->recover_from)
+      && h->gop_frame_num > src->gop_frame_num);
+}
+
+/* Reference recovery: the one picture a P @frame codes from, and whether it
+ * becomes an anchor. @refs is the held set (the chain picture and the
+ * anchors) in ascending frame_num. The chain is the newest; a recovery frame
+ * codes from the anchor named by frame->recover_from instead. An anchor takes
+ * a free LongTermFrameIdx below @num_anchors, or the oldest anchor's, which
+ * is then returned in @evict. The request waits a frame when the chain is
+ * itself an anchor or this is a recovery frame: the marking's MMCO 1 names
+ * frame_num - 1, which must be a short-term picture in the decoder. Returns
+ * NULL for an I frame, or when the recovery anchor is not held. */
+GstH264EncoderFrame *
+gst_h264_encoder_plan_anchor_refs (GstH264EncoderFrame ** refs,
+    guint num_refs, guint num_anchors, GstH264EncoderFrame * frame,
+    GstH264EncoderFrame ** evict)
+{
+  GstH264EncoderFrame *chain, *src = NULL, *oldest = NULL;
+  guint i, used = 0, held = 0;
+  gint idx = -1;
+
+  *evict = NULL;
+  frame->long_term_frame_idx = -1;
+
+  if (frame->type.slice_type == GST_H264_I_SLICE || num_refs == 0)
+    return NULL;
+
+  chain = refs[num_refs - 1];
+  if (GST_CLOCK_TIME_IS_VALID (frame->recover_from)) {
+    for (i = 0; i < num_refs; i++) {
+      if (refs[i]->long_term_frame_idx >= 0
+          && refs[i]->pts == frame->recover_from)
+        src = refs[i];
+    }
+    return src;
+  }
+  src = chain;
+
+  if (!frame->want_anchor || num_anchors == 0 || chain->long_term_frame_idx >= 0)
+    return src;
+
+  for (i = 0; i < num_refs; i++) {
+    if (refs[i]->long_term_frame_idx < 0)
+      continue;
+    used |= 1 << refs[i]->long_term_frame_idx;
+    held++;
+    if (!oldest || refs[i]->gop_frame_num < oldest->gop_frame_num)
+      oldest = refs[i];
+  }
+
+  if (held >= num_anchors) {
+    *evict = oldest;
+    idx = oldest->long_term_frame_idx;
+  } else {
+    for (idx = 0; idx < (gint) num_anchors && (used & (1 << idx)); idx++);
+  }
+
+  frame->long_term_frame_idx = idx;
+  return src;
+}
+
+/* Reference recovery syntax: name a long-term @ref explicitly (the default
+ * list puts short-term pictures first), and mark an anchor long-term in its
+ * own slice header. MMCO 4 is repeated on every anchor so a lost first one
+ * cannot leave the decoder without long-term indices. */
+void
+gst_h264_encoder_anchor_slice_hdr (guint num_anchors,
+    GstH264EncoderFrame * ref, GstH264EncoderFrame * frame,
+    GstH264SliceHdr * slice_hdr)
+{
+  GstH264RefPicMarking *mmco = slice_hdr->dec_ref_pic_marking.ref_pic_marking;
+
+  if (ref && ref->long_term_frame_idx >= 0) {
+    slice_hdr->ref_pic_list_modification_flag_l0 = 1;
+    slice_hdr->n_ref_pic_list_modification_l0 = 2;
+    slice_hdr->ref_pic_list_modification_l0[0] =
+        (GstH264RefPicListModification) {
+      .modification_of_pic_nums_idc = 2,
+      .value.long_term_pic_num = ref->long_term_frame_idx,
+    };
+    slice_hdr->ref_pic_list_modification_l0[1] =
+        (GstH264RefPicListModification) {
+      .modification_of_pic_nums_idc = 3,
+    };
+  }
+
+  if (frame->long_term_frame_idx < 0)
+    return;
+
+  slice_hdr->dec_ref_pic_marking.adaptive_ref_pic_marking_mode_flag = 1;
+  slice_hdr->dec_ref_pic_marking.n_ref_pic_marking = 4;
+  mmco[0] = (GstH264RefPicMarking) {
+    .memory_management_control_operation = 4,
+    .max_long_term_frame_idx_plus1 = num_anchors,
+  };
+  /* frame_num - 1: the chain picture */
+  mmco[1] = (GstH264RefPicMarking) {
+    .memory_management_control_operation = 1,
+    .difference_of_pic_nums_minus1 = 0,
+  };
+  mmco[2] = (GstH264RefPicMarking) {
+    .memory_management_control_operation = 6,
+    .long_term_frame_idx = frame->long_term_frame_idx,
+  };
+  mmco[3] = (GstH264RefPicMarking) {
+    .memory_management_control_operation = 0,
+  };
+}
