+/* Reference recovery: the DPB pictures (references + 1) the level allows at
+ * this size and rate, taking the level the stream gets without anchors (the
+ * configured one, else the lowest that fits size and rate; bitrate is left
+ * out, which can only pick a lower level and so a tighter limit). H.264:
+ * MaxDpbFrames from Table A-1; HEVC: MaxDpbSize from A.4.2, Main tier. */
+static guint
+gst_nv_encoder_level_max_dpb (gboolean h264, guint32 level, guint w, guint h,
+    guint fps_n, guint fps_d)
+{
+  static const struct
+  {
+    guint32 idc, mbps, fs, dpb_mbs;
+  } h264_levels[] = {
+    {10, 1485, 99, 396}, {11, 3000, 396, 900}, {12, 6000, 396, 2376},
+    {13, 11880, 396, 2376}, {20, 11880, 396, 2376}, {21, 19800, 792, 4752},
+    {22, 20250, 1620, 8100}, {30, 40500, 1620, 8100}, {31, 108000, 3600, 18000},
+    {32, 216000, 5120, 20480}, {40, 245760, 8192, 32768},
+    {41, 245760, 8192, 32768}, {42, 522240, 8704, 34816},
+    {50, 589824, 22080, 110400}, {51, 983040, 36864, 184320},
+    {52, 2073600, 36864, 184320}, {60, 4177920, 139264, 696320},
+    {61, 8355840, 139264, 696320}, {62, 16711680, 139264, 696320},
+  };
+  static const struct
+  {
+    guint32 idc;
+    guint64 ps, sr;
+  } h265_levels[] = {
+    {30, 36864, 552960}, {60, 122880, 3686400}, {63, 245760, 7372800},
+    {90, 552960, 16588800}, {93, 983040, 33177600}, {120, 2228224, 66846720},
+    {123, 2228224, 133693440}, {150, 8912896, 267386880},
+    {153, 8912896, 534773760}, {156, 8912896, 1069547520},
+    {180, 35651584, 1069547520}, {183, 35651584, 2139095040},
+    {186, 35651584, 4278190080},
+  };
+  guint i;
+
+  if (fps_n == 0 || fps_d == 0) {
+    fps_n = 60;
+    fps_d = 1;
+  }
+
+  if (h264) {
+    guint64 fs = (guint64) ((w + 15) / 16) * ((h + 15) / 16);
+    guint64 mbps = gst_util_uint64_scale_ceil (fs, fps_n, fps_d);
+
+    if (level == NV_ENC_LEVEL_H264_1b)
+      level = NV_ENC_LEVEL_H264_1;
+    for (i = 0; i < G_N_ELEMENTS (h264_levels) - 1; i++) {
+      if (level != NV_ENC_LEVEL_AUTOSELECT ? h264_levels[i].idc == level :
+          (fs <= h264_levels[i].fs && mbps <= h264_levels[i].mbps))
+        break;
+    }
+    return MIN (h264_levels[i].dpb_mbs / MAX (fs, 1), 16);
+  } else {
+    guint64 ps = (guint64) w * h;
+    guint64 sr = gst_util_uint64_scale_ceil (ps, fps_n, fps_d);
+    guint64 max_ps;
+
+    for (i = 0; i < G_N_ELEMENTS (h265_levels) - 1; i++) {
+      if (level != NV_ENC_LEVEL_AUTOSELECT ? h265_levels[i].idc == level :
+          (ps <= h265_levels[i].ps && sr <= h265_levels[i].sr))
+        break;
+    }
+    max_ps = h265_levels[i].ps;
+    if (ps <= (max_ps >> 2))
+      return 16;
+    if (ps <= (max_ps >> 1))
+      return 12;
+    if (ps <= ((3 * max_ps) >> 2))
+      return 8;
+    return 6;
+  }
+}
