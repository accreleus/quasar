+/* Reference recovery: clamp num-anchors and turn on per-picture LTR in
+ * @config, which set_format() has filled. A new session starts with an IDR,
+ * so nothing is held. */
+static void
+gst_nv_encoder_setup_anchors (GstNvEncoder * self, gpointer session,
+    NV_ENC_INITIALIZE_PARAMS * init_params, NV_ENC_CONFIG * config)
+{
+  GstNvEncoderPrivate *priv = self->priv;
+  gboolean h264 = memcmp (&init_params->encodeGUID, &NV_ENC_CODEC_H264_GUID,
+      sizeof (GUID)) == 0;
+  gboolean h265 = memcmp (&init_params->encodeGUID, &NV_ENC_CODEC_HEVC_GUID,
+      sizeof (GUID)) == 0;
+  guint k;
+
+  GST_OBJECT_LOCK (self);
+  k = priv->num_anchors;
+  priv->req.anchor = FALSE;
+  priv->req.recover = FALSE;
+  GST_OBJECT_UNLOCK (self);
+
+  if (k > 0 && !h264 && !h265) {
+    GST_WARNING_OBJECT (self, "num-anchors=%u: NVENC API 12.0 has no AV1 "
+        "long-term references, 0 used", k);
+    k = 0;
+  } else if (k > 0 && config->frameIntervalP > 1) {
+    GST_WARNING_OBJECT (self, "num-anchors=%u needs no B frames, 0 used", k);
+    k = 0;
+  } else if (k > 0) {
+    NV_ENC_CAPS_PARAM param = { 0, };
+    gint max_ltr = 0;
+
+    param.version = gst_nvenc_get_caps_param_version ();
+    param.capsToQuery = NV_ENC_CAPS_NUM_MAX_LTR_FRAMES;
+    if (NvEncGetEncodeCaps (session, init_params->encodeGUID, &param,
+            &max_ltr) != NV_ENC_SUCCESS)
+      max_ltr = 0;
+    if ((gint) k > max_ltr) {
+      GST_WARNING_OBJECT (self, "num-anchors=%u, the device holds %d "
+          "long-term references", k, max_ltr);
+      k = MAX (max_ltr, 0);
+    }
+  }
+
+  if (k > 0 && h264) {
+    auto & c = config->encodeCodecConfig.h264Config;
+    c.enableLTR = 1;
+    c.ltrTrustMode = 0;
+    c.ltrNumFrames = k;
+    c.maxNumRefFrames = MAX (c.maxNumRefFrames, k + 1);
+  } else if (k > 0) {
+    auto & c = config->encodeCodecConfig.hevcConfig;
+    c.enableLTR = 1;
+    c.ltrTrustMode = 0;
+    c.ltrNumFrames = k;
+    c.maxNumRefFramesInDPB = MAX (c.maxNumRefFramesInDPB, k + 1);
+  }
+
+  priv->anchors = k;
+  priv->anchor_h264 = h264;
+  for (guint i = 0; i < G_N_ELEMENTS (priv->anchor_pts); i++)
+    priv->anchor_pts[i] = GST_CLOCK_TIME_NONE;
+  for (guint i = 0; i < G_N_ELEMENTS (priv->recent); i++)
+    priv->recent[i] = GST_CLOCK_TIME_NONE;
+  priv->prev_anchor = FALSE;
+  priv->need_idr = TRUE;
+  priv->since_idr = 0;
+}
+
+/* Reference recovery: decide @frame's long-term references (same rules as
+ * the Vulkan encoders, gstrefrecovery.h). The held set mirrors the encoder's
+ * DPB: an IDR drops every long-term picture, marking an index replaces it.
+ * A recovery frame also invalidates the recent pictures newer than its
+ * anchor, so no short-term reference from the lost chain is left. */
+static void
+gst_nv_encoder_plan_refs (GstNvEncoder * self, GstVideoCodecFrame * frame,
+    GstNvEncRefControl * ref)
+{
+  GstNvEncoderPrivate *priv = self->priv;
+  GstRefRecoveryRequest req;
+  GstClockTime recover_from = GST_CLOCK_TIME_NONE;
+  gint slot = -1;
+  gboolean key, rearm = FALSE;
+
+  GST_OBJECT_LOCK (self);
+  req = priv->req;
+  priv->req.anchor = FALSE;
+  priv->req.recover = FALSE;
+  GST_OBJECT_UNLOCK (self);
+
+  key = priv->need_idr || GST_VIDEO_CODEC_FRAME_IS_FORCE_KEYFRAME (frame) ||
+      priv->since_idr >= priv->config.gopLength;
+
+  if (req.recover && !key) {
+    for (guint i = 0; i < priv->anchors; i++) {
+      if (priv->anchor_pts[i] == req.recover_pts)
+        slot = i;
+    }
+    if (slot < 0) {
+      GST_INFO_OBJECT (self, "No anchor with pts %" GST_TIME_FORMAT
+          ", key frame instead", GST_TIME_ARGS (req.recover_pts));
+      GST_VIDEO_CODEC_FRAME_SET_FORCE_KEYFRAME (frame);
+      key = TRUE;
+    }
+  }
+
+  if (key) {
+    for (guint i = 0; i < priv->anchors; i++)
+      priv->anchor_pts[i] = GST_CLOCK_TIME_NONE;
+    priv->need_idr = FALSE;
+    priv->since_idr = 0;
+    rearm = req.anchor;
+  } else if (slot >= 0) {
+    recover_from = req.recover_pts;
+    ref->use_bitmap = 1 << slot;
+    for (guint i = 0; i < priv->anchors; i++) {
+      if (GST_CLOCK_TIME_IS_VALID (priv->anchor_pts[i]) &&
+          priv->anchor_pts[i] > recover_from)
+        priv->anchor_pts[i] = GST_CLOCK_TIME_NONE;
+    }
+    for (guint i = 0; i < G_N_ELEMENTS (priv->recent); i++) {
+      if (GST_CLOCK_TIME_IS_VALID (priv->recent[i]) &&
+          priv->recent[i] > recover_from)
+        ref->invalidate[ref->n_invalidate++] = priv->recent[i];
+    }
+  }
+
+  if (!key && req.anchor && priv->anchors > 0) {
+    if (priv->anchor_h264 && (slot >= 0 || priv->prev_anchor)) {
+      rearm = TRUE;
+    } else {
+      /* a free index, else the oldest anchor's */
+      gint idx = 0;
+
+      for (guint i = 1; i < priv->anchors; i++) {
+        if (!GST_CLOCK_TIME_IS_VALID (priv->anchor_pts[idx]))
+          break;
+        if (!GST_CLOCK_TIME_IS_VALID (priv->anchor_pts[i]) ||
+            priv->anchor_pts[i] < priv->anchor_pts[idx])
+          idx = i;
+      }
+      priv->anchor_pts[idx] = frame->pts;
+      ref->mark_idx = idx;
+    }
+  }
+
+  if (rearm) {
+    GST_OBJECT_LOCK (self);
+    priv->req.anchor = TRUE;
+    GST_OBJECT_UNLOCK (self);
+  }
+
+  priv->prev_anchor = ref->mark_idx >= 0;
+  priv->since_idr++;
+  priv->recent[priv->recent_pos] = frame->pts;
+  priv->recent_pos = (priv->recent_pos + 1) % G_N_ELEMENTS (priv->recent);
+
+  if (ref->mark_idx >= 0 || GST_CLOCK_TIME_IS_VALID (recover_from))
+    gst_ref_recovery_report (frame, ref->mark_idx >= 0, recover_from);
+}
