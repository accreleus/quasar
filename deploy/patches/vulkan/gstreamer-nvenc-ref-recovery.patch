+static gboolean
+gst_nv_encoder_src_event (GstVideoEncoder * encoder, GstEvent * event)
+{
+  GstNvEncoderPrivate *priv = GST_NV_ENCODER (encoder)->priv;
+  gboolean ours;
+
+  GST_OBJECT_LOCK (encoder);
+  ours = gst_ref_recovery_take_event (event, &priv->req);
+  GST_OBJECT_UNLOCK (encoder);
