+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    /// Per-element ownership, GPU-free half of spec §4 rung 1: two `VulkanShare`s are
+    /// independent objects (distinct backing storage), each starts with no device, and
+    /// clearing / mutating one never touches the other. The full "two elements mint **distinct**
+    /// `GstVulkanDevice` pointers" assertion needs a real GPU and belongs to the Tower soak
+    /// (§4 rung 1 / §7 cross-session distinctness log) — it cannot run in a headless unit test
+    /// because `ensure_owned_device` opens a real `VkDevice`.
+    #[test]
+    fn shares_are_independent_per_element() {
+        let a = VulkanShare::new();
+        let b = VulkanShare::new();
+        // Distinct allocations — not the old process-global singleton.
+        assert!(!Arc::ptr_eq(&a, &b));
+        // Fresh shares own no device until first use.
+        assert!(a.shared_device().is_none());
+        assert!(b.shared_device().is_none());
+        // Clearing one is a no-op on the other (both remain empty; no shared slot).
+        a.clear();
+        assert!(a.shared_device().is_none());
+        assert!(b.shared_device().is_none());
+    }
