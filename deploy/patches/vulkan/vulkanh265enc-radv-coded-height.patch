+static gboolean
+_vulkan_driver_is_radv (GstVulkanDevice * device)
+{
+  VkPhysicalDeviceDriverProperties driver = {
+    .sType = VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_DRIVER_PROPERTIES,
+  };
+  VkPhysicalDeviceProperties2 props = {
+    .sType = VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_PROPERTIES_2,
+    .pNext = &driver,
+  };
+
+  GstVulkanPhysicalDevice *phys;
+  PFN_vkGetPhysicalDeviceProperties2 get_props2;
+
+  if (!device || !device->physical_device)
+    return FALSE;
+  phys = device->physical_device;
+  if (!gst_vulkan_physical_device_check_api_version (phys, 1, 2, 0))
+    return FALSE;
+  get_props2 = (PFN_vkGetPhysicalDeviceProperties2)
+      gst_vulkan_instance_get_proc_address (phys->instance,
+      "vkGetPhysicalDeviceProperties2");
+  if (!get_props2)
+    return FALSE;
+  get_props2 (phys->device, &props);
+  return driver.driverID == VK_DRIVER_ID_MESA_RADV;
+}
