+static GstFlowReturn
+gst_h265_encoder_encode_frame_anchors (GstH265Encoder * self,
+    GstVideoCodecFrame * frame)
+{
+  GstH265EncoderClass *klass = GST_H265_ENCODER_GET_CLASS (self);
+  GstH265EncoderPrivate *priv = _GET_PRIV (self);
+  GstH265EncoderFrame *h265_frame = _GET_FRAME (frame);
+  GstH265EncoderFrame *refs[16], *src, *evict;
+  GstH265SliceHdr slice_hdr;
+  GstFlowReturn ret;
+  guint i, num_refs = g_queue_get_length (&priv->ref_list);
+  GList *l;
+
+  g_assert (num_refs <= G_N_ELEMENTS (refs));
+  for (i = 0, l = priv->ref_list.head; l; l = l->next, i++)
+    refs[i] = _GET_FRAME (l->data);
+
+  g_array_set_size (priv->ref_list0, 0);
+  g_array_set_size (priv->ref_list1, 0);
+
+  src = gst_h265_encoder_plan_anchor_refs (refs, num_refs,
+      priv->gop.num_anchors, h265_frame, &evict);
+  if (h265_frame->type.slice_type != GST_H265_I_SLICE) {
+    if (!src) {
+      GST_ERROR_OBJECT (self, "No reference for poc %d", h265_frame->poc);
+      return GST_FLOW_ERROR;
+    }
+    g_array_append_val (priv->ref_list0, src);
+  } else {
+    h265_frame->recover_from = GST_CLOCK_TIME_NONE;
+  }
+
+  gst_h265_encoder_slicehdr_init (self, h265_frame, &slice_hdr);
+
+  g_assert (klass->encode_frame);
+  ret = klass->encode_frame (self, frame, h265_frame, &slice_hdr,
+      priv->ref_list0, priv->ref_list1);
+  if (ret != GST_FLOW_OK || !h265_frame->type.is_ref)
+    return ret;
+
+  /* the next RPS lists exactly what this one kept, plus this frame */
+  for (l = priv->ref_list.head; l;) {
+    GstVideoCodecFrame *f = l->data;
+    GstH265EncoderFrame *h = _GET_FRAME (f);
+    GList *next = l->next;
+    gboolean keep = (h == src && h->is_anchor && h != evict);
+
+    for (i = 0; i < h265_frame->num_rps_foll; i++)
+      keep |= (h == h265_frame->rps_foll[i]);
+    if (!keep) {
+      g_queue_delete_link (&priv->ref_list, l);
+      gst_video_codec_frame_unref (f);
+    }
+    l = next;
+  }
+  g_queue_push_tail (&priv->ref_list, gst_video_codec_frame_ref (frame));
+  h265_frame->num_rps_foll = 0;
+
+  return GST_FLOW_OK;
+}
