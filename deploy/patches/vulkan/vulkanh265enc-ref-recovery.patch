+/* Reference recovery: the one picture a P @frame codes from, whether it
+ * becomes an anchor, and which anchors its RPS keeps unused. @refs is the
+ * held set (the chain picture and the anchors) in ascending POC. The chain is
+ * the newest; a recovery frame codes from the anchor named by
+ * frame->recover_from instead, and keeps no anchor newer than that one: the
+ * decoder may never have had it, and an RPS entry used by no picture may be
+ * missing but a later recovery must not name it. At num_anchors held, a new
+ * anchor drops the oldest from the RPS (@evict). Returns NULL for an I frame,
+ * or when the recovery anchor is not held. */
+GstH265EncoderFrame *
+gst_h265_encoder_plan_anchor_refs (GstH265EncoderFrame ** refs,
+    guint num_refs, guint num_anchors, GstH265EncoderFrame * frame,
+    GstH265EncoderFrame ** evict)
+{
+  GstH265EncoderFrame *src = NULL, *oldest = NULL;
+  guint i, held = 0;
+
+  *evict = NULL;
+  frame->is_anchor = FALSE;
+  frame->num_rps_foll = 0;
+
+  if (frame->type.slice_type == GST_H265_I_SLICE || num_refs == 0)
+    return NULL;
+
+  if (GST_CLOCK_TIME_IS_VALID (frame->recover_from)) {
+    for (i = 0; i < num_refs; i++) {
+      if (refs[i]->is_anchor && refs[i]->pts == frame->recover_from)
+        src = refs[i];
+    }
+    if (!src)
+      return NULL;
+  } else {
+    src = refs[num_refs - 1];
+  }
+
+  for (i = 0; i < num_refs; i++) {
+    if (!refs[i]->is_anchor || refs[i]->poc > src->poc)
+      continue;
+    held++;
+    if (!oldest || refs[i]->poc < oldest->poc)
+      oldest = refs[i];
+  }
+
+  if (frame->want_anchor && num_anchors > 0) {
+    frame->is_anchor = TRUE;
+    if (held >= num_anchors)
+      *evict = oldest;
+  }
+
+  /* newest first: the RPS order after @src, which is always the closest */
+  for (i = num_refs; i-- > 0;) {
+    if (refs[i] == src || !refs[i]->is_anchor || refs[i]->poc > src->poc
+        || refs[i] == *evict)
+      continue;
+    frame->rps_foll[frame->num_rps_foll++] = refs[i];
+  }
+
+  return src;
+}
