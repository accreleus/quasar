+/* Reference recovery decisions of GstH265Encoder (num-anchors > 0), through
+ * the test seam in gsth265encoder.h. No Vulkan: like vkvideoencodeav1refs.c
+ * it includes the plugin-internal implementation file. */
+
+#ifdef HAVE_CONFIG_H
+#include "config.h"
+#endif
+
+#include <gst/check/gstcheck.h>
+
+#undef GST_CAT_DEFAULT
+
+#include "../../../ext/vulkan/base/gsth265encoder.c"
+
+static GPtrArray *frames;
+
+static void
+setup (void)
+{
+  (void) gst_h265_encoder_get_type ();
+  frames = g_ptr_array_new_with_free_func (gst_h265_encoder_frame_unref);
+}
+
+static void
+teardown (void)
+{
+  g_clear_pointer (&frames, g_ptr_array_unref);
+}
+
+static GstH265EncoderFrame *
+frame (GstH265SliceType type, gint poc, gboolean anchor)
+{
+  GstH265EncoderFrame *f = gst_h265_encoder_frame_new ();
+
+  f->type.slice_type = type;
+  f->type.is_ref = TRUE;
+  f->poc = poc;
+  f->pts = poc * GST_MSECOND;
+  f->is_anchor = anchor;
+  g_ptr_array_add (frames, f);
+
+  return f;
+}
+
+GST_START_TEST (test_h265_anchor_rps)
+{
+  GstH265EncoderFrame *refs[5], *evict, *src, *p;
+
+  refs[0] = frame (GST_H265_I_SLICE, 0, FALSE);
+  p = frame (GST_H265_P_SLICE, 2, FALSE);
+  p->want_anchor = TRUE;
+  src = gst_h265_encoder_plan_anchor_refs (refs, 1, 3, p, &evict);
+  fail_unless (src == refs[0]);
+  fail_unless (p->is_anchor);
+  assert_equals_int (p->num_rps_foll, 0);
+
+  /* the chain is the anchor: used, so not listed again */
+  refs[0] = p;
+  p = frame (GST_H265_P_SLICE, 4, FALSE);
+  src = gst_h265_encoder_plan_anchor_refs (refs, 1, 3, p, &evict);
+  fail_unless (src == refs[0]);
+  fail_if (p->is_anchor);
+  assert_equals_int (p->num_rps_foll, 0);
+
+  /* every held anchor stays in the RPS, newest first */
+  refs[0] = frame (GST_H265_P_SLICE, 2, TRUE);
+  refs[1] = frame (GST_H265_P_SLICE, 4, TRUE);
+  refs[2] = frame (GST_H265_P_SLICE, 6, TRUE);
+  refs[3] = frame (GST_H265_P_SLICE, 8, FALSE);
+  p = frame (GST_H265_P_SLICE, 10, FALSE);
+  src = gst_h265_encoder_plan_anchor_refs (refs, 4, 3, p, &evict);
+  fail_unless (src == refs[3]);
+  assert_equals_int (p->num_rps_foll, 3);
+  fail_unless (p->rps_foll[0] == refs[2]);
+  fail_unless (p->rps_foll[1] == refs[1]);
+  fail_unless (p->rps_foll[2] == refs[0]);
+}
+
+GST_END_TEST;
+
+GST_START_TEST (test_h265_anchor_evict)
+{
+  GstH265EncoderFrame *refs[3], *evict, *src, *p;
+
+  refs[0] = frame (GST_H265_P_SLICE, 4, TRUE);
+  refs[1] = frame (GST_H265_P_SLICE, 8, TRUE);
+  refs[2] = frame (GST_H265_P_SLICE, 9, FALSE);
+  p = frame (GST_H265_P_SLICE, 10, FALSE);
+  p->want_anchor = TRUE;
+  gst_h265_encoder_plan_anchor_refs (refs, 3, 2, p, &evict);
+  fail_unless (evict == refs[0]);
+  assert_equals_int (p->num_rps_foll, 1);
+  fail_unless (p->rps_foll[0] == refs[1]);
+
+  /* one anchor, held by the chain itself: used now, dropped after */
+  refs[0] = frame (GST_H265_P_SLICE, 12, TRUE);
+  p = frame (GST_H265_P_SLICE, 14, FALSE);
+  p->want_anchor = TRUE;
+  src = gst_h265_encoder_plan_anchor_refs (refs, 1, 1, p, &evict);
+  fail_unless (src == refs[0] && evict == refs[0]);
+  assert_equals_int (p->num_rps_foll, 0);
+}
+
+GST_END_TEST;
+
+GST_START_TEST (test_h265_anchor_recover)
+{
+  GstH265EncoderFrame *refs[4], *evict, *src, *p;
+
+  refs[0] = frame (GST_H265_P_SLICE, 5, TRUE);
+  refs[1] = frame (GST_H265_P_SLICE, 10, TRUE);
+  refs[2] = frame (GST_H265_P_SLICE, 20, TRUE);
+  refs[3] = frame (GST_H265_P_SLICE, 25, FALSE);
+
+  p = frame (GST_H265_P_SLICE, 26, FALSE);
+  p->recover_from = 10 * GST_MSECOND;
+  src = gst_h265_encoder_plan_anchor_refs (refs, 4, 3, p, &evict);
+  fail_unless (src == refs[1]);
+  /* the newer anchor and the chain may be missing: never listed again */
+  assert_equals_int (p->num_rps_foll, 1);
+  fail_unless (p->rps_foll[0] == refs[0]);
+
+  p->recover_from = 25 * GST_MSECOND;
+  fail_unless (gst_h265_encoder_plan_anchor_refs (refs, 4, 3, p, &evict)
+      == NULL);
+  p->recover_from = 99 * GST_MSECOND;
+  fail_unless (gst_h265_encoder_plan_anchor_refs (refs, 4, 3, p, &evict)
+      == NULL);
+}
+
+GST_END_TEST;
+
+static Suite *
+h265anchors_suite (void)
+{
+  Suite *s = suite_create ("h265anchors");
+  TCase *tc = tcase_create ("general");
+
+  suite_add_tcase (s, tc);
+  tcase_add_checked_fixture (tc, setup, teardown);
+  tcase_add_test (tc, test_h265_anchor_rps);
+  tcase_add_test (tc, test_h265_anchor_evict);
+  tcase_add_test (tc, test_h265_anchor_recover);
+
+  return s;
+}
+
+GST_CHECK_MAIN (h265anchors);
