   PROP_NUM_REF_FRAMES,
   PROP_B_PYRAMID,
   PROP_NUM_ANCHORS,
+  PROP_NON_REF_P,
   N_PROPERTIES
 };
 
@@ -166,6 +167,7 @@ struct _GstH264EncoderPrivate
     guint num_ref_frames;
     gboolean b_pyramid;
     guint num_anchors;
+    gboolean non_ref_p;
   } prop;
 
   struct
@@ -218,6 +220,8 @@ struct _GstH264EncoderPrivate
 
     /* reference recovery: fixed per sequence, 0 = off */
     guint num_anchors;
+    /* every second P is a non-reference picture */
+    gboolean non_ref_p;
   } gop;
 
   /* reference recovery requests from upstream events, under the object lock */
@@ -476,7 +480,10 @@ gst_h264_encoder_create_gop_frame_map (GstH264Encoder * self)
     }
 
     gop_frame->slice_type = GST_H264_P_SLICE;
-    gop_frame->is_ref = TRUE;
+    /* non-ref-p: every second P is not a reference (no B frames, so only
+     * the frame after a reference can be one) */
+    gop_frame->is_ref = !(priv->gop.non_ref_p && priv->gop.ip_period == 1
+        && i % 2 == 0);
   }
 
   /* Force the last one to be a P */
@@ -879,6 +886,7 @@ gst_h264_encoder_reset (GstH264Encoder * self)
   priv->gop.num_iframes = priv->prop.num_iframes;
   priv->gop.b_pyramid = priv->prop.b_pyramid;
   priv->gop.num_anchors = priv->prop.num_anchors;
+  priv->gop.non_ref_p = priv->prop.non_ref_p;
   priv->req = (GstRefRecoveryRequest) { FALSE, FALSE, GST_CLOCK_TIME_NONE };
   GST_OBJECT_UNLOCK (self);
 
@@ -1065,6 +1073,10 @@ gst_h264_encoder_reorder_lists_push (GstH264Encoder * self,
           priv->gop.cur_frame_index);
       h264_frame->poc =
           (priv->gop.cur_frame_index * 2) % priv->gop.max_pic_order_cnt;
+      /* an anchor or the frame a recovery resumes from is a reference */
+      if (h264_frame->want_anchor
+          || GST_CLOCK_TIME_IS_VALID (h264_frame->recover_from))
+        h264_frame->type.is_ref = TRUE;
 
       GST_LOG_OBJECT (self, "Push frame, system_frame_number: %d, poc %d, "
           "frame type %s", frame->system_frame_number, h264_frame->poc,
@@ -1829,7 +1841,8 @@ gst_h264_encoder_plan_anchor_refs (GstH264EncoderFrame ** refs,
   }
   src = chain;
 
-  if (!frame->want_anchor || num_anchors == 0 || chain->long_term_frame_idx >= 0)
+  if (!frame->want_anchor || !frame->type.is_ref || num_anchors == 0
+      || chain->long_term_frame_idx >= 0)
     return src;
 
   for (i = 0; i < num_refs; i++) {
@@ -3095,6 +3108,9 @@ gst_h264_encoder_get_property (GObject * object, guint property_id,
     case PROP_NUM_ANCHORS:
       g_value_set_uint (value, priv->prop.num_anchors);
       break;
+    case PROP_NON_REF_P:
+      g_value_set_boolean (value, priv->prop.non_ref_p);
+      break;
     default:
       G_OBJECT_WARN_INVALID_PROPERTY_ID (object, property_id, pspec);
       break;
@@ -3134,6 +3150,10 @@ gst_h264_encoder_set_property (GObject * object, guint property_id,
     case PROP_NUM_ANCHORS:
       priv->prop.num_anchors = g_value_get_uint (value);
       break;
+    case PROP_NON_REF_P:
+      priv->prop.non_ref_p = g_value_get_boolean (value);
+      g_atomic_int_set (&priv->need_configure, TRUE);
+      break;
     default:
       G_OBJECT_WARN_INVALID_PROPERTY_ID (object, property_id, pspec);
       break;
@@ -3253,6 +3273,19 @@ gst_h264_encoder_class_init (GstH264EncoderClass * klass)
       G_PARAM_READWRITE | G_PARAM_STATIC_STRINGS | G_PARAM_CONSTRUCT
       | GST_PARAM_MUTABLE_READY);
 
+  /**
+   * GstH264Encoder:non-ref-p:
+   *
+   * Every second P frame is a non-reference picture (nal_ref_idc 0): nothing
+   * later is coded from it, so a decoder that never gets it needs no key
+   * frame. Costs some compression (a P can be two frames from its
+   * reference). Only without B frames; with "num-anchors" a frame that
+   * carries an anchor or a recovery request stays a reference.
+   */
+  properties[PROP_NON_REF_P] = g_param_spec_boolean ("non-ref-p",
+      "Non-reference P", "Every second P frame is a non-reference picture",
+      FALSE, param_flags);
+
   g_object_class_install_properties (object_class, N_PROPERTIES, properties);
 
   gst_type_mark_as_plugin_api (GST_TYPE_H264_ENCODER, 0);
diff --git a/subprojects/gst-plugins-bad/tests/check/libs/vkvideoencodeh264anchors.c b/subprojects/gst-plugins-bad/tests/check/libs/vkvideoencodeh264anchors.c
index 97aee21..5303ad4 100644
--- a/subprojects/gst-plugins-bad/tests/check/libs/vkvideoencodeh264anchors.c
+++ b/subprojects/gst-plugins-bad/tests/check/libs/vkvideoencodeh264anchors.c
@@ -89,6 +89,23 @@ GST_START_TEST (test_h264_anchor_mark)
 
 GST_END_TEST;
 
+/* a non-reference P has no marking to carry an anchor: it never becomes one */
+GST_START_TEST (test_h264_anchor_non_ref)
+{
+  GstH264EncoderFrame *refs[1], *evict, *p;
+
+  refs[0] = frame (GST_H264_I_SLICE, 0, -1);
+  p = frame (GST_H264_P_SLICE, 1, -1);
+  p->type.is_ref = FALSE;
+  p->want_anchor = TRUE;
+  fail_unless (gst_h264_encoder_plan_anchor_refs (refs, 1, 3, p, &evict)
+      == refs[0]);
+  assert_equals_int (p->long_term_frame_idx, -1);
+  fail_unless (evict == NULL);
+}
+
+GST_END_TEST;
+
 GST_START_TEST (test_h264_anchor_evict)
 {
   GstH264EncoderFrame *refs[3], *evict, *p;
@@ -248,6 +265,7 @@ h264anchors_suite (void)
   suite_add_tcase (s, tc);
   tcase_add_checked_fixture (tc, setup, teardown);
   tcase_add_test (tc, test_h264_anchor_mark);
+  tcase_add_test (tc, test_h264_anchor_non_ref);
   tcase_add_test (tc, test_h264_anchor_evict);
   tcase_add_test (tc, test_h264_anchor_recover);
   tcase_add_test (tc, test_h264_anchor_syntax);
