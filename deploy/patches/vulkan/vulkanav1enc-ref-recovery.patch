diff --git a/subprojects/gst-plugins-bad/tests/check/libs/vkvideoencodeav1refs.c b/subprojects/gst-plugins-bad/tests/check/libs/vkvideoencodeav1refs.c
index 4813c37..b9442d0 100644
--- a/subprojects/gst-plugins-bad/tests/check/libs/vkvideoencodeav1refs.c
+++ b/subprojects/gst-plugins-bad/tests/check/libs/vkvideoencodeav1refs.c
@@ -1139,6 +1139,256 @@ GST_START_TEST (test_av1_refs_occupancy_cap)
 
 GST_END_TEST;
 
+/* ------------------------------------------------------------------ */
+/* reference recovery (num-anchors > 0)                                */
+/* ------------------------------------------------------------------ */
+
+/* The most distinct pictures held while a frame was coded (the held ones plus
+ * the one being coded), over every anchor_step() since it was last zeroed. */
+static guint coding_peak;
+
+/* One frame through the anchor model, as gst_av1_encoder_encode_frame() and
+ * update_ref_list() run it: decide, clear the forgotten anchors, then every
+ * refresh bit. The frame's PTS is its frame_num in ms. */
+static GstAV1EncoderFrame *
+anchor_step (GstAV1EncoderFrame ** refs, GstAV1EncoderAnchorState * st,
+    guint num_anchors, GstAV1FrameType type, guint32 frame_num,
+    gint recover_slot, gboolean want_anchor, guint8 * drop_out)
+{
+  GstAV1EncoderFrame *f = make_frame (type, frame_num, FALSE);
+  guint8 drop;
+  gint i;
+
+  f->pts = frame_num * GST_MSECOND;
+  if (type == GST_AV1_KEY_FRAME)
+    clear_refs (refs);
+
+  drop = gst_av1_encoder_assign_anchor_refs (refs, num_anchors, st,
+      recover_slot, want_anchor, f);
+  for (i = 0; i < GST_AV1_NUM_REF_FRAMES; i++) {
+    if (drop & (1 << i))
+      refs[i] = NULL;
+  }
+  coding_peak = MAX (coding_peak, distinct_refs_held (refs) + 1);
+  for (i = 0; i < GST_AV1_NUM_REF_FRAMES; i++) {
+    if (f->refresh_frame_flags & (1 << i))
+      refs[i] = f;
+  }
+  if (drop_out)
+    *drop_out = drop;
+
+  return f;
+}
+
+static void
+assert_all_names (GstAV1EncoderFrame * f, gint slot)
+{
+  gint i;
+
+  for (i = GST_AV1_REF_LAST_FRAME; i <= GST_AV1_REF_ALTREF_FRAME; i++)
+    assert_equals_int (f->ref_frame_idx[i], slot);
+}
+
+static gint
+slot_of (GstAV1EncoderFrame ** refs, GstAV1EncoderAnchorState * st,
+    GstAV1EncoderFrame * f)
+{
+  gint i;
+
+  for (i = 0; i < GST_AV1_NUM_REF_FRAMES; i++) {
+    if ((st->anchor_mask & (1 << i)) && refs[i] == f)
+      return i;
+  }
+  return -1;
+}
+
+GST_START_TEST (test_av1_anchor_chain_and_mark)
+{
+  GstAV1EncoderFrame *refs[GST_AV1_NUM_REF_FRAMES];
+  GstAV1EncoderAnchorState st = { -1, 0 };
+  GstAV1EncoderFrame *f;
+
+  clear_refs (refs);
+  f = anchor_step (refs, &st, 3, GST_AV1_KEY_FRAME, 0, -1, TRUE, NULL);
+  assert_equals_int (f->refresh_frame_flags, 0xff);
+  /* a key frame is never an anchor: the request waits for an inter frame */
+  fail_if (f->is_anchor);
+  assert_equals_int (st.chain_slot, 0);
+  assert_equals_int (st.anchor_mask, 0);
+
+  f = anchor_step (refs, &st, 3, GST_AV1_INTER_FRAME, 1, -1, TRUE, NULL);
+  fail_unless (f->is_anchor);
+  fail_if (f->error_resilient);
+  assert_all_names (f, 0);
+  /* the chain slot plus its own anchor slot */
+  assert_equals_int (f->refresh_frame_flags, 0x03);
+  assert_equals_int (st.anchor_mask, 0x02);
+
+  /* the next frame codes from the chain (which holds the anchor too), and
+   * leaves the anchor slot alone */
+  f = anchor_step (refs, &st, 3, GST_AV1_INTER_FRAME, 2, -1, FALSE, NULL);
+  fail_if (f->is_anchor);
+  assert_all_names (f, 0);
+  assert_equals_int (f->refresh_frame_flags, 0x01);
+  assert_equals_int (refs[1]->frame_num, 1);
+}
+
+GST_END_TEST;
+
+GST_START_TEST (test_av1_anchor_recover)
+{
+  GstAV1EncoderFrame *refs[GST_AV1_NUM_REF_FRAMES];
+  GstAV1EncoderAnchorState st = { -1, 0 };
+  GstAV1EncoderFrame *a1, *a3, *f;
+  guint8 drop;
+  gint s1, s3, i;
+
+  clear_refs (refs);
+  anchor_step (refs, &st, 3, GST_AV1_KEY_FRAME, 0, -1, FALSE, NULL);
+  a1 = anchor_step (refs, &st, 3, GST_AV1_INTER_FRAME, 1, -1, TRUE, NULL);
+  anchor_step (refs, &st, 3, GST_AV1_INTER_FRAME, 2, -1, FALSE, NULL);
+  a3 = anchor_step (refs, &st, 3, GST_AV1_INTER_FRAME, 3, -1, TRUE, NULL);
+  anchor_step (refs, &st, 3, GST_AV1_INTER_FRAME, 4, -1, FALSE, NULL);
+  s1 = slot_of (refs, &st, a1);
+  s3 = slot_of (refs, &st, a3);
+  fail_unless (s1 > 0 && s3 > 0 && s1 != s3);
+
+  assert_equals_int (gst_av1_encoder_find_anchor (refs, &st, 1 * GST_MSECOND,
+          5), s1);
+  /* a chain picture is no anchor */
+  assert_equals_int (gst_av1_encoder_find_anchor (refs, &st, 4 * GST_MSECOND,
+          5), -1);
+
+  /* frames 2..4 lost: frame 5 codes from anchor 1 only */
+  f = anchor_step (refs, &st, 3, GST_AV1_INTER_FRAME, 5, s1, FALSE, &drop);
+  fail_unless (f->error_resilient);
+  assert_all_names (f, s1);
+  /* the newer anchor may be missing in the decoder: forgotten */
+  assert_equals_int (drop, 1 << s3);
+  assert_equals_int (st.anchor_mask, 1 << s1);
+  fail_unless (refs[s3] == NULL);
+  /* it overwrites the chain slot, the one the decoder may hold stale */
+  assert_equals_int (f->refresh_frame_flags, 1 << st.chain_slot);
+  fail_unless (refs[s1] == a1);
+
+  /* no later frame names anything but the chain */
+  f = anchor_step (refs, &st, 3, GST_AV1_INTER_FRAME, 6, -1, FALSE, NULL);
+  fail_if (f->error_resilient);
+  assert_all_names (f, st.chain_slot);
+  for (i = 0; i < GST_AV1_NUM_REF_FRAMES; i++)
+    fail_if (i != st.chain_slot && i != s1 && refs[i] && refs[i]->frame_num > 0,
+        "slot %d holds frame %u", i, refs[i]->frame_num);
+
+  /* the recovery frame was lost too: the anchor is still there */
+  f = anchor_step (refs, &st, 3, GST_AV1_INTER_FRAME, 7, s1, FALSE, &drop);
+  assert_all_names (f, s1);
+  assert_equals_int (drop, 0);
+}
+
+GST_END_TEST;
+
+GST_START_TEST (test_av1_anchor_eviction)
+{
+  GstAV1EncoderFrame *refs[GST_AV1_NUM_REF_FRAMES];
+  GstAV1EncoderAnchorState st = { -1, 0 };
+  GstAV1EncoderFrame *a[4];
+  gint i, s0;
+
+  clear_refs (refs);
+  anchor_step (refs, &st, 2, GST_AV1_KEY_FRAME, 0, -1, FALSE, NULL);
+  for (i = 0; i < 2; i++)
+    a[i] = anchor_step (refs, &st, 2, GST_AV1_INTER_FRAME, i + 1, -1, TRUE,
+        NULL);
+  s0 = slot_of (refs, &st, a[0]);
+
+  /* the third anchor takes the oldest one's slot */
+  a[2] = anchor_step (refs, &st, 2, GST_AV1_INTER_FRAME, 3, -1, TRUE, NULL);
+  assert_equals_int (slot_of (refs, &st, a[2]), s0);
+  assert_equals_int (gst_av1_encoder_find_anchor (refs, &st, 1 * GST_MSECOND,
+          4), -1);
+  fail_unless (slot_of (refs, &st, a[1]) > 0);
+  assert_equals_int (__builtin_popcount (st.anchor_mask), 2);
+
+  /* seven anchors fill the VBI around the chain slot */
+  clear_refs (refs);
+  st = (GstAV1EncoderAnchorState) { -1, 0 };
+  anchor_step (refs, &st, 7, GST_AV1_KEY_FRAME, 0, -1, FALSE, NULL);
+  for (i = 1; i <= 9; i++)
+    anchor_step (refs, &st, 7, GST_AV1_INTER_FRAME, i, -1, TRUE, NULL);
+  assert_equals_int (st.anchor_mask | (1 << st.chain_slot), 0xff);
+  /* the chain slot holds the newest anchor as well */
+  assert_equals_int (distinct_refs_held (refs), 7);
+}
+
+GST_END_TEST;
+
+GST_START_TEST (test_av1_anchor_too_old)
+{
+  GstAV1EncoderFrame *refs[GST_AV1_NUM_REF_FRAMES];
+  GstAV1EncoderAnchorState st = { -1, 0 };
+
+  clear_refs (refs);
+  anchor_step (refs, &st, 1, GST_AV1_KEY_FRAME, 0, -1, FALSE, NULL);
+  anchor_step (refs, &st, 1, GST_AV1_INTER_FRAME, 1, -1, TRUE, NULL);
+
+  /* order-hint distance must stay below 128 */
+  fail_unless (gst_av1_encoder_find_anchor (refs, &st, GST_MSECOND, 128) > 0);
+  assert_equals_int (gst_av1_encoder_find_anchor (refs, &st, GST_MSECOND, 129),
+      -1);
+  assert_equals_int (gst_av1_encoder_find_anchor (refs, &st,
+          GST_CLOCK_TIME_NONE, 2), -1);
+
+  /* a key frame forgets every anchor */
+  anchor_step (refs, &st, 1, GST_AV1_KEY_FRAME, 0, -1, FALSE, NULL);
+  assert_equals_int (gst_av1_encoder_find_anchor (refs, &st, GST_MSECOND, 1),
+      -1);
+}
+
+GST_END_TEST;
+
+/* num-anchors is clamped so the DPB never needs more pictures than the
+ * accelerator has: the key frame stays held until anchors overwrite all of
+ * its slots, so K anchors need K + 3 pictures until K reaches 7. */
+GST_START_TEST (test_av1_anchor_dpb_fits)
+{
+  guint dpb;
+
+  for (dpb = 0; dpb <= 17; dpb++) {
+    GstAV1EncoderFrame *refs[GST_AV1_NUM_REF_FRAMES];
+    GstAV1EncoderAnchorState st = { -1, 0 };
+    guint k = gst_av1_encoder_max_anchors_for_dpb (dpb);
+    guint32 n;
+
+    if (k == 0)
+      continue;
+    clear_refs (refs);
+    coding_peak = 0;
+    anchor_step (refs, &st, k, GST_AV1_KEY_FRAME, 0, -1, FALSE, NULL);
+    for (n = 1; n < 60; n++) {
+      gint recover = -1, i;
+
+      /* every 9th frame recovers from the oldest anchor held */
+      if (n % 9 == 0) {
+        for (i = 0; i < GST_AV1_NUM_REF_FRAMES; i++) {
+          if ((st.anchor_mask & (1 << i)) && (recover < 0
+                  || refs[i]->frame_num < refs[recover]->frame_num))
+            recover = i;
+        }
+      }
+      anchor_step (refs, &st, k, GST_AV1_INTER_FRAME, n, recover, n % 2,
+          NULL);
+    }
+    fail_unless (coding_peak <= dpb, "dpb %u, %u anchors: %u pictures", dpb,
+        k, coding_peak);
+  }
+  /* 7 anchors from 9 slots up, and the key frame's last copy is overwritten */
+  assert_equals_int (gst_av1_encoder_max_anchors_for_dpb (9), 7);
+  assert_equals_int (gst_av1_encoder_max_anchors_for_dpb (8), 5);
+  assert_equals_int (gst_av1_encoder_max_anchors_for_dpb (3), 0);
+}
+
+GST_END_TEST;
+
 static Suite *
 av1refs_suite (void)
 {
@@ -1162,6 +1412,11 @@ av1refs_suite (void)
   tcase_add_test (tc_basic, test_av1_refs_recency_survives_wraparound);
   tcase_add_test (tc_basic, test_av1_refs_gop_walk);
   tcase_add_test (tc_basic, test_av1_refs_occupancy_cap);
+  tcase_add_test (tc_basic, test_av1_anchor_chain_and_mark);
+  tcase_add_test (tc_basic, test_av1_anchor_recover);
+  tcase_add_test (tc_basic, test_av1_anchor_eviction);
+  tcase_add_test (tc_basic, test_av1_anchor_too_old);
+  tcase_add_test (tc_basic, test_av1_anchor_dpb_fits);
 
   return s;
 }
