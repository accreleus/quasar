+/* Reference recovery: the slot of the live anchor whose PTS is @pts, or -1
+ * when none is held or it is too old to name. Relative order-hint distances
+ * are only defined below 1 << (OrderHintBits - 1) frames, so an older anchor
+ * counts as gone. @frame_num is the frame about to be coded. */
+gint
+gst_av1_encoder_find_anchor (GstAV1EncoderFrame ** ref_frames,
+    const GstAV1EncoderAnchorState * state, GstClockTime pts,
+    guint32 frame_num)
+{
+  gint i;
+
+  if (!GST_CLOCK_TIME_IS_VALID (pts))
+    return -1;
+
+  for (i = 0; i < GST_AV1_NUM_REF_FRAMES; i++) {
+    if (!(state->anchor_mask & (1 << i)) || !ref_frames[i])
+      continue;
+    if (ref_frames[i]->pts != pts)
+      continue;
+    if (frame_num - ref_frames[i]->frame_num >=
+        (1 << (AV1ENC_ORDER_HINT_BITS - 1)))
+      return -1;
+    return i;
+  }
+
+  return -1;
+}
