       .use_superres = 0,
       .render_and_frame_size_different =
@@ -1459,7 +1465,8 @@ gst_vulkan_av1_encoder_encode_frame (GstAV1Encoder * base,
     /* quality: inherit the CDF/context state from LAST rather than
