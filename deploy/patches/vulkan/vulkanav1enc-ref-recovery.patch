+G_GNUC_INTERNAL
+gint                 gst_av1_encoder_find_anchor             (GstAV1EncoderFrame ** ref_frames,
+                                                              const GstAV1EncoderAnchorState * state,
+                                                              GstClockTime pts,
+                                                              guint32 frame_num);
+G_GNUC_INTERNAL
+guint8               gst_av1_encoder_assign_anchor_refs      (GstAV1EncoderFrame ** ref_frames,
+                                                              guint num_anchors,
+                                                              GstAV1EncoderAnchorState * state,
+                                                              gint recover_slot,
+                                                              gboolean want_anchor,
+                                                              GstAV1EncoderFrame * av1_frame);
+
+G_GNUC_INTERNAL
+guint                gst_av1_encoder_max_anchors_for_dpb     (guint dpb_slots);
+
 G_GNUC_INTERNAL
 guint32              gst_av1_encoder_order_hint              (guint32 frame_num);
 
diff --git a/subprojects/gst-plugins-bad/ext/vulkan/base/gstrefrecovery.h b/subprojects/gst-plugins-bad/ext/vulkan/base/gstrefrecovery.h
new file mode 100644
index 0000000..c848d88
--- /dev/null
+++ b/subprojects/gst-plugins-bad/ext/vulkan/base/gstrefrecovery.h
@@ -0,0 +1,96 @@
+/* GStreamer
+ * Copyright (C) 2026 Quasar contributors
+ *
+ * This library is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Library General Public
+ * License as published by the Free Software Foundation; either
+ * version 2 of the License, or (at your option) any later version.
+ */
+
+/* Reference recovery control (Quasar), shared by the Vulkan encoders.
+ *
+ * Upstream, sent to the encoder's src pad:
+ *   "quasar-ref-anchor"                keep the next inter frame as an anchor
+ *   "quasar-ref-recover", pts=guint64  code the next frame from the anchor with
+ *                                      that PTS only, and forget every anchor
+ *                                      newer than it; a key frame when no held
+ *                                      anchor has that PTS (on AV1 also when
+ *                                      the anchor is 128 or more frames old:
+ *                                      order hints cannot name it)
+ * A second request of a kind before a frame takes it is the same request; an
+ * anchor request a frame cannot take (a key frame, and on H.264 a recovery
+ * frame or the frame after an anchor) waits for the next frame.
+ * Downstream, serialized before the frame's buffer:
+ *   "quasar-ref-frame", pts=guint64, anchor=boolean[, recover-from=guint64]
+ *   for every anchor and every recovery frame. Match a report to its buffer by
+ *   pts, not by arrival order.
+ * Every pts here is the frame's pts as the encoder holds it, the one on its
+ * output buffer: GstVideoEncoder offsets input pts below its min-pts (the H.264
+ * and HEVC encoders set 1000 hours), so name an anchor by the pts its report
+ * carries, never by the input buffer's.
+ * The other half is node-agent/src/session/pipeline/ref_recovery.rs. */
+
+#pragma once
+
+#include <gst/video/gstvideoencoder.h>
+
+G_BEGIN_DECLS
+
+#define GST_REF_RECOVERY_ANCHOR  "quasar-ref-anchor"
+#define GST_REF_RECOVERY_RECOVER "quasar-ref-recover"
+#define GST_REF_RECOVERY_FRAME   "quasar-ref-frame"
+
+typedef struct
+{
+  gboolean anchor;
+  gboolean recover;
+  GstClockTime recover_pts;
+} GstRefRecoveryRequest;
+
+/* TRUE when @event is ours (the caller then owns and drops it). Merges it into
+ * @req; call with the object lock held. A later recover replaces an earlier one. */
+static inline gboolean
+gst_ref_recovery_take_event (GstEvent * event, GstRefRecoveryRequest * req)
+{
+  const GstStructure *s;
+  guint64 pts;
+
+  if (GST_EVENT_TYPE (event) != GST_EVENT_CUSTOM_UPSTREAM)
+    return FALSE;
+
+  s = gst_event_get_structure (event);
+  if (gst_structure_has_name (s, GST_REF_RECOVERY_ANCHOR)) {
+    req->anchor = TRUE;
+    return TRUE;
+  }
+  if (gst_structure_has_name (s, GST_REF_RECOVERY_RECOVER)) {
+    if (gst_structure_get_uint64 (s, "pts", &pts)) {
+      req->recover = TRUE;
+      req->recover_pts = pts;
+    } else {
+      GST_WARNING ("%s without a guint64 pts, ignored", GST_REF_RECOVERY_RECOVER);
+    }
+    return TRUE;
+  }
+  return FALSE;
+}
+
+/* Queue the downstream report on @frame; GstVideoEncoder pushes frame->events
+ * (newest first) right before the frame's buffer. */
+static inline void
+gst_ref_recovery_report (GstVideoCodecFrame * frame, gboolean anchor,
+    GstClockTime recover_from)
+{
+  GstStructure *s = gst_structure_new (GST_REF_RECOVERY_FRAME,
+      "pts", G_TYPE_UINT64, (guint64) frame->pts,
+      "anchor", G_TYPE_BOOLEAN, anchor, NULL);
+
+  if (GST_CLOCK_TIME_IS_VALID (recover_from))
+    gst_structure_set (s, "recover-from", G_TYPE_UINT64,
+        (guint64) recover_from, NULL);
+
+  frame->events = g_list_prepend (frame->events,
+      gst_event_new_custom (GST_EVENT_CUSTOM_DOWNSTREAM, s));
+}
+
+G_END_DECLS
